+    /** The keyboard comes up only when a finger lifts off the field, never on focus alone. */
+    static void tapKeyboard(final android.widget.EditText e) {
+        e.setShowSoftInputOnFocus(false);
+        e.setOnTouchListener(new View.OnTouchListener() {
+            public boolean onTouch(View v, android.view.MotionEvent ev) {
+                if (ev.getAction() == android.view.MotionEvent.ACTION_UP) {
+                    v.requestFocus();
+                    android.view.inputmethod.InputMethodManager imm = (android.view.inputmethod.InputMethodManager)
+                            v.getContext().getSystemService(Context.INPUT_METHOD_SERVICE);
+                    if (imm != null) imm.showSoftInput(v, 0);
+                }
+                return false;
+            }
+        });
+    }
+
+    /** Shows a dialog that holds a text field without raising the keyboard by itself. */
+    static android.app.AlertDialog show(android.app.AlertDialog.Builder b) {
+        android.app.AlertDialog d = b.create();
+        if (d.getWindow() != null) {
+            d.getWindow().setSoftInputMode(android.view.WindowManager.LayoutParams.SOFT_INPUT_STATE_ALWAYS_HIDDEN
+                    | android.view.WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE);
+        }
+        d.show();
+        return d;
+    }
