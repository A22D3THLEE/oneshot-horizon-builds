+/// A press landed on a text field since the last `take_field_tap`: on a touch
+/// screen only that brings the soft keyboard up, never a field focused by itself.
+static FIELD_TAP: AtomicBool = AtomicBool::new(false);
+/// A press put the cursor in a text field.
+pub fn mark_field_tap() {
+    FIELD_TAP.store(true, Ordering::Relaxed);
+}
+/// Whether a text field was pressed since the last call.
+pub fn take_field_tap() -> bool {
+    FIELD_TAP.swap(false, Ordering::Relaxed)
+}
