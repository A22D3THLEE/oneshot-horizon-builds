diff --git a/packaging/android/java/dev/horizonlab/horizon/NativeBuild.java b/packaging/android/java/dev/horizonlab/horizon/NativeBuild.java
new file mode 100644
index 0000000..d596a00
--- /dev/null
+++ b/packaging/android/java/dev/horizonlab/horizon/NativeBuild.java
@@ -0,0 +1,190 @@
+package dev.horizonlab.horizon;
+
+import android.content.Context;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.TreeSet;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * OneShot's builds with native mods. A native mod's code goes into the game's own functions, which a phone can't
+ * build: the player picks mods in the catalog ("В мою сборку", kept in native-build.txt beside the game), the app
+ * asks the relay for that set ("build"), the builds workflow (mods-builds.yml) builds the game with them in the
+ * cloud and publishes the release android-mods-&lt;key&gt; (key: SHA-256 of the ids, sorted and comma-joined, first 12
+ * hex). Its build.txt says what is in it; its APK installs over this app like an update, and the mods' content
+ * (items, models, sounds) goes to horizon-mods/ as content mods, turned on.
+ */
+final class NativeBuild {
+    private static final String FILE = "native-build.txt";
+    private static final int MAX = 16, TIMEOUT_MS = 8000;
+
+    private NativeBuild() {}
+
+    /** One published build of a set. */
+    static final class Build {
+        long code;
+        String name = "", sha = "", asked = "", mods = "", left = "";
+        final List<String> content = new ArrayList<String>();
+        String base;
+    }
+
+    /** The native mods the player picked, sorted. */
+    static List<String> set(Context c) {
+        TreeSet<String> ids = new TreeSet<String>();
+        try {
+            File f = new File(SetupActivity.home(c), FILE);
+            if (f.isFile()) {
+                for (String line : new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8).split("\n")) {
+                    String id = line.trim();
+                    if (id.matches("[a-z0-9_]{1,48}")) ids.add(id);
+                }
+            }
+        } catch (Exception ignored) {
+        }
+        return new ArrayList<String>(ids);
+    }
+
+    /** Puts `id` in the set or takes it out; true when it is in now. */
+    static boolean toggle(Context c, String id) throws Exception {
+        List<String> ids = set(c);
+        boolean in;
+        if (ids.contains(id)) {
+            ids.remove(id);
+            in = false;
+        } else {
+            if (ids.size() >= MAX) throw new Exception(Ui.t("в сборке не больше 16 модов", "a build holds at most 16 mods"));
+            ids.add(id);
+            in = true;
+        }
+        Collections.sort(ids);
+        StringBuilder text = new StringBuilder();
+        for (String m : ids) text.append(m).append('\n');
+        Files.write(new File(SetupActivity.home(c), FILE).toPath(), text.toString().getBytes(StandardCharsets.UTF_8));
+        return in;
+    }
+
+    static String key(List<String> ids) throws Exception {
+        List<String> sorted = new ArrayList<String>(ids);
+        Collections.sort(sorted);
+        StringBuilder joined = new StringBuilder();
+        for (String m : sorted) joined.append(joined.length() == 0 ? "" : ",").append(m);
+        byte[] d = MessageDigest.getInstance("SHA-256").digest(joined.toString().getBytes(StandardCharsets.UTF_8));
+        StringBuilder hex = new StringBuilder();
+        for (int i = 0; i < 6; i++) hex.append(String.format(Locale.ROOT, "%02x", d[i]));
+        return hex.toString();
+    }
+
+    private static String base(List<String> ids) throws Exception {
+        return "https://github.com/" + Net.REPO + "/releases/download/android-mods-" + key(ids) + "/";
+    }
+
+    /** Asks the relay for a build of this set; throws with the relay's word when it refuses. */
+    static void request(android.app.Activity a, List<String> ids) throws Exception {
+        String relay = Net.relay(a);
+        if (relay.isEmpty()) relay = Net.DEFAULT_RELAY;
+        int colon = relay.lastIndexOf(':');
+        if (colon <= 0) throw new java.io.IOException("no relay port");
+        String host = relay.substring(0, colon);
+        if (host.startsWith("[") && host.endsWith("]")) host = host.substring(1, host.length() - 1);
+        int port = Integer.parseInt(relay.substring(colon + 1).trim());
+        try (Socket s = new Socket()) {
+            s.connect(new InetSocketAddress(host, port), TIMEOUT_MS);
+            s.setSoTimeout(TIMEOUT_MS);
+            JSONObject ask = new JSONObject();
+            ask.put("op", "build");
+            ask.put("v", 1);
+            ask.put("mods", new JSONArray(ids));
+            OutputStream out = s.getOutputStream();
+            out.write((ask.toString() + "\n").getBytes(StandardCharsets.UTF_8));
+            out.flush();
+            InputStream in = s.getInputStream();
+            ByteArrayOutputStream line = new ByteArrayOutputStream();
+            int ch;
+            while ((ch = in.read()) >= 0 && ch != '\n') {
+                line.write(ch);
+                if (line.size() > 8192) throw new java.io.IOException("answer too long");
+            }
+            JSONObject reply = new JSONObject(new String(line.toByteArray(), StandardCharsets.UTF_8));
+            if (!"queued".equals(reply.optString("op"))) {
+                String code = reply.optString("code", reply.optString("op"));
+                throw new java.io.IOException("bad_request".equals(code)
+                        ? Ui.t("сервер OneShot ещё не принимает заявки на сборку", "the OneShot server does not take build requests yet")
+                        : "rate_limited".equals(code) ? Ui.t("слишком часто, попробуйте через минуту", "too often, try in a minute")
+                        : Ui.t("сервер ответил ", "the server answered ") + code);
+            }
+        }
+    }
+
+    /** The published build of this set, or null when there is none (yet). */
+    static Build published(List<String> ids) throws Exception {
+        String text;
+        try {
+            text = UpdateActivity.get(base(ids) + "build.txt");
+        } catch (java.io.IOException e) {
+            if (String.valueOf(e.getMessage()).contains("HTTP 404")) return null;
+            throw e;
+        }
+        Build b = new Build();
+        b.base = base(ids);
+        for (String line : text.split("\n")) {
+            int eq = line.indexOf('=');
+            if (eq < 0) continue;
+            String k = line.substring(0, eq).trim(), v = line.substring(eq + 1).trim();
+            if (k.equals("versionCode")) b.code = Long.parseLong(v);
+            else if (k.equals("versionName")) b.name = v;
+            else if (k.equals("sha256")) b.sha = v.toLowerCase(Locale.ROOT);
+            else if (k.equals("asked")) b.asked = v;
+            else if (k.equals("mods")) b.mods = v;
+            else if (k.equals("left")) b.left = v;
+            else if (k.equals("content")) {
+                for (String f : v.split(",")) if (f.trim().matches("[a-z0-9_]{1,48}\\.hmod")) b.content.add(f.trim());
+            }
+        }
+        return b.code > 0 && b.sha.matches("[0-9a-f]{64}") ? b : null;
+    }
+
+    /** The build's APK as an update the update screen installs. */
+    static UpdateActivity.Release release(Build b) {
+        UpdateActivity.Release r = new UpdateActivity.Release();
+        r.code = b.code;
+        r.name = b.name;
+        r.apk = b.base + "horizon.apk";
+        r.sha = b.sha;
+        return r;
+    }
+
+    /** The mods' content into horizon-mods/, each turned on (the code is in the APK). */
+    static void installContent(Context c, Build b) throws Exception {
+        File dir = new File(SetupActivity.home(c), "horizon-mods");
+        dir.mkdirs();
+        for (String f : b.content) {
+            HttpURLConnection conn = UpdateActivity.open(b.base + f);
+            File part = new File(dir, f + ".part");
+            try (InputStream in = conn.getInputStream(); OutputStream out = new FileOutputStream(part)) {
+                byte[] buf = new byte[1 << 16];
+                int n;
+                while ((n = in.read(buf)) != -1) out.write(buf, 0, n);
+            } finally {
+                conn.disconnect();
+            }
+            File to = new File(dir, f);
+            if (to.exists() && !to.delete()) throw new java.io.IOException("cannot replace " + f);
+            if (!part.renameTo(to)) throw new java.io.IOException("cannot write " + f);
+            CatalogActivity.turnOn(new File(SetupActivity.home(c)), f.substring(0, f.length() - 5));
+        }
+    }
+}
