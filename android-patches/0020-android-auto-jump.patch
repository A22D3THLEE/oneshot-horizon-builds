+    /// Touch controls jump on their own, as Bedrock's do: auto-jump is turned on once per
+    /// player folder, new or already played, and the player's choice in Controls stays
+    /// after that. The mark is written only once options.txt holds the change.
+    #[cfg(target_os = "android")]
+    fn auto_jump_once(mut self, path: &Path) -> Self {
+        let Some(dir) = path.parent() else {
+            return self;
+        };
+        let mark = dir.join("horizon-autojump.txt");
+        if mark.exists() {
+            return self;
+        }
+        if !self.auto_jump {
+            self.auto_jump = true;
+            if let Err(e) = fs::write(path, self.serialize()) {
+                log::warn!("Horizon: options.txt is not saved: {e}");
+                return self;
+            }
+            log::info!("Horizon: auto-jump on for touch controls");
+        }
+        if let Err(e) = fs::write(&mark, "auto-jump turned on once; Controls > Auto-Jump changes it\n") {
+            log::warn!("Horizon: {}: {e}", mark.display());
+        }
+        self
+    }
