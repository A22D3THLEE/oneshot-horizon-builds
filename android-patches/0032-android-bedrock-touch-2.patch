+            return;
+        };
+        // The saved hotbars' placeholder (CustomCreativeSlot.mayPickup) can't be taken.
+        if horizon_client::creative::slot_locked(&stack) {
+            return;
+        }
+        let max = world_items!(self).get(&stack.item).map_or(64, |i| i.max_stack).max(1);
