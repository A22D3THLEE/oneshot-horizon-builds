+    /** The HD tab: on its first page the team's own HD skins, then HD Skins'. */
+    private String hd(String q, String after, List<Item> out) throws Exception {
+        if (after == null) {
+            try {
+                hdSkins(q, out);
+            } catch (Exception ignored) {
+                // the team's list is optional; HD Skins' still shows
+            }
+        }
+        try {
+            return hdSkinsSite(q, after, out);
+        } catch (Exception e) {
+            if (out.isEmpty()) throw e;
+            return null;
+        }
+    }
+
+    /** One request to HD Skins, at most once a second. */
+    private static byte[] hdGet(String url, int limit) throws Exception {
+        synchronized (hdGate) {
+            long wait = hdLast + 1000 - System.currentTimeMillis();
+            if (wait > 0) Thread.sleep(wait);
+            try {
+                return getBytes(url, limit);
+            } finally {
+                hdLast = System.currentTimeMillis();
+            }
+        }
+    }
+
+    private static Item hdSkinsItem(String texture, boolean slim, String title) {
+        Item it = new Item();
+        it.hd = true;
+        it.hdSkins = true;
+        it.id = texture;
+        it.title = title;
+        it.picture = HD_API + "textures/" + texture;
+        it.hasSlim = true;
+        it.slim = slim;
+        return it;
+    }
+
+    /** HD Skins: a player's current skin by name, or the most worn ones, 15 at a time. */
+    private String hdSkinsSite(String q, String after, List<Item> out) throws Exception {
+        if (!q.isEmpty()) {
+            if (after != null || !q.matches("[A-Za-z0-9_]{3,16}")) return null;
+            String body = new String(hdGet(HD_API + "users/" + enc(q), 1 << 20), StandardCharsets.UTF_8).trim();
+            if (body.isEmpty()) return null;
+            JSONObject root = new JSONObject(body);
+            JSONObject tex = root.optJSONObject("textures");
+            if (tex == null || tex.optBoolean("private")) return null;
+            JSONObject skin = tex.optJSONObject("SKIN");
+            JSONObject cur = skin == null ? null : skin.optJSONObject("current");
+            String texture = str(cur, "checksum").toLowerCase(Locale.ROOT);
+            if (!texture.matches("[0-9a-f]{64}")) return null;
+            JSONObject meta = cur.optJSONObject("textureMeta");
+            JSONObject user = root.optJSONObject("user");
+            out.add(hdSkinsItem(texture, meta != null && meta.optBoolean("slim"), str(user, "name", q)));
+            return null;
+        }
+        int offset = 0;
+        if (after != null && after.startsWith("hd:")) {
+            try {
+                offset = Integer.parseInt(after.substring(3));
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        JSONArray arr = new JSONArray(new String(hdGet(HD_API + "skins/users?limit=" + HD_PAGE + "&offset=" + offset, 1 << 20),
+                StandardCharsets.UTF_8));
+        for (int i = 0; i < arr.length(); i++) {
+            JSONObject s = arr.optJSONObject(i);
+            String texture = str(s, "texture").toLowerCase(Locale.ROOT);
+            if (!texture.matches("[0-9a-f]{64}")) continue;
+            Item it = hdSkinsItem(texture, s.optBoolean("slim"), "#" + s.optLong("textureId"));
+            it.sub = Ui.t("носят ", "worn by ") + s.optLong("users");
+            out.add(it);
+        }
+        return arr.length() == HD_PAGE ? "hd:" + (offset + HD_PAGE) : null;
+    }
+
+    /**
+     * A skin from HD Skins as a tile: decoded at a reduced size (an HD texture is up to 2048x2048)
+     * and brought pixel for pixel to 128x128, or to 64x32 for an old 2:1 HD skin, as it is worn.
+     */
+    private static byte[] hdTile(byte[] raw) throws Exception {
+        BitmapFactory.Options o = new BitmapFactory.Options();
+        o.inJustDecodeBounds = true;
+        BitmapFactory.decodeByteArray(raw, 0, raw.length, o);
+        int w = o.outWidth, h = o.outHeight;
+        if (w <= 0 || h <= 0) return raw;
+        int tw = w == h ? 128 : w == h * 2 ? 64 : w;
+        if (w <= tw) return raw;
+        int sample = 1;
+        while (w / (sample * 2) >= tw && w % (sample * 2) == 0) sample *= 2;
+        BitmapFactory.Options d = new BitmapFactory.Options();
+        d.inScaled = false;
+        d.inSampleSize = sample;
+        d.inPreferredConfig = Bitmap.Config.ARGB_8888;
+        Bitmap b = BitmapFactory.decodeByteArray(raw, 0, raw.length, d);
+        if (b == null) return raw;
+        Bitmap small = b.getWidth() == tw ? b : Bitmap.createScaledBitmap(b, tw, tw * h / w, false);
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        small.compress(Bitmap.CompressFormat.PNG, 100, out);
+        return out.toByteArray();
+    }
