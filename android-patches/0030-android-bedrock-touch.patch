+/// How long a finger stays on a hotbar slot to drop its stack.
+const DROP_MS: u128 = 500;
+
+/// The entities the interact button is shown for: those a use rides, trades
+/// with or opens, by their id's path.
+fn interactive(path: &str) -> bool {
+    matches!(
+        path,
+        "villager" | "wandering_trader" | "horse" | "donkey" | "mule" | "skeleton_horse"
+            | "zombie_horse" | "camel" | "camel_husk" | "llama" | "trader_llama" | "pig"
+            | "strider" | "happy_ghast" | "nautilus" | "zombie_nautilus" | "minecart"
+    ) || path.ends_with("_boat")
+        || path.ends_with("_raft")
+        || path.ends_with("_minecart")
+}
+
+/// A ring of dots filling clockwise from the top: `frac` of it bright, the rest dim.
+fn progress(batch: &mut HudBatch, atlas: &HudAtlas, c: [f32; 2], r: f32, frac: f32, a: f32) {
+    const N: usize = 24;
+    for k in 0..N {
+        let at = (k as f32 + 0.5) / N as f32;
+        let angle = at * std::f32::consts::TAU;
+        let (x, y) = (c[0] + r * angle.sin(), c[1] - r * angle.cos());
+        let color = if at <= frac { fade(0xFFFF_FFFF, a) } else { fade(0x70_00_00_00, a) };
+        batch.fill(atlas, (x - 1.0).round(), (y - 1.0).round(), 2.0, 2.0, color);
+    }
+}
