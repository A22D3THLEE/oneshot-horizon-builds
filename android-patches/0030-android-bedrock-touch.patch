+    /// Whether a finger held still now uses (Bedrock) rather than breaks: the main
+    /// hand's item is used by holding, or the main hand is empty and the offhand's is.
+    fn touch_hold_uses(&mut self) -> bool {
+        if self.screen != super::Screen::Playing || self.spectator() {
+            return false;
+        }
+        match self.inventory[self.selected].clone() {
+            Some(main) => self.touch_hold_usable(&main),
+            None => self.offhand.clone().is_some_and(|off| self.touch_hold_usable(&off)),
+        }
+    }
+
+    /// `stack` is used by holding and can be now: food when the player can eat it, a
+    /// bow with something to shoot, an unloaded crossbow with something to load, and
+    /// whatever else has a use time (potions, shields, spyglasses, tridents, horns).
+    fn touch_hold_usable(&mut self, stack: &horizon_client::items::ItemStack) -> bool {
+        let food = self.items().get(&stack.item).and_then(|i| i.food.is_some().then_some(i.can_always_eat));
+        if let Some(always) = food
+            && !self.can_eat(stack, always)
+        {
+            return false;
+        }
+        match &*stack.item {
+            "minecraft:bow" => return self.get_projectile(stack).is_some(),
+            "minecraft:crossbow" => {
+                let loaded = stack.data().is_some_and(|d| !d.charged.is_empty());
+                return !loaded && self.get_projectile(stack).is_some();
+            }
+            _ => {}
+        }
+        self.use_duration(stack) > 0
+    }
+
+    /// The name of the entity under the crosshair that a use rides, trades with or
+    /// opens, for the interact button; none while riding, in menus or in the editor.
+    fn touch_interact_target(&self) -> Option<String> {
+        if !self.touch_controls_shown()
+            || self.touch.editing
+            || self.screen != super::Screen::Playing
+            || self.spectator()
+            || self.riding.is_some()
+        {
+            return None;
+        }
+        let id = self.pick_entity_hit()??;
+        let kind = self.target_type(self.level_entity(id)?);
+        let path = kind.strip_prefix("minecraft:")?;
+        interactive(path).then(|| super::screen_info::tr(&format!("entity.minecraft.{path}"), &[]))
+    }
+
+    /// The interact button above the hotbar (centre, half width, half height), while shown.
+    fn touch_interact_rect(&self, gui: &Gui) -> Option<([f32; 2], f32, f32)> {
+        let label = self.touch.interact.as_ref()?;
+        let tw = HudBatch::text_width(&self.gui.atlas, label);
+        Some(([gui.w / 2.0, gui.h - 62.0], (tw / 2.0 + 8.0).round(), 9.0))
+    }
