From 16615be6322650d346ca97739fd5f07e247db3c6 Mon Sep 17 00:00:00 2001
From: oneshot <oneshot@localhost>
Date: Fri, 13 Nov 2026 00:42:34 +0300
Subject: [PATCH] android: pace chunk arrival to what the device takes in

ChunkBatchReceived answered a fixed 64 chunks a tick, so the server sent a
whole view in half a second; and once the received backlog was 50 ms old
(two frames at 30 fps) poll_remote inserted all of it in one frame. On a
Snapdragon 695 that was the 200-500 ms frames after a world opens.

- The reply is ChunkBatchSizeCalculator's: the window thread's time per
  inserted column, averaged over the batches, gives the chunks a tick that
  fit 2.5 ms a tick while playing (7 ms behind the loading screen).
- An overdue backlog gets 4 ms of chunk packets a frame instead of no
  limit; the loading screen gets 8 ms.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/horizon-client/src/game/remote.rs      | 141 ++++++++++++++++--
 .../horizon-client/src/game/remote_chunks.rs  |   8 +-
 2 files changed, 132 insertions(+), 17 deletions(-)

diff --git a/crates/horizon-client/src/game/remote.rs b/crates/horizon-client/src/game/remote.rs
index 6fbfde7f..f194c735 100644
--- a/crates/horizon-client/src/game/remote.rs
+++ b/crates/horizon-client/src/game/remote.rs
@@ -766,6 +766,12 @@ pub(super) struct Remote {
     /// the oldest of them first waited (`poll_remote`).
     backlog: VecDeque<Received>,
     backlog_since: Option<Instant>,
+    /// The window thread's and the decoder's time on the columns of the
+    /// batch being received (since its `ChunkBatchStart`), and the rates
+    /// each keeps up with, which the client answers its end with.
+    batch_nanos: Option<(Duration, Duration)>,
+    chunk_pace: ChunkPace,
+    decode_pace: ChunkPace,
     /// `ClientboundTransferPacket`'s target: when the connection ends the
     /// game connects here, the stored cookies carried over (`TransferState`).
     transfer: Option<String>,
@@ -783,10 +789,74 @@ pub(super) struct Remote {
 /// time the player crossed a chunk border at 32 chunks; they decode on the
 /// chunk decoder's thread now, and the frame only inserts them.
 const CHUNK_PACKETS_PER_FRAME: Duration = Duration::from_millis(1);
-/// Events that have waited this long are all handled in the next frame,
-/// whatever inserting their columns costs, up to a column still decoding:
-/// the packets after a slow machine's chunks don't wait on its frames.
+/// Events that have waited this long get `OVERDUE_CHUNK_BUDGET` of chunk
+/// packets in the next frame instead of `CHUNK_PACKETS_PER_FRAME`, up to a
+/// column still decoding: the packets after a slow machine's chunks don't
+/// wait long on its frames. Not the whole backlog at once: on a phone at
+/// 30 fps every arriving backlog is overdue after two frames, and inserting
+/// all of it was a 200-500 ms frame.
 const BACKLOG_LIMIT: Duration = Duration::from_millis(50);
+/// The chunk packets of a frame whose backlog is overdue.
+const OVERDUE_CHUNK_BUDGET: Duration = Duration::from_millis(4);
+/// The chunk packets of a frame behind the level loading screen, which
+/// draws little and takes no input.
+const LOADING_CHUNK_BUDGET: Duration = Duration::from_millis(8);
+
+/// ChunkBatchReceived's rate (ChunkBatchSizeCalculator), from the
+/// window thread's time inserting a batch's columns (`ChunkBatchStart` to
+/// `ChunkBatchFinished`), and the decoder's thread's time decoding them,
+/// whichever keeps up with fewer. A fixed
+/// ceiling of 64 chunks a tick let the server send a whole view (hundreds
+/// of columns) in half a second, faster than a phone takes them in; the
+/// reply keeps a tick's chunks to `PLAY_NANOS` of this thread
+/// (`LOADING_NANOS` behind the loading screen), what the frames' chunk
+/// budgets take in at 30 fps.
+#[derive(Clone, Copy, Debug)]
+pub(super) struct ChunkPace {
+    nanos_per_chunk: f64,
+    samples: u32,
+}
+
+impl ChunkPace {
+    /// A tick's chunks while the player plays: 50 ms a second at 20 ticks.
+    pub(super) const PLAY_NANOS: f64 = 2_500_000.0;
+    /// A tick's chunks behind the level loading screen.
+    pub(super) const LOADING_NANOS: f64 = 7_000_000.0;
+    /// A tick's chunks on the decoder's thread, which decodes nothing else:
+    /// half of the tick, so a column waits for it rarely.
+    pub(super) const DECODER_NANOS: f64 = 25_000_000.0;
+    /// The first guess, before any batch was measured: 5 chunks a tick
+    /// while playing, 14 while loading.
+    const START_NANOS: f64 = 500_000.0;
+    /// The batches the average weighs at most.
+    const MAX_SAMPLES: u32 = 49;
+    const MAX_RATE: f32 = 64.0;
+    const MIN_RATE: f32 = 1.0;
+
+    pub(super) const fn new() -> Self {
+        Self { nanos_per_chunk: Self::START_NANOS, samples: 1 }
+    }
+
+    /// A batch of `size` chunks took `nanos`. One odd batch (a frame
+    /// stalled by something else) moves the average at most threefold.
+    pub(super) fn batch(&mut self, size: i32, nanos: f64) {
+        if size <= 0 || !nanos.is_finite() || nanos < 0.0 {
+            return;
+        }
+        let avg = self.nanos_per_chunk;
+        let per = (nanos / f64::from(size)).clamp(avg / 3.0, avg * 3.0);
+        let n = f64::from(self.samples);
+        self.nanos_per_chunk = (avg * n + per) / (n + 1.0);
+        self.samples = (self.samples + 1).min(Self::MAX_SAMPLES);
+    }
+
+    /// The chunks a tick to ask the server for, for `tick_nanos` of this
+    /// thread a tick.
+    pub(super) fn chunks_per_tick(&self, tick_nanos: f64) -> f32 {
+        let rate = tick_nanos / self.nanos_per_chunk.max(1_000.0);
+        (rate as f32).clamp(Self::MIN_RATE, Self::MAX_RATE)
+    }
+}
 /// The open menu name of a server's horse inventory, then its chest's
 /// columns (the packet names no `MenuType`).
 const MOUNT_MENU: &str = "horizon:mount";
