+            decode_pace: ChunkPace::new(),
             server_links: Vec::new(),
             debug_query: Default::default(),
             transfer: None,
@@ -1927,9 +2000,10 @@ impl Game<'_> {
 
     /// Process what the network thread received (once per frame, like the
     /// client's packet processor), in order. Chunk packets get
-    /// `CHUNK_PACKETS_PER_FRAME`: once a frame has spent it, the events from
-    /// the next chunk packet on wait for the next frame, unless they have
-    /// already waited `BACKLOG_LIMIT`. A chunk packet still decoding holds
+    /// `CHUNK_PACKETS_PER_FRAME` (`OVERDUE_CHUNK_BUDGET` once they have
+    /// waited `BACKLOG_LIMIT`, `LOADING_CHUNK_BUDGET` behind the loading
+    /// screen): once a frame has spent it, the events from the next chunk
+    /// packet on wait for the next frame. A chunk packet still decoding holds
     /// back what follows it.
     pub(super) fn poll_remote(&mut self) -> Result<()> {
         let Some(r) = self.remote.as_mut() else {
@@ -1952,6 +2026,13 @@ impl Game<'_> {
         let overdue = r
             .backlog_since
             .is_some_and(|since| since.elapsed() >= BACKLOG_LIMIT);
+        let budget = if r.level_load.is_active() {
+            LOADING_CHUNK_BUDGET
+        } else if overdue {
+            OVERDUE_CHUNK_BUDGET
+        } else {
+            CHUNK_PACKETS_PER_FRAME
+        };
         let mut chunks = Duration::ZERO;
         // A run of ForgetLevelChunk (thousands when the server's view moves far: a
         // teleport at 32 chunks) is forgotten at once, before whatever follows it.
@@ -1966,7 +2047,7 @@ impl Game<'_> {
             }
             self.forget_remote_columns(&mut forgotten);
             let chunk = matches!(item, Received::Chunk(_));
-            if chunk && !overdue && chunks >= CHUNK_PACKETS_PER_FRAME {
+            if chunk && chunks >= budget {
                 events.push_front(item);
                 break;
             }
@@ -1980,7 +2061,14 @@ impl Game<'_> {
                         break;
                     };
                     let (packet, column) = match next {
-                        Next::Ready(decoded) => decoded,
+                        Next::Ready((packet, column, decoding)) => {
+                            if let Some(r) = self.remote.as_mut()
+                                && let Some((_, decode)) = r.batch_nanos.as_mut()
+                            {
+                                *decode += decoding;
+                            }
+                            (packet, column)
+                        }
                         Next::Decoding => {
                             events.push_front(Received::Chunk(format));
                             break;
@@ -1994,7 +2082,11 @@ impl Game<'_> {
                     if let C::LevelChunkWithLight(p) = *packet {
                         self.remote_chunk(&p, Some((&format, column)));
                     }
-                    chunks += started.map_or(Duration::ZERO, |t| t.elapsed());
+                    let spent = started.map_or(Duration::ZERO, |t| t.elapsed());
+                    chunks += spent;
+                    if let Some((insert, _)) = self.remote.as_mut().and_then(|r| r.batch_nanos.as_mut()) {
+                        *insert += spent;
+                    }
                     continue;
                 }
             };
@@ -3515,11 +3607,32 @@ impl Game<'_> {
             C::ForgetLevelChunk(p) => {
                 self.forget_remote_columns(&mut [(p.pos[0], p.pos[1])].into_iter().collect());
             }
-            C::ChunkBatchFinished(_) => {
-                // ChunkBatchSizeCalculator's ceiling; meshing runs on workers.
-                self.send(S::ChunkBatchReceived(play::ChunkBatchReceived {
-                    chunks_per_tick: 64.0,
-                }));
+            C::ChunkBatchStart(_) => {
+                if let Some(r) = self.remote.as_mut() {
+                    r.batch_nanos = Some((Duration::ZERO, Duration::ZERO));
+                }
+            }
+            C::ChunkBatchFinished(p) => {
+                // ChunkBatchSizeCalculator: the rate this client keeps up with.
+                let chunks_per_tick = self.remote.as_mut().map_or(1.0, |r| {
+                    // A batch whose columns were not measured (decoded in the frame, with
+                    // no decoder thread) says nothing of the pace.
+                    if let Some((insert, decode)) = r.batch_nanos.take()
+                        && !insert.is_zero()
+                    {
+                        r.chunk_pace.batch(p.size, insert.as_nanos() as f64);
+                        r.decode_pace.batch(p.size, decode.as_nanos() as f64);
+                    }
+                    let tick = if r.level_load.is_active() {
+                        ChunkPace::LOADING_NANOS
+                    } else {
+                        ChunkPace::PLAY_NANOS
+                    };
+                    // The decoder has a thread of its own: half of each tick.
+                    let decoder = r.decode_pace.chunks_per_tick(ChunkPace::DECODER_NANOS);
+                    r.chunk_pace.chunks_per_tick(tick).min(decoder)
+                });
+                self.send(S::ChunkBatchReceived(play::ChunkBatchReceived { chunks_per_tick }));
             }
             C::BlockUpdate(p) => self.server_block(p.pos, p.state),
             C::AddTransientBlock(p) => self.add_transient_block(p.pos, p.state),
