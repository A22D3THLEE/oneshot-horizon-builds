+/// Every core the process may run on, as it was before any thread was pinned.
+#[cfg(target_os = "android")]
+fn full_mask() -> Option<libc::cpu_set_t> {
+    struct Mask(libc::cpu_set_t);
+    // SAFETY: a plain bit array, read only after it is set.
+    unsafe impl Sync for Mask {}
+    unsafe impl Send for Mask {}
+    static FULL: OnceLock<Option<Mask>> = OnceLock::new();
+    FULL.get_or_init(|| {
+        // SAFETY: `set` is a live, zeroed local of the size passed; pid 0 is the calling thread.
+        unsafe {
+            let mut set: libc::cpu_set_t = std::mem::zeroed();
+            (libc::sched_getaffinity(0, std::mem::size_of::<libc::cpu_set_t>(), &mut set) == 0)
+                .then_some(Mask(set))
+        }
+    })
+    .as_ref()
+    .map(|m| m.0)
+}
+
+/// A thread started by a pinned one inherits its cores (Linux copies the mask to a new
+/// thread): the job workers, the chunk encoders and the savers the render and server
+/// threads start would all crowd onto the big cores, the little ones idle, and the big
+/// cluster heats while frames wait behind the workers. A helper takes every core back.
+#[cfg(target_os = "android")]
+pub fn spread_current() -> bool {
+    let Some(set) = full_mask() else {
+        return false;
+    };
+    // SAFETY: `set` is a live local of the size passed; pid 0 is the calling thread.
+    unsafe { libc::sched_setaffinity(0, std::mem::size_of::<libc::cpu_set_t>(), &set) == 0 }
+}
+
+#[cfg(not(target_os = "android"))]
+pub fn spread_current() -> bool {
+    false
+}
+
 /// The CPU time the calling thread has used, where only an OS call gives it
 /// precisely. Windows counts it exactly only in cycles of the time-stamp
 /// counter (`QueryThreadCycleTime`; `GetThreadTimes` moves in scheduler ticks
@@ -230,6 +272,7 @@ pub fn put_helpers_behind() {
 /// wants its core. A tick or a frame then gets a core when it starts instead
 /// of waiting behind them. Nothing elsewhere. Whether the OS took it.
 pub fn behind_server() -> bool {
+    spread_current();
     HELPERS_BEHIND.load(Ordering::Relaxed) && behind()
 }
 
