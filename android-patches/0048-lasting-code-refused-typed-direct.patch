+/// Whether the relay serves the player's lasting code: said in the status and, for the launcher,
+/// in friends-kept.txt next to the identity ("ok" or "refused"). Nothing without an identity.
+fn note_kept(shared: &Shared, served: &str) {
+    let kept = shared
+        .identity
+        .lock()
+        .unwrap()
+        .as_ref()
+        .map(|(path, id)| (path.with_file_name("friends-kept.txt"), id.code.nameplate == served));
+    let Some((file, ok)) = kept else {
+        return;
+    };
+    if let Err(e) = std::fs::write(&file, if ok { "ok\n" } else { "refused\n" }) {
+        eprintln!("horizon-friends: {}: {e}", file.display());
+    }
+    if !ok {
+        eprintln!("horizon-friends: the relay didn't take the lasting code, serving {served}");
+        shared.state.lock().unwrap().relay_problem = Some(KEPT_REFUSED.to_owned());
+    }
+}
+
 fn register(shared: &Arc<Shared>, relay_url: &str) -> io::Result<()> {
     let config = &shared.config;
     let port = Some(shared.state.lock().unwrap().port);
@@ -627,6 +653,7 @@ fn register(shared: &Arc<Shared>, relay_url: &str) -> io::Result<()> {
             ..
         } if kept.is_some() => {
             // A relay from before kept codes: a new one each time, as it was.
+            eprintln!("horizon-friends: the relay refused the lasting code (bad_request)");
             let _ = control.shutdown(Shutdown::Both);
             shared.claims.store(false, Ordering::Relaxed);
             return register(shared, relay_url);
@@ -636,6 +663,7 @@ fn register(shared: &Arc<Shared>, relay_url: &str) -> io::Result<()> {
             ..
         } if kept.is_some() => {
             // No room for one more kept code there: a fresh one this time.
+            eprintln!("horizon-friends: the relay has no room for the lasting code (full)");
             let _ = control.shutdown(Shutdown::Both);
             shared.claims.store(false, Ordering::Relaxed);
             let result = register(shared, relay_url);
@@ -671,6 +699,7 @@ fn register(shared: &Arc<Shared>, relay_url: &str) -> io::Result<()> {
         let _ = control.shutdown(Shutdown::Both);
         return Ok(());
     }
+    note_kept(shared, &code.nameplate);
     shared.guesses.lock().unwrap().registered();
     shared.publish(Some(code.clone()));
     loop {
