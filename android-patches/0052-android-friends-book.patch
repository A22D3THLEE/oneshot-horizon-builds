diff --git a/crates/horizon-friends/src/book.rs b/crates/horizon-friends/src/book.rs
new file mode 100644
index 0000000..3779834
--- /dev/null
+++ b/crates/horizon-friends/src/book.rs
@@ -0,0 +1,250 @@
+//! The friends a player shared a world with: each side of a session hands the other a card (its
+//! name and lasting short code, [`crate::identity`]) once the tunnel is up, and the book keeps
+//! them beside the identity file, so Join a Friend can join one again without typing a code.
+//! Without an identity file there is no book and no card: a lasting code is the launcher's.
+//!
+//! ```text
+//! K7QM<TAB>3XPD<TAB>1763251200<TAB>0<TAB>Alex
+//! ```
+//! (nameplate, secret, last played in Unix seconds, stale, name). A stale entry turned a wrong
+//! code once: its owner reissued the secret, so it is never tried again until a new card comes,
+//! as every wrong guess counts toward the owner's limit on the relay.
+use crate::code::{self, Code};
+use std::{
+    path::PathBuf,
+    sync::Mutex,
+    time::{SystemTime, UNIX_EPOCH},
+};
+
+/// Entries the book keeps, the most recent first.
+const KEEP: usize = 32;
+/// Characters of a name kept.
+const NAME: usize = 24;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Friend {
+    pub name: String,
+    pub code: Code,
+    /// Unix seconds of the last session together.
+    pub last: u64,
+    pub stale: bool,
+}
+
+/// The book as read (None: not yet), and this player's name for the cards.
+static BOOK: Mutex<Option<Vec<Friend>>> = Mutex::new(None);
+static NAME_MINE: Mutex<String> = Mutex::new(String::new());
+
+fn path() -> Option<PathBuf> {
+    let id = crate::identity::path()?;
+    Some(id.with_file_name("friends-book.txt"))
+}
+
+fn now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs())
+}
+
+/// A name as kept: printable, one line, no tabs, at most [`NAME`] characters.
+fn clean(name: &str) -> String {
+    name.chars()
+        .filter(|c| !c.is_control())
+        .take(NAME)
+        .collect::<String>()
+        .trim()
+        .to_owned()
+}
+
+fn parse(text: &str) -> Vec<Friend> {
+    let mut out = Vec::new();
+    for line in text.lines() {
+        let mut parts = line.splitn(5, '\t');
+        let (Some(n), Some(s), Some(last), Some(stale), Some(name)) = (
+            parts.next(),
+            parts.next(),
+            parts.next(),
+            parts.next(),
+            parts.next(),
+        ) else {
+            continue;
+        };
+        let (Some(nameplate), Some(secret)) = (code::parse_nameplate(n), code::parse_nameplate(s))
+        else {
+            continue;
+        };
+        out.push(Friend {
+            name: clean(name),
+            code: Code { nameplate, secret },
+            last: last.trim().parse().unwrap_or(0),
+            stale: stale.trim() == "1",
+        });
+    }
+    out.sort_by(|a, b| b.last.cmp(&a.last));
+    out.truncate(KEEP);
+    out
+}
+
+fn format(book: &[Friend]) -> String {
+    book.iter()
+        .map(|f| {
+            format!(
+                "{}\t{}\t{}\t{}\t{}\n",
+                f.code.nameplate,
+                f.code.secret,
+                f.last,
+                u8::from(f.stale),
+                f.name
+            )
+        })
+        .collect()
+}
+
+/// Run `f` on the book (read on first use), then save it when `f` says it changed.
+fn with_book<T>(f: impl FnOnce(&mut Vec<Friend>) -> (T, bool)) -> Option<T> {
+    let path = path()?;
+    let mut guard = BOOK.lock().unwrap_or_else(|e| e.into_inner());
+    let book = guard.get_or_insert_with(|| {
+        std::fs::read_to_string(&path)
+            .map(|t| parse(&t))
+            .unwrap_or_default()
+    });
+    let (out, changed) = f(book);
+    if changed {
+        let mut tmp = path.as_os_str().to_owned();
+        tmp.push(".tmp");
+        let tmp = PathBuf::from(tmp);
+        if std::fs::write(&tmp, format(book)).is_ok() {
+            let _ = std::fs::rename(&tmp, &path);
+        }
+    }
+    Some(out)
+}
+
+/// The friends played with, the most recent first (at most `n`).
+pub fn recent(n: usize) -> Vec<Friend> {
+    with_book(|b| (b.iter().take(n).cloned().collect(), false)).unwrap_or_default()
+}
+
+/// The name this player's cards carry (the game sets it when a world opens).
+pub fn set_name(name: &str) {
+    *NAME_MINE.lock().unwrap_or_else(|e| e.into_inner()) = clean(name);
+}
+
+/// This player's card, None without an identity file.
+pub fn my_card() -> Option<Vec<u8>> {
+    let path = crate::identity::path()?;
+    let id = crate::identity::Identity::load_or_create(&path).ok()?;
+    let name = NAME_MINE.lock().unwrap_or_else(|e| e.into_inner()).clone();
+    let card = serde_json::json!({ "card": { "name": name, "code": id.code.to_string() } });
+    serde_json::to_vec(&card).ok()
+}
+
+/// A control message from the other side: kept when it is a card.
+pub fn heard(message: &[u8]) {
+    #[derive(serde::Deserialize)]
+    struct Card {
+        name: String,
+        code: String,
+    }
+    #[derive(serde::Deserialize)]
+    struct Message {
+        card: Card,
+    }
+    let Ok(Message { card }) = serde_json::from_slice::<Message>(message) else {
+        return;
+    };
+    let Some(code) = Code::parse(&card.code) else {
+        return;
+    };
+    met(&card.name, code);
+}
+
+/// Note a session with the friend named `name` behind `code`.
+pub fn met(name: &str, code: Code) {
+    // Our own card never comes back, but a player could join their own world.
+    if let Some(mine) = crate::identity::path().and_then(|p| crate::identity::Identity::read(&p))
+        && mine.code.nameplate == code.nameplate
+    {
+        return;
+    }
+    let mut name = clean(name);
+    if name.is_empty() {
+        name = code.nameplate.clone();
+    }
+    with_book(|b| {
+        // One entry per nameplate (two friends may share a name).
+        b.retain(|f| f.code.nameplate != code.nameplate);
+        b.insert(
+            0,
+            Friend {
+                name,
+                code,
+                last: now(),
+                stale: false,
+            },
+        );
+        b.truncate(KEEP);
+        ((), true)
+    });
+}
+
+fn find(b: &mut [Friend], code: &str) -> Option<usize> {
+    let code = Code::parse(code)?;
+    b.iter().position(|f| f.code == code)
+}
+
+/// A join with `code` worked: its friend moves up.
+pub fn joined(code: &str) {
+    with_book(|b| match find(b, code) {
+        Some(i) => {
+            let mut f = b.remove(i);
+            f.last = now();
+            f.stale = false;
+            b.insert(0, f);
+            ((), true)
+        }
+        None => ((), false),
+    });
+}
+
+/// A join with `code` met a wrong secret: never tried again until a new card.
+pub fn wrong(code: &str) {
+    with_book(|b| match find(b, code) {
+        Some(i) => {
+            b[i].stale = true;
+            ((), true)
+        }
+        None => ((), false),
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_book_reads_back_what_it_wrote_and_skips_broken_lines() {
+        let book = vec![
+            Friend {
+                name: "Alex".into(),
+                code: Code::parse("K7QM-3XPD").unwrap(),
+                last: 20,
+                stale: false,
+            },
+            Friend {
+                name: "Sam".into(),
+                code: Code::parse("ABCD-EFGH").unwrap(),
+                last: 10,
+                stale: true,
+            },
+        ];
+        let text = format!("{}broken line\nK7\tX\t1\t0\tBad\n", format(&book));
+        assert_eq!(parse(&text), book);
+    }
+
+    #[test]
+    fn names_stay_on_one_line() {
+        assert_eq!(clean("  A\tB\nC  "), "ABC");
+        assert_eq!(clean(&"x".repeat(40)).len(), NAME);
+    }
+}
