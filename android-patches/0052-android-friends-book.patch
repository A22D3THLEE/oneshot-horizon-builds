+/// Join a Friend's row of the friends played with lately (horizon-friends' book, filled by
+/// the cards both sides of a session swap): a press joins one with their lasting code.
+mod recent_friends {
+    use super::{ButtonSpec, half, quarter};
+    use horizon_friends::book::{self, Friend};
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    /// The two friends' buttons, then » for the next two.
+    pub const FIRST: u8 = 70;
+    pub const MORE: u8 = 72;
+    static PAGE: AtomicUsize = AtomicUsize::new(0);
+
+    /// The friends shown, and whether there are more than fit.
+    fn shown() -> (Vec<Friend>, bool) {
+        let all = book::recent(32);
+        if all.len() <= 2 {
+            return (all, false);
+        }
+        let pages = all.len().div_ceil(2);
+        let page = PAGE.load(Ordering::Relaxed) % pages;
+        (all.into_iter().skip(page * 2).take(2).collect(), true)
+    }
+
+    pub fn any() -> bool {
+        !book::recent(1).is_empty()
+    }
+
+    fn label(name: &str, chars: usize) -> String {
+        if name.chars().count() <= chars {
+            name.to_owned()
+        } else {
+            let mut s: String = name.chars().take(chars - 1).collect();
+            s.push('…');
+            s
+        }
+    }
+
+    pub fn buttons(w: f32, h: f32) -> Vec<ButtonSpec> {
+        let (friends, more) = shown();
+        let (x, y) = (half(w) - 100.0, quarter(h) + 90.0);
+        let mut out = Vec::new();
+        let (bw, chars) = match (friends.len(), more) {
+            (1, _) => (200.0, 24),
+            (_, false) => (98.0, 13),
+            (_, true) => (81.0, 10),
+        };
+        for (k, f) in friends.iter().enumerate() {
+            out.push((
+                x + k as f32 * (bw + 2.0),
+                y,
+                bw,
+                label(&f.name, chars),
+                !f.stale,
+                FIRST + k as u8,
+            ));
+        }
+        if more {
+            out.push((x + 166.0, y, 34.0, "»".to_owned(), true, MORE));
+        }
+        out
+    }
+
+    /// A press on button `id`: the address to join, if it was a friend's.
+    pub fn press(id: u8) -> Option<String> {
+        if id == MORE {
+            PAGE.fetch_add(1, Ordering::Relaxed);
+            return None;
+        }
+        let (friends, _) = shown();
+        let f = friends.get(usize::from(id - FIRST))?;
+        (!f.stale).then(|| format!("{}{}", crate::net::FRIEND, f.code))
+    }
+}
