+
+        recent.removeAllViews();
+        List<File> worlds = WorldsPage.worlds(a.dir);
+        if (worlds.isEmpty()) {
+            note(recent, Ui.t("Миров пока нет: создайте первый в игре.", "No worlds yet: create the first one in the game."));
+        }
+        for (int i = 0; i < Math.min(3, worlds.size()); i++) {
+            File w = worlds.get(i);
+            LinearLayout r = Ui.row(a);
+            TextView n = Ui.text(a, w.getName(), 15, Ui.TEXT, true);
+            n.setSingleLine(true);
