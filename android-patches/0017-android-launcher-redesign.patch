+        look.addView(langs, Ui.gap(a, 4));
+
+        LinearLayout acc = block(Ui.t("Акцент", "Accent"));
+        String cur = Ui.pref(a, "accent.txt");
+        if (cur.isEmpty()) cur = Ui.ACCENT_IDS[0];
+        android.widget.HorizontalScrollView hs = new android.widget.HorizontalScrollView(a);
+        hs.setHorizontalScrollBarEnabled(false);
+        LinearLayout chips = Ui.row(a);
+        for (int i = 0; i < Ui.ACCENT_IDS.length; i++) {
+            final String id = Ui.ACCENT_IDS[i];
+            boolean on = id.equals(cur);
+            TextView c = Ui.text(a, "●  " + Ui.t(Ui.ACCENT_RU[i], Ui.ACCENT_EN[i]), 13, on ? Ui.ON_ACCENT : Ui.TEXT, true);
+            c.setPadding(dp(12), dp(6), dp(14), dp(6));
+            c.setBackground(on ? Ui.rounded(a, Ui.ACCENT_COLORS[i], 0, 20) : Ui.rounded(a, Ui.HIGH, Ui.EDGE, 20));
+            if (!on) {
+                android.text.SpannableString s = new android.text.SpannableString(c.getText());
+                s.setSpan(new android.text.style.ForegroundColorSpan(Ui.ACCENT_COLORS[i]), 0, 1, 0);
+                c.setText(s);
+            }
+            c.setOnClickListener(new View.OnClickListener() {
+                public void onClick(View v) {
+                    Ui.setPref(a, "accent.txt", id);
+                    Ui.load(a);
+                    a.recreate();
+                }
+            });
