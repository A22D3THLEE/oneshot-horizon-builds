+        tip.addView(Ui.text(a, Ui.t(t[0], t[1]), 14, Ui.TEXT, false));
+    }
+
+    @Override
+    void shown() {
+        String name = a.readName();
+        int hour = Calendar.getInstance().get(Calendar.HOUR_OF_DAY);
+        String greet = hour < 5 ? Ui.t("Доброй ночи", "Good night") : hour < 12 ? Ui.t("Доброе утро", "Good morning")
+                : hour < 18 ? Ui.t("Добрый день", "Good afternoon") : Ui.t("Добрый вечер", "Good evening");
+        hello.setText(greet + (name.isEmpty() ? "" : ", " + name));
+
+        Map<String, String> t = PlayStats.totals(a);
+        figures.removeAllViews();
+        View[] tiles = {
+            Ui.tile(a, Ui.duration(PlayStats.num(t, "total")), Ui.t("всего в игре", "played")),
