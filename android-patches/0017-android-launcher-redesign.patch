@@ -0,0 +1,54 @@
+package dev.horizonlab.horizon;
+
+import android.content.Intent;
+import android.view.View;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/** One page of the launcher (ProfileActivity's left rail picks it): built once, refreshed when shown. */
+abstract class Page {
+    final ProfileActivity a;
+    final LinearLayout root;
+
+    Page(ProfileActivity a) {
+        this.a = a;
+        root = new LinearLayout(a);
+        root.setOrientation(LinearLayout.VERTICAL);
+    }
+
+    /** The page came in front (also the first time). */
+    void shown() {}
+
+    void hidden() {}
+
+    /** A file picker or share sheet answered; true when it was this page's request. */
+    boolean onResult(int request, int result, Intent data) {
+        return false;
+    }
+
+    int dp(float v) {
+        return Ui.dp(a, v);
+    }
+
+    /** A block with a caption, added to the page with the usual gap. */
+    LinearLayout block(String caption) {
+        LinearLayout p = Ui.panel(a);
+        if (caption != null) p.addView(Ui.caption(a, caption));
+        root.addView(p, Ui.gap(a, 12));
+        return p;
+    }
+
+    TextView note(LinearLayout into, String s) {
+        TextView t = Ui.text(a, s, 12, Ui.MUTED, false);
+        into.addView(t);
+        return t;
+    }
+
+    /** A row of buttons sharing the width. */
+    LinearLayout buttons(LinearLayout into, View... views) {
+        LinearLayout r = Ui.row(a);
+        for (int i = 0; i < views.length; i++) r.addView(views[i], Ui.part(a, i == 0));
+        into.addView(r, Ui.gap(a, 8));
+        return r;
+    }
+}
diff --git a/packaging/android/java/dev/horizonlab/horizon/PlayStats.java b/packaging/android/java/dev/horizonlab/horizon/PlayStats.java
new file mode 100644
index 0000000..c5ca639
--- /dev/null
+++ b/packaging/android/java/dev/horizonlab/horizon/PlayStats.java
@@ -0,0 +1,160 @@
+package dev.horizonlab.horizon;
+
+import android.content.Context;
+import java.io.File;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.text.SimpleDateFormat;
+import java.util.Calendar;
+import java.util.LinkedHashMap;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Oneshot: play time, as the PC launcher keeps it (PlayStats.cs). The game screen writes the
+ * running session to session.txt (start, a heartbeat every minute, paused or not, a clean end);
+ * the launcher folds a finished one into play-stats.txt. A session that stopped without a clean
+ * end while the game was in front is a crash: the launcher then offers the crash screen.
+ *
+ * play-stats.txt: key=value lines, total / sessions / longest / last / friends (ms or epoch ms),
+ * d.yyyy-MM-dd (ms that day) and v.<version> (ms on that app version).
+ */
+final class PlayStats {
+    /** A game screen runs in this process (the launcher was opened from the game). */
+    static volatile boolean alive;
+
+    private PlayStats() {}
+
+    private static File session(Context c) {
+        return new File(c.getFilesDir(), "session.txt");
+    }
+
+    private static File stats(Context c) {
+        return new File(c.getFilesDir(), "play-stats.txt");
+    }
+
+    static Map<String, String> read(File f) {
+        Map<String, String> m = new LinkedHashMap<>();
+        try {
+            for (String l : new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8).split("\n")) {
+                int eq = l.indexOf('=');
+                if (eq > 0) m.put(l.substring(0, eq).trim(), l.substring(eq + 1).trim());
+            }
+        } catch (Exception ignored) {
+        }
+        return m;
+    }
+
+    private static void write(File f, Map<String, String> m) {
+        StringBuilder b = new StringBuilder();
+        for (Map.Entry<String, String> e : m.entrySet()) b.append(e.getKey()).append('=').append(e.getValue()).append('\n');
+        try {
+            File tmp = new File(f.getPath() + ".tmp");
+            Files.write(tmp.toPath(), b.toString().getBytes(StandardCharsets.UTF_8));
+            if (!tmp.renameTo(f)) {
+                f.delete();
+                tmp.renameTo(f);
+            }
+        } catch (Exception ignored) {
+        }
+    }
+
+    static long num(Map<String, String> m, String key) {
+        try {
+            String v = m.get(key);
+            return v == null ? 0 : Long.parseLong(v);
+        } catch (Exception e) {
+            return 0;
+        }
+    }
+
+    private static String day(long when) {
+        return new SimpleDateFormat("yyyy-MM-dd", Locale.ROOT).format(new java.util.Date(when));
+    }
+
+    /** The game screen opened: a new session (a left-over one is folded first). */
+    static synchronized void begin(Context c, boolean friends) {
+        fold(c);
+        long now = System.currentTimeMillis();
+        Map<String, String> s = new LinkedHashMap<>();
+        s.put("start", "" + now);
+        s.put("beat", "" + now);
+        s.put("paused", "0");
+        s.put("clean", "0");
+        s.put("friends", friends ? "1" : "0");
+        s.put("version", UpdateActivity.versionName(c));
+        write(session(c), s);
+    }
+
+    /** The heartbeat; paused null keeps the flag. Sharing the world counts as playing with friends. */
+    static synchronized void beat(Context c, Boolean paused) {
+        File f = session(c);
+        if (!f.isFile()) return;
+        Map<String, String> s = read(f);
+        long now = System.currentTimeMillis();
+        // Time in the background is not play time: a pause ends the counted stretch.
+        if (!"1".equals(s.get("paused"))) s.put("played", "" + (num(s, "played") + Math.max(0, Math.min(now - num(s, "beat"), 120000))));
+        s.put("beat", "" + now);
+        if (paused != null) s.put("paused", paused ? "1" : "0");
+        if (new File(SetupActivity.home(c), "invite-code.txt").isFile()) s.put("friends", "1");
+        write(f, s);
+    }
+
+    /** The player left the game on purpose. */
+    static synchronized void end(Context c) {
+        File f = session(c);
+        if (!f.isFile()) return;
+        beat(c, null);
+        Map<String, String> s = read(f);
+        s.put("clean", "1");
+        write(f, s);
+        boolean was = alive;
+        alive = false;
+        fold(c);
+        alive = was;
+    }
+
+    /**
+     * A finished session into the totals. True when it ended in a crash: no clean end while the
+     * game was in front (a game the system closed in the background is no crash).
+     */
+    static synchronized boolean fold(Context c) {
+        if (alive) return false;
+        File f = session(c);
+        if (!f.isFile()) return false;
+        Map<String, String> s = read(f);
+        f.delete();
+        long played = Math.max(0, Math.min(num(s, "played"), 24L * 3600000));
+        long start = num(s, "start");
+        Map<String, String> t = read(stats(c));
+        t.put("total", "" + (num(t, "total") + played));
+        t.put("sessions", "" + (num(t, "sessions") + 1));
+        t.put("longest", "" + Math.max(num(t, "longest"), played));
+        t.put("last", "" + Math.max(num(t, "last"), num(s, "beat")));
+        if ("1".equals(s.get("friends"))) t.put("friends", "" + (num(t, "friends") + played));
+        String d = "d." + day(start > 0 ? start : System.currentTimeMillis());
+        t.put(d, "" + (num(t, d) + played));
+        String v = "v." + (s.get("version") == null ? "?" : s.get("version"));
+        t.put(v, "" + (num(t, v) + played));
+        write(stats(c), t);
+        return !"1".equals(s.get("clean")) && !"1".equals(s.get("paused")) && start > 0;
+    }
+
+    static Map<String, String> totals(Context c) {
+        return read(stats(c));
+    }
+
+    /** The last seven days, oldest first: ms played and short day names. */
+    static long[] week(Map<String, String> t, String[] names) {
+        long[] out = new long[7];
+        Calendar cal = Calendar.getInstance();
+        cal.add(Calendar.DAY_OF_MONTH, -6);
+        SimpleDateFormat dn = new SimpleDateFormat("EE", Ui.ru() ? new Locale("ru") : Locale.ENGLISH);
+        for (int i = 0; i < 7; i++) {
+            out[i] = num(t, "d." + day(cal.getTimeInMillis()));
+            names[i] = dn.format(cal.getTime());
+            cal.add(Calendar.DAY_OF_MONTH, 1);
+        }
+        return out;
+    }
+}
