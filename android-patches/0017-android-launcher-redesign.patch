+                            a.say(Ui.t("Не удалось отправить: ", "Could not send: ") + err, Ui.BAD);
+                            return;
+                        }
+                        a.say(Ui.t("Лог отправлен: ", "Log sent: ") + u, Ui.GREEN);
+                        new AlertDialog.Builder(a)
+                                .setTitle(Ui.t("Лог отправлен", "Log sent"))
+                                .setMessage(u)
+                                .setPositiveButton(Ui.t("Скопировать", "Copy"), new DialogInterface.OnClickListener() {
+                                    public void onClick(DialogInterface d, int w) {
+                                        ClipboardManager cm = (ClipboardManager) a.getSystemService(Context.CLIPBOARD_SERVICE);
+                                        if (cm != null) cm.setPrimaryClip(ClipData.newPlainText("log", u));
+                                    }
+                                })
+                                .setNeutralButton(Ui.t("Поделиться", "Share"), new DialogInterface.OnClickListener() {
+                                    public void onClick(DialogInterface d, int w) {
+                                        Intent i = new Intent(Intent.ACTION_SEND);
+                                        i.setType("text/plain");
+                                        i.putExtra(Intent.EXTRA_TEXT, u);
