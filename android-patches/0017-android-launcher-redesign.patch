+    // ---- The team's catalog: seeds.json and maps.json -----------------------------------------
+
+    private void loadCatalog() {
+        teamLoaded = true;
+        teamSeeds.removeAllViews();
+        maps.removeAllViews();
+        note(teamSeeds, Ui.t("Загружаем…", "Loading…"));
+        note(maps, Ui.t("Загружаем…", "Loading…"));
+        new Thread(new Runnable() {
+            public void run() {
+                JSONArray seeds = null, mapList = null;
+                String failSeeds = null, failMaps = null;
+                try {
+                    seeds = new JSONObject(Net.get(CATALOG + "seeds.json")).optJSONArray("seeds");
+                } catch (Exception e) {
+                    failSeeds = e.getMessage();
+                }
+                try {
+                    mapList = new JSONObject(Net.get(CATALOG + "maps.json")).optJSONArray("maps");
+                } catch (Exception e) {
+                    failMaps = e.getMessage();
+                }
+                final JSONArray s = seeds, m = mapList;
+                final String fs = failSeeds, fm = failMaps;
+                a.runOnUiThread(new Runnable() {
+                    public void run() {
+                        if (a.isFinishing()) return;
+                        showTeamSeeds(s, fs);
+                        showMaps(m, fm);
+                    }
+                });
+            }
+        }).start();
+    }
+
+    private String unavailable(String error) {
+        if (error != null && error.contains("404")) return Ui.t("Пока не опубликовано командой.", "Not published by the team yet.");
+        teamLoaded = false;
+        return Ui.t("Нет связи — попробуйте позже.", "No connection: try later.");
+    }
+
+    private void showTeamSeeds(JSONArray s, String error) {
+        teamSeeds.removeAllViews();
+        if (s == null || s.length() == 0) {
+            note(teamSeeds, s == null ? unavailable(error) : Ui.t("Список пуст.", "The list is empty."));
+            return;
+        }
+        for (int i = 0; i < s.length(); i++) {
+            JSONObject o = s.optJSONObject(i);
+            if (o == null) continue;
+            String seed = o.optString("seed", "");
+            if (seed.isEmpty()) continue;
+            teamSeeds.addView(seedRow(o.optString("name", seed), seed, o.optString("note", "")));
+        }
+    }
+
+    private void showMaps(JSONArray m, String error) {
+        maps.removeAllViews();
+        if (m == null || m.length() == 0) {
+            note(maps, m == null ? unavailable(error) : Ui.t("Список пуст.", "The list is empty."));
+            return;
+        }
+        for (int i = 0; i < m.length(); i++) {
+            JSONObject o = m.optJSONObject(i);
+            if (o == null) continue;
+            final String name = o.optString("name", "");
+            final String url = o.optString("url", "");
+            final String sha = o.optString("sha256", "").toLowerCase(java.util.Locale.ROOT);
+            // Only an https link with a checksum: the file is checked before it becomes a world.
+            if (name.isEmpty() || !url.startsWith("https://") || !sha.matches("[0-9a-f]{64}")) continue;
+            long size = o.optLong("size", 0);
+            LinearLayout r = Ui.row(a);
+            r.setPadding(0, dp(6), 0, dp(6));
+            LinearLayout col = new LinearLayout(a);
+            col.setOrientation(LinearLayout.VERTICAL);
+            col.addView(Ui.text(a, name, 14, Ui.TEXT, true));
+            String note = o.optString("note", "");
+            if (size > 0) note = (note.isEmpty() ? "" : note + " · ") + Ui.size(size);
+            if (!note.isEmpty()) col.addView(Ui.text(a, note, 12, Ui.MUTED, false));
+            r.addView(col, new LinearLayout.LayoutParams(0, -2, 1));
+            TextView get = Ui.chip(a, Ui.t("Скачать", "Download"), true);
+            get.setOnClickListener(new View.OnClickListener() {
+                public void onClick(View v) {
+                    download(name, url, sha);
+                }
+            });
+            r.addView(get);
+            maps.addView(r);
+        }
+        if (maps.getChildCount() == 0) note(maps, Ui.t("Список пуст.", "The list is empty."));
+    }
+
+    private void download(final String name, final String url, final String sha) {
+        run(new Job() {
+            public String run() throws Exception {
+                File tmp = new File(a.getCacheDir(), "map-download.zip");
+                MessageDigest md = MessageDigest.getInstance("SHA-256");
+                HttpURLConnection c = Net.open(url);
+                long got = 0, total = c.getContentLengthLong();
+                try (InputStream in = c.getInputStream(); FileOutputStream out = new FileOutputStream(tmp)) {
+                    byte[] buf = new byte[65536];
+                    int n;
+                    long shown = 0;
+                    while ((n = in.read(buf)) > 0) {
+                        out.write(buf, 0, n);
+                        md.update(buf, 0, n);
+                        got += n;
+                        if (got > (2L << 30)) throw new Exception(Ui.t("карта больше 2 ГБ", "the map is over 2 GB"));
+                        if (got - shown > (1 << 20)) {
+                            shown = got;
+                            final String p = Ui.t("Скачиваем «", "Downloading “") + name + Ui.t("»: ", "”: ") + Ui.size(got)
+                                    + (total > 0 ? " / " + Ui.size(total) : "");
+                            a.runOnUiThread(new Runnable() {
+                                public void run() {
+                                    a.say(p, Ui.WARN);
+                                }
+                            });
+                        }
+                    }
+                } finally {
+                    c.disconnect();
+                }
+                try {
+                    if (!Net.hex(md.digest()).equals(sha)) throw new Exception(Ui.t("файл не совпал с контрольной суммой", "the file does not match its checksum"));
+                    String world;
+                    try (InputStream in = new FileInputStream(tmp)) {
+                        world = a.importWorld(in);
+                    }
+                    if (world == null) throw new Exception(Ui.t("в архиве нет мира", "no world in the archive"));
+                    return Ui.t("Карта добавлена: ", "Map added: ") + world;
+                } finally {
+                    tmp.delete();
+                }
+            }
+        });
+    }
+}
