+            r.addView(n, new LinearLayout.LayoutParams(0, -2, 1));
+            r.addView(Ui.text(a, Ui.ago(new File(w, "level.dat").lastModified()), 12, Ui.MUTED, false));
+            r.setOnClickListener(new View.OnClickListener() {
