diff --git a/packaging/android/java/dev/horizonlab/horizon/Net.java b/packaging/android/java/dev/horizonlab/horizon/Net.java
new file mode 100644
index 0000000..336bb23
--- /dev/null
+++ b/packaging/android/java/dev/horizonlab/horizon/Net.java
@@ -0,0 +1,218 @@
+package dev.horizonlab.horizon;
+
+import android.app.Activity;
+import android.net.Uri;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.Locale;
+
+/**
+ * Oneshot: the network bits of the PC launcher (RelayStatus.cs, Invites.cs). The relay is the
+ * server friends meet through when they cannot reach each other directly; its address is the
+ * game's (android_main.rs: relay.txt in the game folder, else Oneshot's VPS).
+ */
+final class Net {
+    static final String REPO = "A22D3THLEE/oneshot-horizon-builds";
+    /** The page that turns an http link (clickable in any chat) into oneshot://join/<code>. */
+    static final String JOIN_PAGE = "https://a22d3thlee.github.io/oneshot-horizon-builds/join.html";
+    static final String DEFAULT_RELAY = "166.1.36.218:7000";
+
+    private Net() {}
+
+    /** The relay the game uses, or "" when it is turned off. */
+    static String relay(Activity a) {
+        try {
+            return new String(Files.readAllBytes(new File(SetupActivity.home(a), "relay.txt").toPath()), StandardCharsets.UTF_8).trim();
+        } catch (Exception e) {
+            return DEFAULT_RELAY;
+        }
+    }
+
+    /** An invite code as the game prints it, or null: Crockford base32, 20+ characters, friend: optional. */
+    static String normalize(String raw) {
+        if (raw == null) return null;
+        String code = Uri.decode(raw).toUpperCase(Locale.ROOT).replaceAll("[\\s\\-/]", "");
+        if (code.startsWith("FRIEND:")) code = code.substring(7);
+        code = code.replace('O', '0').replace('I', '1').replace('L', '1');
+        return code.matches("[0-9A-HJKMNP-TV-Z]{20,}") ? code : null;
+    }
+
+    /** The code the running game shares now (invite-code.txt), or null. */
+    static String hostCode(Activity a) {
+        try {
+            File f = new File(SetupActivity.home(a), "invite-code.txt");
+            return f.isFile() ? normalize(new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8).trim()) : null;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    static String linkFor(String code) {
+        return JOIN_PAGE + "#" + code;
+    }
+
+    /** Watches the relay: a TCP connect every 5 s, like the PC launcher's status line. */
+    static final class Relay {
+        interface Listener {
+            /** ms >= 0 online (0: answered too fast to be the real server), -1 offline, -2 turned off. */
+            void onStatus(long ms);
+        }
+
+        private volatile boolean running;
+        private Thread thread;
+
+        void start(final Activity a, final Listener l) {
+            stop();
+            running = true;
+            final String relay = relay(a);
+            thread = new Thread(new Runnable() {
+                public void run() {
+                    int misses = 0;
+                    while (running) {
+                        long ms = -2;
+                        if (!relay.isEmpty()) {
+                            ms = ping(relay);
+                            if (ms < 0) {
+                                misses++;
+                                // One lost try is noise on mobile internet; two in a row is offline.
+                                if (misses < 2) ms = Long.MIN_VALUE;
+                            } else {
+                                misses = 0;
+                            }
+                        }
+                        final long shown = ms;
+                        if (shown != Long.MIN_VALUE && running) {
+                            a.runOnUiThread(new Runnable() {
+                                public void run() {
+                                    if (running) l.onStatus(shown);
+                                }
+                            });
+                        }
+                        try {
+                            Thread.sleep(5000);
+                        } catch (InterruptedException e) {
+                            return;
+                        }
+                    }
+                }
+            }, "oneshot-relay-ping");
+            thread.setDaemon(true);
+            thread.start();
+        }
+
+        void stop() {
+            running = false;
+            if (thread != null) thread.interrupt();
+            thread = null;
+        }
+
+        private static long ping(String relay) {
+            String hostPort = relay.replaceFirst("^[a-z]+://", "");
+            int slash = hostPort.indexOf('/');
+            if (slash >= 0) hostPort = hostPort.substring(0, slash);
+            int colon = hostPort.lastIndexOf(':');
+            String host = colon > 0 ? hostPort.substring(0, colon) : hostPort;
+            int port = 7000;
+            try {
+                if (colon > 0) port = Integer.parseInt(hostPort.substring(colon + 1));
+            } catch (Exception ignored) {
+            }
+            try (Socket s = new Socket()) {
+                long t = System.nanoTime();
+                s.connect(new InetSocketAddress(host, port), 3000);
+                long ms = (System.nanoTime() - t) / 1000000;
+                // Under 1 ms is a local tunnel answering, not the server itself.
+                return ms < 1 ? 0 : ms;
+            } catch (Exception e) {
+                return -1;
+            }
+        }
+
+        static String label(long ms) {
+            if (ms == -2) return Ui.t("Сервер Oneshot: выключен (relay.txt пуст)", "Oneshot server: off (relay.txt is empty)");
+            if (ms < 0) return Ui.t("Сервер Oneshot: недоступен", "Oneshot server: offline");
+            if (ms == 0) return Ui.t("Сервер Oneshot: доступен", "Oneshot server: reachable");
+            return Ui.t("Сервер Oneshot: онлайн · ", "Oneshot server: online · ") + ms + Ui.t(" мс", " ms");
+        }
+    }
+
+    static HttpURLConnection open(String url) throws Exception {
+        for (int i = 0; i < 5; i++) {
+            if (!url.startsWith("https://")) throw new java.io.IOException("not https: " + url);
+            HttpURLConnection c = (HttpURLConnection) new URL(url).openConnection();
+            c.setInstanceFollowRedirects(false);
+            c.setConnectTimeout(15000);
+            c.setReadTimeout(30000);
+            c.setRequestProperty("User-Agent", "OneshotAndroid");
+            int code = c.getResponseCode();
+            if (code >= 300 && code < 400 && c.getHeaderField("Location") != null) {
+                url = new URL(new URL(url), c.getHeaderField("Location")).toString();
+                c.disconnect();
+                continue;
+            }
+            if (code != 200) {
+                c.disconnect();
+                throw new java.io.IOException("HTTP " + code);
+            }
+            return c;
+        }
+        throw new java.io.IOException("too many redirects");
+    }
+
+    static String get(String url) throws Exception {
+        HttpURLConnection c = open(url);
+        try (InputStream in = c.getInputStream()) {
+            return new String(readAll(in, 4 << 20), StandardCharsets.UTF_8);
+        } finally {
+            c.disconnect();
+        }
+    }
+
+    /** A form POST (application/x-www-form-urlencoded); the answer's body. */
+    static String post(String url, String field, String value) throws Exception {
+        HttpURLConnection c = (HttpURLConnection) new URL(url).openConnection();
+        c.setConnectTimeout(15000);
+        c.setReadTimeout(60000);
+        c.setDoOutput(true);
+        c.setRequestMethod("POST");
+        c.setRequestProperty("User-Agent", "OneshotAndroid");
+        c.setRequestProperty("Content-Type", "application/x-www-form-urlencoded");
+        byte[] body = (field + "=" + java.net.URLEncoder.encode(value, "UTF-8")).getBytes(StandardCharsets.UTF_8);
+        try (OutputStream out = c.getOutputStream()) {
+            out.write(body);
+        }
+        int code = c.getResponseCode();
+        InputStream in = code < 400 ? c.getInputStream() : c.getErrorStream();
+        try {
+            return in == null ? "" : new String(readAll(in, 1 << 20), StandardCharsets.UTF_8);
+        } finally {
+            if (in != null) in.close();
+            c.disconnect();
+        }
+    }
+
+    static byte[] readAll(InputStream in, long max) throws Exception {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        byte[] buf = new byte[16384];
+        int n;
+        while ((n = in.read(buf)) > 0) {
+            out.write(buf, 0, n);
+            if (out.size() > max) throw new java.io.IOException("too big");
+        }
+        return out.toByteArray();
+    }
+
+    static String hex(byte[] b) {
+        StringBuilder s = new StringBuilder();
+        for (byte x : b) s.append(String.format(Locale.ROOT, "%02x", x & 0xff));
+        return s.toString();
+    }
+}
diff --git a/packaging/android/java/dev/horizonlab/horizon/PackShare.java b/packaging/android/java/dev/horizonlab/horizon/PackShare.java
new file mode 100644
index 0000000..6ebef71
--- /dev/null
+++ b/packaging/android/java/dev/horizonlab/horizon/PackShare.java
@@ -0,0 +1,228 @@
+package dev.horizonlab.horizon;
+
+import android.content.Context;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+import java.util.zip.ZipOutputStream;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * Oneshot: the PC launcher's .oneshotpack (PackShare.cs): a zip with oneshot-pack.json
+ * {Format:1, Version, Mods:[ids], ResourcePacks:[...], Made} and the folders horizon-mods,
+ * resourcepacks and shaderpacks. Opening one moves the player's own set to pack-backups first.
+ */
+final class PackShare {
+    static final String[] FOLDERS = {"horizon-mods", "resourcepacks", "shaderpacks"};
+
+    private PackShare() {}
+
+    /** The ids switched on in horizon-mods.txt (lines mod.<id>:true). */
+    static List<String> enabledMods(File home) {
+        List<String> ids = new ArrayList<>();
+        for (String l : lines(new File(home, "horizon-mods.txt"))) {
+            l = l.trim();
+            if (l.startsWith("mod.") && l.endsWith(":true")) ids.add(l.substring(4, l.length() - 5));
+        }
+        return ids;
+    }
+
+    /** The resource packs options.txt turns on, without the built-in vanilla. */
+    static List<String> enabledPacks(File home) {
+        List<String> out = new ArrayList<>();
+        for (String l : lines(new File(home, "options.txt"))) {
+            if (!l.startsWith("resourcePacks:")) continue;
+            try {
+                JSONArray arr = new JSONArray(l.substring("resourcePacks:".length()).trim());
+                for (int i = 0; i < arr.length(); i++) if (!"vanilla".equals(arr.getString(i))) out.add(arr.getString(i));
+            } catch (Exception ignored) {
+            }
+        }
+        return out;
+    }
+
+    static int export(Context c, File home, OutputStream raw) throws Exception {
+        int files = 0;
+        try (ZipOutputStream zip = new ZipOutputStream(raw)) {
+            JSONObject meta = new JSONObject();
+            meta.put("Format", 1);
+            meta.put("Version", UpdateActivity.versionName(c));
+            meta.put("Mods", new JSONArray(enabledMods(home)));
+            meta.put("ResourcePacks", new JSONArray(enabledPacks(home)));
+            meta.put("Made", new java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss", java.util.Locale.ROOT).format(new java.util.Date()));
+            zip.putNextEntry(new ZipEntry("oneshot-pack.json"));
+            zip.write(meta.toString(2).getBytes(StandardCharsets.UTF_8));
+            zip.closeEntry();
+            for (String f : FOLDERS) files += add(zip, new File(home, f), f);
+        }
+        return files;
+    }
+
+    private static int add(ZipOutputStream zip, File f, String rel) throws Exception {
+        if (f.isDirectory()) {
+            int n = 0;
+            File[] kids = f.listFiles();
+            if (kids != null) for (File k : kids) n += add(zip, k, rel + "/" + k.getName());
+            return n;
+        }
+        if (!f.isFile()) return 0;
+        zip.putNextEntry(new ZipEntry(rel));
+        Files.copy(f.toPath(), zip);
+        zip.closeEntry();
+        return 1;
+    }
+
+    /** Unpacks a set over the player's own (kept in pack-backups/<time>); the number of files. */
+    static int open(File home, InputStream raw) throws Exception {
+        File staging = new File(home, "pack-import.tmp");
+        ProfileActivity.deleteTree(staging);
+        staging.mkdirs();
+        JSONObject meta = null;
+        int files = 0;
+        long total = 0;
+        try {
+            try (ZipInputStream zin = new ZipInputStream(raw)) {
+                ZipEntry e;
+                byte[] buf = new byte[65536];
+                while ((e = zin.getNextEntry()) != null) {
+                    String n = e.getName().replace('\\', '/');
+                    if (n.startsWith("/") || n.contains("../") || n.equals("..") || e.isDirectory()) continue;
+                    if (n.equals("oneshot-pack.json")) {
+                        meta = new JSONObject(new String(Net.readAll(zin, 1 << 20), StandardCharsets.UTF_8));
+                        continue;
+                    }
+                    boolean ours = false;
+                    for (String f : FOLDERS) if (n.startsWith(f + "/")) ours = true;
+                    if (!ours) continue;
+                    File out = new File(staging, n);
+                    out.getParentFile().mkdirs();
+                    try (FileOutputStream fo = new FileOutputStream(out)) {
+                        int r;
+                        while ((r = zin.read(buf)) > 0) {
+                            fo.write(buf, 0, r);
+                            total += r;
+                            if (total > (2L << 30)) throw new Exception(Ui.t("набор больше 2 ГБ", "the set is over 2 GB"));
+                        }
+                    }
+                    files++;
+                }
+            }
+            if (meta == null || meta.optInt("Format", 0) != 1) {
+                throw new Exception(Ui.t("это не файл .oneshotpack", "not a .oneshotpack file"));
+            }
+            // The player's own set first, so nothing is lost.
+            File backup = new File(new File(home, "pack-backups"), new java.text.SimpleDateFormat("yyyy-MM-dd_HH-mm-ss",
+                    java.util.Locale.ROOT).format(new java.util.Date()));
+            backup.mkdirs();
+            for (String f : FOLDERS) {
+                File cur = new File(home, f);
+                if (cur.exists() && !cur.renameTo(new File(backup, f))) throw new Exception("backup " + f);
+                File got = new File(staging, f);
+                if (got.isDirectory()) {
+                    if (!got.renameTo(cur)) throw new Exception("move " + f);
+                } else {
+                    cur.mkdirs();
+                }
+            }
+            copyIfThere(new File(home, "horizon-mods.txt"), new File(backup, "horizon-mods.txt"));
+            copyIfThere(new File(home, "options.txt"), new File(backup, "options.txt"));
+            List<String> mods = new ArrayList<>();
+            JSONArray m = meta.optJSONArray("Mods");
+            if (m != null) for (int i = 0; i < m.length(); i++) mods.add(m.getString(i));
+            List<String> packs = new ArrayList<>();
+            JSONArray p = meta.optJSONArray("ResourcePacks");
+            if (p != null) for (int i = 0; i < p.length(); i++) packs.add(p.getString(i));
+            setMods(home, mods);
+            setPacks(home, packs);
+            return files;
+        } finally {
+            ProfileActivity.deleteTree(staging);
+        }
+    }
+
+    /** The newest folder in pack-backups, or null. */
+    static File lastBackup(File home) {
+        File[] all = new File(home, "pack-backups").listFiles();
+        File best = null;
+        if (all != null) for (File f : all) if (f.isDirectory() && (best == null || f.getName().compareTo(best.getName()) > 0)) best = f;
+        return best;
+    }
+
+    static void restore(File home) throws Exception {
+        File b = lastBackup(home);
+        if (b == null) throw new Exception(Ui.t("нет сохранённого набора", "no saved set"));
+        for (String f : FOLDERS) {
+            File cur = new File(home, f);
+            ProfileActivity.deleteTree(cur);
+            File old = new File(b, f);
+            if (old.isDirectory()) {
+                if (!old.renameTo(cur)) throw new Exception("restore " + f);
+            } else {
+                cur.mkdirs();
+            }
+        }
+        File mods = new File(b, "horizon-mods.txt");
+        if (mods.isFile()) Files.copy(mods.toPath(), new File(home, "horizon-mods.txt").toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+        File opts = new File(b, "options.txt");
+        if (opts.isFile()) setPacks(home, enabledPacks(b));
+        ProfileActivity.deleteTree(b);
+    }
+
+    private static void copyIfThere(File from, File to) throws Exception {
+        if (from.isFile()) Files.copy(from.toPath(), to.toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+    }
+
+    /** As the PC's SetEnabledSet: exactly these mods on, every other mod.* line off. */
+    private static void setMods(File home, List<String> ids) throws Exception {
+        StringBuilder b = new StringBuilder();
+        for (String l : lines(new File(home, "horizon-mods.txt"))) {
+            String t = l.trim();
+            if (t.isEmpty()) continue;
+            if (t.startsWith("mod.") && t.contains(":")) {
+                String id = t.substring(4, t.lastIndexOf(':'));
+                if (!ids.contains(id)) b.append("mod.").append(id).append(":false\n");
+            } else {
+                b.append(l).append('\n');
+            }
+        }
+        for (String id : ids) b.append("mod.").append(id).append(":true\n");
+        Files.write(new File(home, "horizon-mods.txt").toPath(), b.toString().getBytes(StandardCharsets.UTF_8));
+    }
+
+    /** resourcePacks:["vanilla", ...] in options.txt; the other options stay as they are. */
+    private static void setPacks(File home, List<String> packs) throws Exception {
+        JSONArray arr = new JSONArray();
+        arr.put("vanilla");
+        for (String s : packs) arr.put(s);
+        String line = "resourcePacks:" + arr.toString().replace("\\/", "/");
+        StringBuilder b = new StringBuilder();
+        boolean done = false;
+        for (String l : lines(new File(home, "options.txt"))) {
+            if (l.startsWith("resourcePacks:")) {
+                b.append(line).append('\n');
+                done = true;
+            } else if (!l.isEmpty()) {
+                b.append(l).append('\n');
+            }
+        }
+        if (!done) b.append(line).append('\n');
+        Files.write(new File(home, "options.txt").toPath(), b.toString().getBytes(StandardCharsets.UTF_8));
+    }
+
+    static List<String> lines(File f) {
+        List<String> out = new ArrayList<>();
+        try {
+            for (String l : new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8).split("\n")) out.add(l.replace("\r", ""));
+        } catch (Exception ignored) {
+        }
+        return out;
+    }
+}
