+                .setNegativeButton(Ui.t("Отмена", "Cancel"), null)
+                .show();
+    }
+
+    static String scrub(Context c, String text, String name) {
+        String[] paths = {SetupActivity.home(c), c.getFilesDir().getAbsolutePath(), "/storage/emulated/0", "/data/user/0", "/data/data"};
+        for (String p : paths) if (p != null && !p.isEmpty()) text = text.replace(p, "~");
+        if (name != null && name.length() >= 3) text = text.replace(name, "<player>");
