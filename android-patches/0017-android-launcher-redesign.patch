+package dev.horizonlab.horizon;
+
+import android.view.View;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import java.io.File;
+import java.util.Calendar;
+import java.util.List;
+import java.util.Map;
+
+/** Oneshot: the start page, as the PC launcher's Home (HomePage.cs): play time, last worlds, news, a tip. */
+final class HomePage extends Page {
+    private static final String[][] TIPS = {
+        {"Скриншот — кнопка F2 на сенсорной панели. Снимки появятся в «Галерее».",
+            "Screenshot: the F2 button on the touch panel. Shots show up in the Gallery."},
+        {"Чтобы позвать друга, откройте мир для друзей в игре: код приглашения появится на странице «Друзья».",
+            "To invite a friend, open your world to friends in the game: the invite code shows up on the Friends page."},
+        {"Перед обновлением игры сделайте бэкап миров на странице «Миры».",
+            "Back your worlds up on the Worlds page before updating the game."},
+        {"Миры переносятся между телефоном и ПК обычным zip — экспорт и импорт на странице «Миры».",
+            "Worlds move between the phone and the PC as a plain zip: export and import on the Worlds page."},
+        {"Набор модов и ресурспаков можно передать другу одним файлом .oneshotpack («Друзья»).",
+            "Hand your mods and resource packs to a friend as one .oneshotpack file (Friends)."},
+        {"Игра тормозит на Snapdragon? Попробуйте драйвер Turnip в «Настройках».",
+            "Slow on a Snapdragon? Try the Turnip driver in Settings."},
+        {"Вылет? Лог можно посмотреть и отправить из «Настроек» — так проще найти причину.",
+            "A crash? View and send the log from Settings: it makes the cause easier to find."},
+    };
+
+    private final TextView hello;
+    private final LinearLayout figures;
+    private final Ui.Week week;
+    private final TextView weekTotal;
+    private final LinearLayout recent;
+    private final LinearLayout news;
+    private boolean newsLoaded;
+
+    HomePage(ProfileActivity a) {
+        super(a);
+        hello = Ui.text(a, "", 26, Ui.TEXT, true);
+        root.addView(hello);
+        LinearLayout status = Ui.row(a);
+        status.addView(Ui.chip(a, "v" + UpdateActivity.versionName(a), false));
+        TextView relay = a.relayLabel();
