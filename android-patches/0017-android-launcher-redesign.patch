+
+    /** The log goes to mclo.gs only after the player read what happens and agreed. */
+    static void confirmUpload(final ProfileActivity a) {
+        if (!logFile(a).isFile()) {
+            a.say(Ui.t("Лога ещё нет: игра не запускалась.", "No log yet: the game has not run."), Ui.WARN);
+            return;
+        }
+        new AlertDialog.Builder(a)
+                .setTitle(Ui.t("Отправить лог на mclo.gs?", "Send the log to mclo.gs?"))
+                .setMessage(Ui.t("Лог загрузится на сайт mclo.gs, и вы получите ссылку — её можно отправить тем, кто помогает с ошибкой. "
