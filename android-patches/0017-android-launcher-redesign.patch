+        if (!newsLoaded) loadNews();
+    }
+
+    private void loadNews() {
+        newsLoaded = true;
+        news.removeAllViews();
+        note(news, Ui.t("Загружаем…", "Loading…"));
+        new Thread(new Runnable() {
+            public void run() {
+                List<UpdateActivity.Release> list = null;
+                try {
+                    list = UpdateActivity.releases(a, false);
+                } catch (Exception ignored) {
+                }
+                final List<UpdateActivity.Release> got = list;
+                a.runOnUiThread(new Runnable() {
+                    public void run() {
+                        if (a.isFinishing()) return;
+                        news.removeAllViews();
+                        if (got == null || got.isEmpty()) {
+                            newsLoaded = false;
+                            note(news, Ui.t("Нет связи с GitHub — новости появятся позже.", "No connection to GitHub: news later."));
+                            return;
+                        }
+                        for (int i = 0; i < Math.min(3, got.size()); i++) {
+                            UpdateActivity.Release r = got.get(i);
+                            news.addView(Ui.text(a, r.name + (r.date.isEmpty() ? "" : "  ·  " + r.date), 14, i == 0 ? Ui.GREEN : Ui.TEXT, true),
+                                    Ui.gap(a, i == 0 ? 0 : 8));
+                            String notes = readable(r.notes);
+                            if (notes.length() > 220) notes = notes.substring(0, 220) + "…";
+                            if (!notes.isEmpty()) note(news, notes);
+                        }
+                        TextView more = Ui.text(a, Ui.t("Все версии →", "All versions →"), 13, Ui.GREEN, true);
+                        more.setOnClickListener(new View.OnClickListener() {
+                            public void onClick(View v) {
+                                a.startActivity(new android.content.Intent(a, UpdateActivity.class));
+                            }
+                        });
+                        news.addView(more, Ui.gap(a, 6));
+                    }
+                });
+            }
+        }).start();
+    }
+
+    /**
+     * The release text a player reads: without the service lines CI writes for UpdateActivity
+     * (versionCode, versionName, sha256, port commit, patches) and the heading that repeats the title.
+     */
+    static String readable(String body) {
+        StringBuilder b = new StringBuilder();
+        for (String l : body.replace("\r", "").split("\n")) {
+            String t = l.trim();
+            if (t.isEmpty() || t.startsWith("OneShot for Android")) continue;
+            if (t.matches("(?i)(versionCode|versionName|sha256|port commit|patches)\\s*:.*")) continue;
+            b.append(t).append(' ');
+        }
+        return b.toString().replaceAll("[#*`>]", "").replaceAll("\\s+", " ").trim();
+    }
+}
