+    static long copyTree(File from, File to) throws Exception {
+        long n = 0;
+        File[] kids = from.listFiles();
+        if (kids == null) return 0;
+        to.mkdirs();
+        for (File k : kids) {
+            File d = new File(to, k.getName());
+            if (k.isDirectory()) {
+                n += copyTree(k, d);
+            } else if (!k.getName().equals("session.lock")) {
+                Files.copy(k.toPath(), d.toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+                n += k.length();
+            }
+        }
+        return n;
+    }
