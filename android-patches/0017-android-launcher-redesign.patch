+        };
+        // Four in a row when there is room, else two rows of two.
+        int per = a.pageWidthDp() >= 560 ? 4 : 2;
+        for (int i = 0; i < tiles.length; i += per) {
+            LinearLayout r = Ui.row(a);
+            for (int j = 0; j < per && i + j < tiles.length; j++) r.addView(tiles[i + j], Ui.part(a, j == 0));
