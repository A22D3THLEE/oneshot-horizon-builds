diff --git a/packaging/android/java/dev/horizonlab/horizon/FriendsPage.java b/packaging/android/java/dev/horizonlab/horizon/FriendsPage.java
new file mode 100644
index 0000000..22b9d05
--- /dev/null
+++ b/packaging/android/java/dev/horizonlab/horizon/FriendsPage.java
@@ -0,0 +1,221 @@
+package dev.horizonlab.horizon;
+
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.content.Intent;
+import android.view.View;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/**
+ * Oneshot: playing together, as the PC launcher's Friends page: the code to join with, the code
+ * the running game shares (invite-code.txt) with a link to send, the relay's state and the
+ * mod/resource pack set as one .oneshotpack file (PackShare).
+ */
+final class FriendsPage extends Page {
+    static final int PACK_OUT = 13;
+    static final int PACK_IN = 14;
+
+    private final TextView hostCode;
+    private final TextView hostNote;
+    private final Button copyCode, shareCode;
+    private final Button restore;
+    private String code;
+
+    FriendsPage(final ProfileActivity a) {
+        super(a);
+        Ui.title(root, Ui.t("Друзья", "Friends"), Ui.t("Игра вместе: по коду приглашения, через сервер Oneshot или по адресу.",
+                "Play together: by invite code, through the Oneshot server or by address."));
+
+        LinearLayout join = block(Ui.t("Подключиться к другу", "Join a friend"));
+        a.join = Ui.field(a, "friend:…  /  host:port");
+        a.join.setTextSize(14);
+        join.addView(a.join, Ui.gap(a, 4));
+        note(join, Ui.t("Код друга (friend:…), steam:… или адрес сервера. Пусто — игра откроется в главном меню. Нажмите ИГРАТЬ.",
+                "A friend's code (friend:…), steam:… or a server address. Empty: the game opens at the main menu. Press PLAY."));
+        Button paste = Ui.button(a, Ui.t("Вставить", "Paste"), false);
+        paste.setOnClickListener(new View.OnClickListener() {
+            public void onClick(View v) {
+                ClipboardManager cm = (ClipboardManager) a.getSystemService(Context.CLIPBOARD_SERVICE);
+                CharSequence s = cm == null || !cm.hasPrimaryClip() || cm.getPrimaryClip().getItemCount() == 0 ? null
+                        : cm.getPrimaryClip().getItemAt(0).coerceToText(a);
+                a.setJoin(s == null ? "" : s.toString());
+            }
+        });
+        Button clear = Ui.button(a, Ui.t("Очистить", "Clear"), false);
+        clear.setOnClickListener(new View.OnClickListener() {
+            public void onClick(View v) {
+                a.join.setText("");
+            }
+        });
+        buttons(join, paste, clear);
+
+        LinearLayout host = block(Ui.t("Позвать друзей", "Invite friends"));
+        hostCode = Ui.text(a, "", 22, Ui.TEXT, true);
+        hostCode.setTypeface(android.graphics.Typeface.MONOSPACE, android.graphics.Typeface.BOLD);
+        hostCode.setTextIsSelectable(true);
+        host.addView(hostCode);
+        hostNote = note(host, "");
+        copyCode = Ui.button(a, Ui.t("Скопировать код", "Copy code"), false);
+        copyCode.setOnClickListener(new View.OnClickListener() {
+            public void onClick(View v) {
+                if (code == null) return;
+                ClipboardManager cm = (ClipboardManager) a.getSystemService(Context.CLIPBOARD_SERVICE);
+                if (cm != null) cm.setPrimaryClip(ClipData.newPlainText("invite", "friend:" + code));
+                a.say(Ui.t("Код скопирован.", "Code copied."), Ui.GREEN);
+            }
+        });
+        shareCode = Ui.button(a, Ui.t("Отправить ссылку…", "Send a link…"), true);
+        shareCode.setOnClickListener(new View.OnClickListener() {
+            public void onClick(View v) {
+                if (code == null) return;
+                Intent i = new Intent(Intent.ACTION_SEND);
+                i.setType("text/plain");
+                i.putExtra(Intent.EXTRA_TEXT, Ui.t("Заходи ко мне в Oneshot: ", "Join me in Oneshot: ") + Net.linkFor(code)
+                        + Ui.t("\nИли вставь код в лаунчере: friend:", "\nOr paste the code in the launcher: friend:") + code);
+                try {
+                    a.startActivity(Intent.createChooser(i, Ui.t("Отправить приглашение", "Send the invite")));
+                } catch (Exception e) {
+                    a.say(Ui.t("Нечем поделиться: скопируйте код.", "Nothing to share with: copy the code."), Ui.WARN);
+                }
+            }
+        });
+        buttons(host, copyCode, shareCode);
+
+        LinearLayout relay = block(Ui.t("Сервер Oneshot", "Oneshot server"));
+        relay.addView(a.relayLabel());
+        note(relay, Ui.t("Через него друзья находят друг друга, когда напрямую не выходит (мобильный интернет, CGNAT). "
+                + "Свой адрес — в relay.txt в папке игры, пустой файл выключает сервер.",
+                "Friends meet through it when they cannot reach each other directly (mobile internet, CGNAT). "
+                + "Your own address goes in relay.txt in the game folder; an empty file turns it off."));
+
+        LinearLayout pack = block(Ui.t("Набор модов и ресурспаков", "Mods and resource packs"));
+        note(pack, Ui.t("Файл .oneshotpack: ваши моды Horizon, ресурспаки и шейдеры — чтобы у друга было то же самое. Открывается и лаунчером на ПК.",
+                "A .oneshotpack file: your Horizon mods, resource packs and shaders, so a friend gets the same set. The PC launcher opens it too."));
+        Button out = Ui.button(a, Ui.t("Сохранить набор…", "Save the set…"), false);
+        out.setOnClickListener(new View.OnClickListener() {
+            public void onClick(View v) {
+                Intent i = new Intent(Intent.ACTION_CREATE_DOCUMENT);
+                i.addCategory(Intent.CATEGORY_OPENABLE);
+                i.setType("application/octet-stream");
+                i.putExtra(Intent.EXTRA_TITLE, "oneshot-" + new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.ROOT)
+                        .format(new java.util.Date()) + ".oneshotpack");
+                a.startActivityForResult(i, PACK_OUT);
+            }
+        });
+        Button in = Ui.button(a, Ui.t("Открыть набор…", "Open a set…"), false);
+        in.setOnClickListener(new View.OnClickListener() {
+            public void onClick(View v) {
+                Intent i = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+                i.addCategory(Intent.CATEGORY_OPENABLE);
+                i.setType("*/*");
+                a.startActivityForResult(i, PACK_IN);
+            }
+        });
+        buttons(pack, out, in);
+        restore = Ui.button(a, Ui.t("Вернуть мои моды и паки", "Bring my mods and packs back"), false);
+        restore.setOnClickListener(new View.OnClickListener() {
+            public void onClick(View v) {
+                confirmRestore();
+            }
+        });
+        pack.addView(restore, Ui.gap(a, 8));
+    }
+
+    @Override
+    void shown() {
+        code = Net.hostCode(a);
+        boolean has = code != null;
+        hostCode.setVisibility(has ? View.VISIBLE : View.GONE);
+        hostCode.setText(has ? "friend:" + code : "");
+        hostNote.setText(has
+                ? Ui.t("Отправьте ссылку или код другу: он вставит его в «Подключиться к другу» и нажмёт ИГРАТЬ.",
+                        "Send the link or the code: your friend pastes it into Join a friend and presses PLAY.")
+                : Ui.t("Откройте мир для друзей в игре (пауза → «Открыть для друзей») — код появится здесь.",
+                        "Open your world to friends in the game (pause → Open to friends): the code shows up here."));
+        copyCode.setEnabled(has);
+        shareCode.setEnabled(has);
+        copyCode.setAlpha(has ? 1f : 0.4f);
+        shareCode.setAlpha(has ? 1f : 0.4f);
+        restore.setVisibility(PackShare.lastBackup(a.dir) == null ? View.GONE : View.VISIBLE);
+    }
+
+    private void confirmRestore() {
+        new android.app.AlertDialog.Builder(a)
+                .setTitle(Ui.t("Вернуть прежний набор?", "Bring the old set back?"))
+                .setMessage(Ui.t("Моды и паки, что были до открытия последнего набора, вернутся на место; нынешние будут удалены.",
+                        "The mods and packs you had before the last opened set come back; the current ones are deleted."))
+                .setPositiveButton(Ui.t("Вернуть", "Bring back"), new android.content.DialogInterface.OnClickListener() {
+                    public void onClick(android.content.DialogInterface d, int w) {
+                        run(new Job() {
+                            public String run() throws Exception {
+                                PackShare.restore(a.dir);
+                                return Ui.t("Прежний набор возвращён. Перезапустите игру.", "The old set is back. Restart the game.");
+                            }
+                        });
+                    }
+                })
+                .setNegativeButton(Ui.t("Отмена", "Cancel"), null)
+                .show();
+    }
+
+    interface Job {
+        String run() throws Exception;
+    }
+
+    private void run(final Job job) {
+        a.say(Ui.t("Работаем…", "Working…"), Ui.WARN);
+        new Thread(new Runnable() {
+            public void run() {
+                String msg;
+                int color = Ui.GREEN;
+                try {
+                    msg = job.run();
+                } catch (Exception e) {
+                    msg = Ui.t("Не получилось: ", "Failed: ") + e.getMessage();
+                    color = Ui.BAD;
+                }
+                final String m = msg;
+                final int c = color;
+                a.runOnUiThread(new Runnable() {
+                    public void run() {
+                        a.say(m, c);
+                        shown();
+                    }
+                });
+            }
+        }).start();
+    }
+
+    @Override
+    boolean onResult(int request, int result, final Intent data) {
+        if (request != PACK_OUT && request != PACK_IN) return false;
+        if (result != android.app.Activity.RESULT_OK || data == null || data.getData() == null) return true;
+        if (request == PACK_OUT) {
+            run(new Job() {
+                public String run() throws Exception {
+                    int n;
+                    try (java.io.OutputStream o = a.getContentResolver().openOutputStream(data.getData())) {
+                        n = PackShare.export(a, a.dir, o);
+                    }
+                    return Ui.t("Набор сохранён: файлов ", "Set saved: files ") + n;
+                }
+            });
+        } else {
+            run(new Job() {
+                public String run() throws Exception {
+                    int n;
+                    try (java.io.InputStream in = a.getContentResolver().openInputStream(data.getData())) {
+                        n = PackShare.open(a.dir, in);
+                    }
+                    return Ui.t("Набор открыт: файлов ", "Set opened: files ") + n
+                            + Ui.t(". Прежний сохранён — его можно вернуть. Перезапустите игру.", ". The old one is kept and can come back. Restart the game.");
+                }
+            });
+        }
+        return true;
+    }
+}
diff --git a/packaging/android/java/dev/horizonlab/horizon/GalleryPage.java b/packaging/android/java/dev/horizonlab/horizon/GalleryPage.java
new file mode 100644
index 0000000..97a80d0
--- /dev/null
+++ b/packaging/android/java/dev/horizonlab/horizon/GalleryPage.java
@@ -0,0 +1,192 @@
+package dev.horizonlab.horizon;
+
+import android.app.AlertDialog;
+import android.content.DialogInterface;
+import android.content.Intent;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.net.Uri;
+import android.provider.DocumentsContract;
+import android.view.View;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import java.io.File;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.List;
+
+/** Oneshot: the screenshots (F2 in the game), as the PC launcher's Gallery: a grid, a viewer, share and delete. */
+final class GalleryPage extends Page {
+    private static final int MAX = 60;
+    private static final String AUTHORITY = "dev.horizonlab.horizon.documents";
+
+    private final LinearLayout grid;
+    private final TextView count;
+    private int generation;
+
+    GalleryPage(ProfileActivity a) {
+        super(a);
+        Ui.title(root, Ui.t("Галерея", "Gallery"), Ui.t("Скриншоты из игры. Снимок — кнопка F2 на сенсорной панели.",
+                "Screenshots from the game. Take one with F2 on the touch panel."));
+        count = Ui.text(a, "", 12, Ui.MUTED, false);
+        root.addView(count, Ui.gap(a, 4));
+        grid = new LinearLayout(a);
+        grid.setOrientation(LinearLayout.VERTICAL);
+        root.addView(grid, Ui.gap(a, 10));
+    }
+
+    private File dir() {
+        return new File(a.dir, "screenshots");
+    }
+
+    @Override
+    void shown() {
+        final int gen = ++generation;
+        grid.removeAllViews();
+        File[] all = dir().listFiles();
+        List<File> shots = new ArrayList<>();
+        if (all != null) for (File f : all) {
+            String n = f.getName().toLowerCase(java.util.Locale.ROOT);
+            if (f.isFile() && (n.endsWith(".png") || n.endsWith(".jpg") || n.endsWith(".jpeg"))) shots.add(f);
+        }
+        File[] sorted = shots.toArray(new File[0]);
+        Arrays.sort(sorted, new Comparator<File>() {
+            public int compare(File x, File y) {
+                return Long.compare(y.lastModified(), x.lastModified());
+            }
+        });
+        if (sorted.length == 0) {
+            count.setText("");
+            LinearLayout p = Ui.panel(a);
+            p.addView(Ui.text(a, Ui.t("Скриншотов пока нет", "No screenshots yet"), 16, Ui.TEXT, true));
+            note(p, Ui.t("В игре нажмите F2 на сенсорной панели — снимок появится здесь.",
+                    "In the game, press F2 on the touch panel: the shot shows up here."));
+            grid.addView(p);
+            return;
+        }
+        count.setText(sorted.length > MAX
+                ? Ui.t("Показаны " + MAX + " новых из " + sorted.length, "The newest " + MAX + " of " + sorted.length)
+                : Ui.t("Снимков: ", "Shots: ") + sorted.length);
+        int per = a.pageWidthDp() >= 560 ? 4 : 3;
+        int cell = (a.pageWidthDp() - 8 * (per - 1)) / per;
+        final List<ImageView> views = new ArrayList<>();
+        final List<File> files = new ArrayList<>();
+        LinearLayout row = null;
+        for (int i = 0; i < Math.min(MAX, sorted.length); i++) {
+            if (i % per == 0) {
+                row = Ui.row(a);
+                grid.addView(row, Ui.gap(a, i == 0 ? 0 : 8));
+            }
+            final File f = sorted[i];
+            ImageView iv = new ImageView(a);
+            iv.setScaleType(ImageView.ScaleType.CENTER_CROP);
+            iv.setBackground(Ui.rounded(a, Ui.CARD, Ui.EDGE, 10));
+            iv.setClipToOutline(true);
+            iv.setOnClickListener(new View.OnClickListener() {
+                public void onClick(View v) {
+                    view(f);
+                }
+            });
+            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, dp(cell * 9 / 16f), 1);
+            if (i % per != 0) lp.leftMargin = dp(8);
+            row.addView(iv, lp);
+            views.add(iv);
+            files.add(f);
+        }
+        // Fill the last row so the cells keep their width.
+        if (row != null) for (int k = row.getChildCount(); k < per; k++) {
+            View s = new View(a);
+            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, 1, 1);
+            lp.leftMargin = dp(8);
+            row.addView(s, lp);
+        }
+        final int px = dp(cell);
+        new Thread(new Runnable() {
+            public void run() {
+                for (int i = 0; i < files.size(); i++) {
+                    if (gen != generation) return;
+                    final Bitmap b = decode(files.get(i), px);
+                    final ImageView iv = views.get(i);
+                    if (b != null) a.runOnUiThread(new Runnable() {
+                        public void run() {
+                            if (gen == generation) iv.setImageBitmap(b);
+                        }
+                    });
+                }
+            }
+        }).start();
+    }
+
+    @Override
+    void hidden() {
+        generation++;
+        grid.removeAllViews();
+    }
+
+    static Bitmap decode(File f, int width) {
+        try {
+            BitmapFactory.Options o = new BitmapFactory.Options();
+            o.inJustDecodeBounds = true;
+            BitmapFactory.decodeFile(f.getPath(), o);
+            int s = 1;
+            while (o.outWidth / (s * 2) >= width) s *= 2;
+            BitmapFactory.Options d = new BitmapFactory.Options();
+            d.inSampleSize = s;
+            return BitmapFactory.decodeFile(f.getPath(), d);
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    private void view(final File f) {
+        ImageView big = new ImageView(a);
+        big.setAdjustViewBounds(true);
+        big.setScaleType(ImageView.ScaleType.FIT_CENTER);
+        Bitmap b = decode(f, Math.max(a.getResources().getDisplayMetrics().widthPixels, 640));
+        if (b != null) big.setImageBitmap(b);
+        new AlertDialog.Builder(a)
+                .setTitle(f.getName() + "  ·  " + Ui.size(f.length()))
+                .setView(big)
+                .setPositiveButton(Ui.t("Поделиться", "Share"), new DialogInterface.OnClickListener() {
+                    public void onClick(DialogInterface d, int w) {
+                        share(f);
+                    }
+                })
+                .setNeutralButton(Ui.t("Удалить", "Delete"), new DialogInterface.OnClickListener() {
+                    public void onClick(DialogInterface d, int w) {
+                        confirmDelete(f);
+                    }
+                })
+                .setNegativeButton(Ui.t("Закрыть", "Close"), null)
+                .show();
+    }
+
+    private void share(File f) {
+        Uri uri = DocumentsContract.buildDocumentUri(AUTHORITY, "root:screenshots/" + f.getName());
+        Intent i = new Intent(Intent.ACTION_SEND);
+        i.setType(f.getName().toLowerCase(java.util.Locale.ROOT).endsWith(".png") ? "image/png" : "image/jpeg");
+        i.putExtra(Intent.EXTRA_STREAM, uri);
+        i.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+        try {
+            a.startActivity(Intent.createChooser(i, Ui.t("Поделиться скриншотом", "Share the screenshot")));
+        } catch (Exception e) {
+            a.say(Ui.t("Нечем поделиться.", "Nothing to share with."), Ui.WARN);
+        }
+    }
+
+    private void confirmDelete(final File f) {
+        new AlertDialog.Builder(a)
+                .setTitle(Ui.t("Удалить скриншот?", "Delete the screenshot?"))
+                .setMessage(f.getName())
+                .setPositiveButton(Ui.t("Удалить", "Delete"), new DialogInterface.OnClickListener() {
+                    public void onClick(DialogInterface d, int w) {
+                        if (f.delete()) a.say(Ui.t("Скриншот удалён.", "Screenshot deleted."), Ui.GREEN);
+                        shown();
+                    }
+                })
+                .setNegativeButton(Ui.t("Отмена", "Cancel"), null)
+                .show();
+    }
+}
