+
+    static File logFile(Context c) {
+        return new File(new File(SetupActivity.home(c)), "logs/latest.log");
+    }
+
+    /** The last lines of the log (all of it when shorter). */
+    static String tail(Context c, int lines) {
+        List<String> all = PackShare.lines(logFile(c));
+        int from = Math.max(0, all.size() - lines);
+        StringBuilder b = new StringBuilder();
+        for (int i = from; i < all.size(); i++) b.append(all.get(i)).append('\n');
+        return b.toString();
+    }
+
+    static void showLog(Context c) {
+        String text = tail(c, 200);
+        if (text.trim().isEmpty()) text = Ui.t("Лог пуст: игра ещё не запускалась.", "The log is empty: the game has not run yet.");
+        TextView t = Ui.text(c, text, 12, Ui.TEXT, false);
+        t.setTypeface(android.graphics.Typeface.MONOSPACE);
+        t.setTextSize(11);
+        t.setTextIsSelectable(true);
+        int p = Ui.dp(c, 16);
