+        for (int i = 0; i < lines.size(); i++) {
+            String l = lines.get(i);
+            int tab = l.indexOf('\t');
+            if (tab <= 0) continue;
+            final int index = i;
+            View r = seedRow(l.substring(0, tab), l.substring(tab + 1), "");
+            r.setOnLongClickListener(new View.OnLongClickListener() {
+                public boolean onLongClick(View v) {
+                    lines.remove(index);
+                    saveSeeds(lines);
+                    showMySeeds();
+                    a.say(Ui.t("Сид удалён.", "Seed deleted."), Ui.GREEN);
+                    return true;
+                }
+            });
+            mySeeds.addView(r);
+            shown++;
+        }
+        if (shown == 0) note(mySeeds, Ui.t("Своих сидов пока нет.", "No seeds of your own yet."));
+    }
+
+    private void saveSeeds(List<String> lines) {
+        StringBuilder b = new StringBuilder();
+        for (String l : lines) if (!l.trim().isEmpty()) b.append(l).append('\n');
+        try {
+            Files.write(seedFile().toPath(), b.toString().getBytes(StandardCharsets.UTF_8));
+        } catch (Exception ignored) {
+        }
+    }
+
+    private View seedRow(String name, final String seed, String note) {
+        LinearLayout r = Ui.row(a);
+        r.setPadding(0, dp(6), 0, dp(6));
+        LinearLayout col = new LinearLayout(a);
+        col.setOrientation(LinearLayout.VERTICAL);
+        col.addView(Ui.text(a, name, 14, Ui.TEXT, true));
+        if (!note.isEmpty()) col.addView(Ui.text(a, note, 12, Ui.MUTED, false));
+        r.addView(col, new LinearLayout.LayoutParams(0, -2, 1));
+        TextView s = Ui.chip(a, seed, false);
+        s.setTypeface(android.graphics.Typeface.MONOSPACE);
+        s.setSingleLine(true);
+        s.setMaxWidth(dp(220));
+        s.setEllipsize(android.text.TextUtils.TruncateAt.END);
+        r.addView(s);
+        r.setOnClickListener(new View.OnClickListener() {
+            public void onClick(View v) {
+                ClipboardManager cm = (ClipboardManager) a.getSystemService(Context.CLIPBOARD_SERVICE);
+                if (cm != null) cm.setPrimaryClip(ClipData.newPlainText("seed", seed));
+                a.say(Ui.t("Сид скопирован: ", "Seed copied: ") + seed, Ui.GREEN);
+            }
+        });
+        return r;
+    }
+
+    private void addSeed() {
+        LinearLayout box = new LinearLayout(a);
+        box.setOrientation(LinearLayout.VERTICAL);
+        box.setPadding(dp(20), dp(8), dp(20), 0);
+        final EditText name = Ui.field(a, Ui.t("Название", "Name"));
+        final EditText seed = Ui.field(a, Ui.t("Сид", "Seed"));
+        box.addView(name);
+        box.addView(seed, Ui.gap(a, 8));
+        new AlertDialog.Builder(a)
+                .setTitle(Ui.t("Свой сид", "Your seed"))
+                .setView(box)
+                .setPositiveButton(Ui.t("Сохранить", "Save"), new DialogInterface.OnClickListener() {
+                    public void onClick(DialogInterface d, int x) {
+                        String n = name.getText().toString().replaceAll("[\\t\\r\\n]", " ").trim();
+                        String s = seed.getText().toString().replaceAll("\\s", "");
+                        if (s.isEmpty()) return;
+                        if (n.isEmpty()) n = Ui.t("Без названия", "Untitled");
+                        List<String> lines = PackShare.lines(seedFile());
+                        lines.add(n + "\t" + s);
+                        saveSeeds(lines);
+                        showMySeeds();
+                    }
+                })
+                .setNegativeButton(Ui.t("Отмена", "Cancel"), null)
+                .show();
+    }
