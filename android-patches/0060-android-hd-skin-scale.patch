+    /**
+     * Nearest-neighbour scaling done on the pixels: the skin is decoded non-premultiplied (so a
+     * see-through pixel keeps its colour), and Bitmap.createScaledBitmap draws through a Canvas,
+     * which refuses such a bitmap.
+     */
+    static Bitmap scaleRaw(Bitmap b, int nw, int nh) {
+        int w = b.getWidth(), h = b.getHeight();
+        int[] src = new int[w * h];
+        b.getPixels(src, 0, w, 0, 0, w, h);
+        int[] dst = new int[nw * nh];
+        for (int y = 0; y < nh; y++) {
+            int sy = (int) ((long) y * h / nh) * w;
+            for (int x = 0; x < nw; x++) dst[y * nw + x] = src[sy + (int) ((long) x * w / nw)];
+        }
+        Bitmap out = Bitmap.createBitmap(nw, nh, Bitmap.Config.ARGB_8888);
+        out.setPremultiplied(false);
+        out.setPixels(dst, 0, nw, 0, 0, nw, nh);
+        return out;
+    }
+
     private static byte[] png(Bitmap b) {
