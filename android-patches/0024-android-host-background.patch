+/// The world is shared under `code`, or no longer (`None`): `HorizonActivity.hostingChanged`
+/// starts or stops HostService, which keeps the process running behind Home.
+pub(super) fn hosting(code: Option<&str>) {
+    let Some(app) = super::ANDROID_APP.get() else {
+        return;
+    };
+    // SAFETY: as in `show`.
+    let result = (|| -> jni::errors::Result<()> {
+        let vm = unsafe { jni::JavaVM::from_raw(app.vm_as_ptr().cast())? };
+        let mut env = vm.attach_current_thread_permanently()?;
+        let activity = unsafe { jni::objects::JObject::from_raw(app.activity_as_ptr().cast()) };
+        let code = match code {
+            Some(code) => jni::objects::JObject::from(env.new_string(code)?),
+            None => jni::objects::JObject::null(),
+        };
+        env.call_method(&activity, "hostingChanged", "(Ljava/lang/String;)V", &[jni::objects::JValue::Object(&code)])?;
+        Ok(())
+    })();
+    if let Err(e) = result {
+        log::warn!("Horizon: the friends host service: {e}");
+    }
+}
