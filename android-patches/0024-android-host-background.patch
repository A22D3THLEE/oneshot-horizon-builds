diff --git a/packaging/android/java/dev/horizonlab/horizon/HostService.java b/packaging/android/java/dev/horizonlab/horizon/HostService.java
new file mode 100644
index 0000000..c26de01
--- /dev/null
+++ b/packaging/android/java/dev/horizonlab/horizon/HostService.java
@@ -0,0 +1,119 @@
+package dev.horizonlab.horizon;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.app.Service;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ServiceInfo;
+import android.net.wifi.WifiManager;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.PowerManager;
+
+/**
+ * Keeps a world shared with friends going with the game behind Home or the screen off: without a
+ * foreground service Android (MIUI first) freezes the process, the relay drops the host a minute
+ * later and the code stops working. The game starts it when sharing begins and stops it when it
+ * ends (HorizonActivity.hostingChanged); the world itself runs on the game's server thread.
+ */
+public class HostService extends Service implements Runnable {
+    static final String CHANNEL = "host";
+    static final int ID = 3;
+    /** The running service, for the game to change the code it shows without starting it again. */
+    static volatile HostService running;
+
+    private final Handler handler = new Handler();
+    private PowerManager.WakeLock wake;
+    private WifiManager.WifiLock wifi;
+    private NotificationManager nm;
+    private String code = "";
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
+        if (android.os.Build.VERSION.SDK_INT >= 26) {
+            nm.createNotificationChannel(new NotificationChannel(CHANNEL,
+                    Ui.t("Мир для друзей", "World for friends"), NotificationManager.IMPORTANCE_LOW));
+        }
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        String c = intent != null ? intent.getStringExtra("code") : null;
+        if (c != null) code = c;
+        Notification n = build();
+        if (android.os.Build.VERSION.SDK_INT >= 34) {
+            // specialUse: no daily limit, unlike dataSync on Android 15.
+            startForeground(ID, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE);
+        } else if (android.os.Build.VERSION.SDK_INT >= 29) {
+            startForeground(ID, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC);
+        } else {
+            startForeground(ID, n);
+        }
+        if (wake == null) {
+            wake = ((PowerManager) getSystemService(Context.POWER_SERVICE))
+                    .newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "horizon:host");
+            wake.setReferenceCounted(false);
+            wake.acquire();
+            wifi = ((WifiManager) getApplicationContext().getSystemService(Context.WIFI_SERVICE))
+                    .createWifiLock(WifiManager.WIFI_MODE_FULL_HIGH_PERF, "horizon:host");
+            wifi.setReferenceCounted(false);
+            wifi.acquire();
+        }
+        running = this;
+        handler.removeCallbacks(this);
+        handler.postDelayed(this, 15000);
+        return START_NOT_STICKY;
+    }
+
+    /** From the game, on the main thread: a new code to show. */
+    void update(String c) {
+        code = c;
+        nm.notify(ID, build());
+    }
+
+    private Notification build() {
+        Intent open = new Intent(this, HorizonActivity.class);
+        open.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        PendingIntent pi = PendingIntent.getActivity(this, 0, open, PendingIntent.FLAG_IMMUTABLE);
+        Notification.Builder b = android.os.Build.VERSION.SDK_INT >= 26
+                ? new Notification.Builder(this, CHANNEL) : new Notification.Builder(this);
+        String text = code.isEmpty()
+                ? Ui.t("Друзья могут зайти, пока это уведомление есть.", "Friends can join while this notification is here.")
+                : Ui.t("Код: ", "Code: ") + code;
+        return b.setSmallIcon(android.R.drawable.ic_menu_share)
+                .setContentTitle(Ui.t("Мир открыт для друзей", "World open to friends"))
+                .setContentText(text)
+                .setContentIntent(pi)
+                .setOngoing(true)
+                .setOnlyAlertOnce(true)
+                .build();
+    }
+
+    /** The game removes invite-code.txt when sharing ends: a stop that never came ends it too. */
+    public void run() {
+        if (!new java.io.File(SetupActivity.home(this), "invite-code.txt").isFile()) {
+            stopSelf();
+            return;
+        }
+        handler.postDelayed(this, 15000);
+    }
+
+    @Override
+    public void onDestroy() {
+        if (running == this) running = null;
+        handler.removeCallbacks(this);
+        if (wake != null && wake.isHeld()) wake.release();
+        if (wifi != null && wifi.isHeld()) wifi.release();
+        super.onDestroy();
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+}
