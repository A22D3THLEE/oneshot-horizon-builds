+    /**
+     * Oneshot: other players in a shared game see this skin. The game's network skin share
+     * (android_main.rs) reads files/skin/{skin.png,model.txt,cape.png}, so the picked skin is
+     * copied there. A Mojang-signed textures.signed of an older skin would contradict it: removed.
+     */
+    private void mirrorSkin() {
+        try {
+            File src = new File(dir, "horizon-skin.png");
+            File out = new File(dir, "skin");
+            if (!src.isFile()) return;
+            out.mkdirs();
+            File dst = new File(out, "skin.png");
+            byte[] bytes = Files.readAllBytes(src.toPath());
+            if (!dst.isFile() || !java.util.Arrays.equals(bytes, Files.readAllBytes(dst.toPath()))) {
+                write(dst, bytes);
+                new File(out, "textures.signed").delete();
+            }
+            write(new File(out, "model.txt"), (slim ? "slim\n" : "classic\n").getBytes(StandardCharsets.UTF_8));
+        } catch (Exception ignored) {
+        }
+    }
+
+    /** A cape as the 64x32 RGBA PNG the share sends (an HD cape is scaled down); null when it is no cape. */
+    static byte[] normalizeCape(byte[] bytes) {
+        BitmapFactory.Options o = new BitmapFactory.Options();
+        o.inScaled = false;
+        o.inPremultiplied = false;
+        o.inPreferredConfig = Bitmap.Config.ARGB_8888;
+        Bitmap b = BitmapFactory.decodeByteArray(bytes, 0, bytes.length, o);
+        if (b == null) return null;
+        int w = b.getWidth(), h = b.getHeight();
+        boolean legacy = w == 22 && h == 17;
+        if (!legacy && (w < 64 || w > 1024 || w % 64 != 0 || h * 2 != w)) return null;
+        if (b.getConfig() != Bitmap.Config.ARGB_8888) b = b.copy(Bitmap.Config.ARGB_8888, true);
+        if (!legacy && w != 64) b = Bitmap.createScaledBitmap(b, 64, 32, false);
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        if (!b.compress(Bitmap.CompressFormat.PNG, 100, out)) return null;
+        return out.size() > 8000 ? null : out.toByteArray();
     }
 
