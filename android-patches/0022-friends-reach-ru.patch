+/// Who can join, in the game's language. horizon-friends has no language
+/// table, so its English sentences (`reach::Reach::summary`, the relay-only
+/// one) are matched here and their addresses kept; any other text stays as it is.
+fn localized_summary(summary: &str) -> String {
+    const MAPPED: &str = "Friends anywhere can join: your router opened the port with ";
+    const LOCAL: &str = "Friends on your network or VPN can join. For friends on the internet: turn on UPnP on your router, or forward TCP port ";
+    const LOCAL_END: &str = ", or use a relay, or a VPN";
+    if let Some(rest) = summary.strip_prefix(MAPPED) {
+        let how = rest.strip_suffix('.').unwrap_or(rest);
+        return lang::get_or(
+            "horizon.friends.reach_mapped",
+            "Friends anywhere can join: your router opened the port with %s.",
+        )
+        .replacen("%s", how, 1);
+    }
+    if let Some(port) = summary
+        .strip_prefix("Friends anywhere can join: this computer has a public address (TCP port ")
+        .and_then(|r| r.split_once(' '))
+        .map(|(p, _)| p)
+    {
+        return lang::get_or(
+            "horizon.friends.reach_public",
+            "Friends anywhere can join: this computer has a public address (TCP port %s must not be blocked by a firewall).",
+        )
+        .replacen("%s", port, 1);
+    }
+    if summary.starts_with("Friends on your network or VPN can join. From the internet they can't") {
+        return lang::get_or("horizon.friends.reach_cgnat", summary);
+    }
+    if let Some((target, _)) = summary.strip_prefix(LOCAL).and_then(|r| r.split_once(LOCAL_END)) {
+        return match target.split_once(" to ") {
+            Some((p, ip)) => lang::get_or(
+                "horizon.friends.reach_local_ip",
+                "Friends on your network or VPN can join. For friends on the internet: turn on UPnP on your router, or forward TCP port %s to %s, or use a relay, or a VPN such as Tailscale or ZeroTier (the code already holds your VPN address).",
+            )
+            .replacen("%s", p, 1)
+            .replacen("%s", ip, 1),
+            None => lang::get_or(
+                "horizon.friends.reach_local",
+                "Friends on your network or VPN can join. For friends on the internet: turn on UPnP on your router, or forward TCP port %s, or use a relay, or a VPN such as Tailscale or ZeroTier (the code already holds your VPN address).",
+            )
+            .replacen("%s", target, 1),
+        };
+    }
+    if summary == "Friends join through the relay only." {
+        return lang::get_or("horizon.friends.reach_relay_only", summary);
+    }
+    summary.to_owned()
+}
+
+/// The relay's problem (horizon-friends' "Couldn't reach the relay ADDR: ERROR")
+/// in the game's language; the system's error text stays as it is.
+fn localized_relay_problem(problem: &str) -> String {
+    match problem
+        .strip_prefix("Couldn't reach the relay ")
+        .and_then(|r| r.split_once(": "))
+    {
+        Some((relay, error)) => lang::get_or(
+            "horizon.friends.relay_unreachable",
+            "Couldn't reach the relay %s: %s",
+        )
+        .replacen("%s", relay, 1)
+        .replacen("%s", error, 1),
+        None => problem.to_owned(),
+    }
+}
+
+#[cfg(test)]
+mod localized_tests {
+    use super::*;
+
+    #[test]
+    fn english_summaries_round_trip() {
+        // With no language table loaded, every sentence comes back unchanged.
+        for s in [
+            "Friends anywhere can join: your router opened the port with UPnP (1.2.3.4:25580).",
+            "Friends anywhere can join: this computer has a public address (TCP port 25580 must not be blocked by a firewall).",
+            "Friends on your network or VPN can join. For friends on the internet: turn on UPnP on your router, or forward TCP port 25580 to 10.0.0.2, or use a relay, or a VPN such as Tailscale or ZeroTier (the code already holds your VPN address).",
+            "Friends on your network or VPN can join. For friends on the internet: turn on UPnP on your router, or forward TCP port 25580, or use a relay, or a VPN such as Tailscale or ZeroTier (the code already holds your VPN address).",
+            "Friends join through the relay only.",
+        ] {
+            assert_eq!(localized_summary(s), s);
+        }
+        let p = "Couldn't reach the relay 1.2.3.4:7000: connection refused";
+        assert_eq!(localized_relay_problem(p), p);
+    }
+}
