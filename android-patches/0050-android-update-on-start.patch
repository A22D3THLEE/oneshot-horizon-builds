+    /**
+     * A release's list of changes: the "- " lines of its notes (android.yml writes them under
+     * "Что нового:" from docs/android-changes.md), without the markdown marks.
+     */
+    static List<String> changes(Release r) {
+        List<String> out = new ArrayList<String>();
+        for (String l : r.notes.replace("\r", "").split("\n")) {
+            String t = l.trim();
+            if (!t.startsWith("- ") && !t.startsWith("* ")) continue;
+            t = t.substring(2).replaceAll("[*`]", "").trim();
+            if (!t.isEmpty()) out.add(t);
+        }
+        return out;
+    }
+
+    /** The changes of every release newer than this build, newest first and each once; at most `max`. */
+    static List<String> changesSince(List<Release> all, long mine, int max) {
+        java.util.LinkedHashSet<String> seen = new java.util.LinkedHashSet<String>();
+        for (Release r : all) if (r.code > mine) seen.addAll(changes(r));
+        List<String> out = new ArrayList<String>(seen);
+        if (out.size() > max) {
+            int more = out.size() - (max - 1);
+            out = new ArrayList<String>(out.subList(0, max - 1));
+            out.add(Ui.t("…и ещё " + more, "…and " + more + " more"));
+        }
+        return out;
+    }
