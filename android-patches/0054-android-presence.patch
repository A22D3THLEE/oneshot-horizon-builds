+/// The longest presence blob the relay keeps (hex digits).
+pub const MAX_PRESENCE_BLOB: usize = 112;
+
+/// What a host's friends may learn while it shares: `id` is derived from its
+/// code, so only those who know the code can ask for it, and `blob` (the
+/// world's name) is sealed with the code too. The relay keeps both as opaque
+/// strings and never needs the code.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Presence {
+    pub id: String,
+    pub blob: String,
+}
+impl Presence {
+    /// The shape the relay keeps: a valid id, and lowercase hex of even
+    /// length at most [`MAX_PRESENCE_BLOB`] for the blob.
+    pub fn valid(&self) -> bool {
+        valid_presence_id(&self.id)
+            && self.blob.len() <= MAX_PRESENCE_BLOB
+            && self.blob.len() % 2 == 0
+            && self.blob.bytes().all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f'))
+    }
+}
+/// A presence id: 32 lowercase hex digits.
+pub fn valid_presence_id(id: &str) -> bool {
+    id.len() == 32 && id.bytes().all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f'))
+}
 
