+    private static String lastError;
+    /** A relay that answered bad_request predates the query: it isn't asked again for a while. */
+    private static long quietUntil;
+    private static final boolean WORKS = selfTest();
+
+    private FriendsPresence() {}
+
+    private static byte[] hmac(byte[] key, byte[] message) {
+        try {
+            Mac m = Mac.getInstance("HmacSHA256");
+            m.init(new SecretKeySpec(key, "HmacSHA256"));
+            return m.doFinal(message);
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    /** HKDF-Expand's first block: HMAC(key, message || 0x01). */
+    private static byte[] prf(byte[] key, byte[]... parts) {
+        ByteArrayOutputStream m = new ByteArrayOutputStream();
+        for (byte[] p : parts) m.write(p, 0, p.length);
+        m.write(1);
+        return hmac(key, m.toByteArray());
+    }
+
+    private static byte[] a(String s) {
+        return s.getBytes(StandardCharsets.US_ASCII);
+    }
+
+    private static String hex(byte[] b, int count) {
+        StringBuilder s = new StringBuilder(count * 2);
+        for (int i = 0; i < count; i++) s.append(String.format("%02x", b[i] & 0xff));
+        return s.toString();
+    }
+
+    private static byte[] unhex(String s) {
+        if (s == null || s.length() % 2 != 0) return null;
+        byte[] b = new byte[s.length() / 2];
+        for (int i = 0; i < b.length; i++) {
+            int hi = Character.digit(s.charAt(2 * i), 16), lo = Character.digit(s.charAt(2 * i + 1), 16);
+            if (hi < 0 || lo < 0 || Character.isUpperCase(s.charAt(2 * i)) || Character.isUpperCase(s.charAt(2 * i + 1))) return null;
+            b[i] = (byte) (hi * 16 + lo);
+        }
+        return b;
+    }
+
+    private static byte[] prk(String nameplate, String secret) {
+        return hmac(SALT, a((nameplate + secret).toUpperCase(java.util.Locale.ROOT)));
+    }
+
+    static String id(String nameplate, String secret) {
+        return hex(prf(prk(nameplate, secret), a("id")), 16);
+    }
+
+    /** The world's name in a friend's presence; null if it isn't theirs or was altered. */
+    static String open(String nameplate, String secret, String blob) {
+        byte[] key = prf(prk(nameplate, secret), a("seal"));
+        byte[] b = unhex(blob);
+        if (b == null || b.length < 16 || b.length > 48) return null;
+        byte[] nonce = Arrays.copyOfRange(b, 0, 8), tag = Arrays.copyOfRange(b, 8, 16), ct = Arrays.copyOfRange(b, 16, b.length);
+        if (!java.security.MessageDigest.isEqual(Arrays.copyOf(prf(key, a("tag"), nonce, ct), 8), tag)) return null;
+        byte[] ks = prf(key, a("ks"), nonce);
+        for (int i = 0; i < ct.length; i++) ct[i] ^= ks[i];
+        try {
+            return StandardCharsets.UTF_8.newDecoder().onMalformedInput(CodingErrorAction.REPORT)
+                    .onUnmappableCharacter(CodingErrorAction.REPORT).decode(ByteBuffer.wrap(ct)).toString();
+        } catch (CharacterCodingException e) {
+            return null;
+        }
+    }
+
+    /** The game's own vector (presence.rs launcher_vector): a launcher that reads it wrong asks nothing. */
+    private static boolean selfTest() {
+        try {
+            String blob = "00010203040506072d40854bcb3c215b22efe8a6dc";
+            boolean ok = id("k7qm", "x2pa").equals("3f9a99ded828d80b83492609f4d66733") && "World".equals(open("K7QM", "X2PA", blob))
+                    && open("K7QM", "X2PB", blob) == null;
+            if (!ok) android.util.Log.w("Horizon", "friends presence: self-test failed, online friends are not shown");
+            return ok;
+        } catch (Throwable e) {
+            android.util.Log.w("Horizon", "friends presence: " + e);
+            return false;
+        }
+    }
+
+    /** The friend's world while they share one ("" if its name can't be read), null while they don't. */
+    static String world(FriendsBook.Friend f) {
+        if (f == null || f.stale) return null;
+        String blob;
+        synchronized (GATE) {
+            blob = online.get(f.presenceId());
+            Long at = ANSWERED.get(f.presenceId());
+            if (at == null || System.currentTimeMillis() - at > STALE_MS) blob = null;
+        }
+        if (blob == null) return null;
+        String name = f.openWorld(blob);
+        if (name == null) return "";
+        StringBuilder b = new StringBuilder();
+        for (int i = 0; i < name.length(); i++) if (!Character.isISOControl(name.charAt(i))) b.append(name.charAt(i));
+        return b.toString().trim();
+    }
+
+    /**
+     * Ask the relay about these friends (the most recent first, at most 16) unless an answer for them is fresh;
+     * `changed` runs on the UI thread when the answer differs from the last.
+     */
+    static void ask(final android.app.Activity a, List<FriendsBook.Friend> friends, final Runnable changed) {
+        if (!WORKS) return;
+        final List<String> ids = new ArrayList<>();
+        for (FriendsBook.Friend f : friends) {
+            if (f.stale || ids.contains(f.presenceId())) continue;
+            ids.add(f.presenceId());
+            if (ids.size() == MAX_IDS) break;
+        }
+        if (ids.isEmpty()) return;
+        final String relay = Net.relay(a);
+        String key = relay + "|" + android.text.TextUtils.join(",", ids);
+        synchronized (GATE) {
+            long now = System.currentTimeMillis();
+            if (busy || now < quietUntil || (key.equals(askedKey) && now - askedAt < FRESH_MS)) return;
+            busy = true;
+            askedKey = key;
+            askedAt = now;
+        }
+        new Thread(new Runnable() {
+            public void run() {
+                Map<String, String> found = new HashMap<>();
+                try {
+                    // An empty relay.txt turns the server off: then no one is shown online.
+                    if (!relay.isEmpty()) found = fetch(relay, ids);
+                    lastError = null;
+                } catch (Exception e) {
+                    // Unreachable relay, or one that predates the query: no one is shown online (logged once).
+                    String m = String.valueOf(e.getMessage());
+                    if (!m.equals(lastError)) android.util.Log.i("Horizon", "friends presence: " + m);
+                    lastError = m;
+                    if (m.endsWith("bad_request")) {
+                        synchronized (GATE) {
+                            quietUntil = System.currentTimeMillis() + 10 * 60 * 1000L;
+                        }
+                    }
+                }
+                boolean differs;
+                synchronized (GATE) {
+                    // Only the friends asked about change: another list may have asked about others.
+                    Map<String, String> next = new HashMap<>(online);
+                    long now = System.currentTimeMillis();
+                    for (String id : ids) {
+                        next.remove(id);
+                        ANSWERED.put(id, now);
+                    }
+                    next.putAll(found);
+                    differs = !next.equals(online);
+                    online = next;
+                    busy = false;
+                }
+                if (differs && changed != null) a.runOnUiThread(changed);
+            }
+        }, "friends-presence").start();
+    }
+
+    private static Map<String, String> fetch(String relay, List<String> ids) throws Exception {
+        int colon = relay.lastIndexOf(':');
+        if (colon <= 0) throw new java.io.IOException("no relay port");
+        String host = relay.substring(0, colon);
+        if (host.startsWith("[") && host.endsWith("]")) host = host.substring(1, host.length() - 1);
+        int port = Integer.parseInt(relay.substring(colon + 1).trim());
+        try (Socket s = new Socket()) {
+            s.connect(new InetSocketAddress(host, port), TIMEOUT_MS);
+            s.setSoTimeout(TIMEOUT_MS);
+            JSONObject ask = new JSONObject();
+            ask.put("op", "online");
+            ask.put("v", 1);
+            ask.put("ids", new JSONArray(ids));
+            OutputStream out = s.getOutputStream();
+            out.write((ask.toString() + "\n").getBytes(StandardCharsets.UTF_8));
+            out.flush();
+            InputStream in = s.getInputStream();
+            ByteArrayOutputStream line = new ByteArrayOutputStream();
+            int c;
+            while ((c = in.read()) >= 0 && c != '\n') {
+                line.write(c);
+                if (line.size() > 8192) throw new java.io.IOException("answer too long");
+            }
+            JSONObject reply = new JSONObject(new String(line.toByteArray(), StandardCharsets.UTF_8));
+            String op = reply.optString("op");
+            if (!op.equals("online")) throw new java.io.IOException("relay answered " + reply.optString("code", op));
+            Map<String, String> result = new HashMap<>();
+            JSONArray list = reply.optJSONArray("friends");
+            for (int i = 0; list != null && i < list.length(); i++) {
+                JSONObject p = list.optJSONObject(i);
+                if (p == null) continue;
+                String id = p.optString("id", null), blob = p.optString("blob", null);
+                if (id != null && blob != null && ids.contains(id)) result.put(id, blob);
+            }
+            return result;
+        }
+    }
+}
