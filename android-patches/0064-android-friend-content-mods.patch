index 0000000..b40dc41
--- /dev/null
+++ b/packaging/android/java/dev/horizonlab/horizon/HostMods.java
@@ -0,0 +1,281 @@
+package dev.horizonlab.horizon;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * OneShot: a friend's content mods. Mods only run on the PC; what works everywhere is content (.hmod: blocks, items,
+ * recipes, textures). A host with content mods on lets in only a game with the same ones (horizon:mod_list), so the
+ * game writes what the last server had on to server-mods.txt (android-patches/0064: id, version and SHA-256, a tab
+ * between). After the game, the Home page compares it with horizon-mods/: the ones this phone lacks are fetched from
+ * Horizon's registry by their SHA-256 and turned on, its own ones the host lacks are turned off, and the player joins
+ * again. A mod that is not in the registry can't be fetched: the page names it.
+ */
+final class HostMods {
+    static final String FILE = "server-mods.txt";
+    private static final String SEEN = "server-mods-seen.txt";
+    private static final String REGISTRY = "https://horizon-rust.github.io/horizon-mods/index.json";
+    private static final String GAME_VERSION = "26.3";
+    private static final long MAX_BYTES = 64L << 20;
+
+    private HostMods() {}
+
+    /** One mod of the host's list. */
+    static final class Mod {
+        String id, version, sha;
+
+        String label() {
+            return id + " " + version;
+        }
+    }
+
+    /** One .hmod in horizon-mods/: its manifest's id and side, and its file's SHA-256. */
+    private static final class Local {
+        File file;
+        String id, sha;
+        boolean both;
+    }
+
+    /** What to do so this phone joins the host: fetch, turn on, turn off. */
+    static final class Plan {
+        final List<Mod> fetch = new ArrayList<Mod>();
+        final List<String> turnOn = new ArrayList<String>();
+        final List<String> turnOff = new ArrayList<String>();
+        final List<Mod> host = new ArrayList<Mod>();
+        long stamp;
+
+        boolean empty() {
+            return fetch.isEmpty() && turnOn.isEmpty() && turnOff.isEmpty();
+        }
+    }
+
+    /** The plan for the last server joined, or null: none written, nothing to change, or the player hid it. */
+    static Plan plan(File home) {
+        File f = new File(home, FILE);
+        if (!f.isFile()) return null;
+        long stamp = f.lastModified();
+        if (String.valueOf(stamp).equals(read(new File(home, SEEN)).trim())) return null;
+        Plan p = new Plan();
+        p.stamp = stamp;
+        for (String line : read(f).split("\n")) {
+            String[] parts = line.split("\t", -1);
+            if (parts.length < 3 || !parts[0].matches("[a-z0-9_]{1,64}")) continue;
+            Mod m = new Mod();
+            m.id = parts[0];
+            m.version = parts[1].length() > 40 ? parts[1].substring(0, 40) : parts[1];
+            m.sha = parts[2].trim().toLowerCase(Locale.ROOT);
+            p.host.add(m);
+        }
+        Map<String, Boolean> on = switches(home);
+        List<Local> mine = locals(home);
+        for (Mod m : p.host) {
+            Local same = null;
+            for (Local l : mine) {
+                if (l.id.equals(m.id) && (m.sha.isEmpty() || m.sha.equals(l.sha))) same = l;
+            }
+            if (same == null) p.fetch.add(m);
+            else if (!Boolean.TRUE.equals(on.get(m.id))) p.turnOn.add(m.id);
+        }
+        for (Local l : mine) {
+            if (!l.both || !Boolean.TRUE.equals(on.get(l.id))) continue;
+            boolean hosted = false;
+            for (Mod m : p.host) hosted |= m.id.equals(l.id);
+            if (!hosted && !p.turnOff.contains(l.id)) p.turnOff.add(l.id);
+        }
+        return p.empty() ? null : p;
+    }
+
+    /** The player hid this list: it stays hidden until the game writes another. */
+    static void hide(File home, Plan p) {
+        try {
+            Files.write(new File(home, SEEN).toPath(), String.valueOf(p.stamp).getBytes(StandardCharsets.UTF_8));
+        } catch (Exception ignored) {
+        }
+    }
+
+    /**
+     * Carries the plan out: fetches each missing mod from the registry by its SHA-256 (another file of the same id
+     * is set aside as .hmod.off), turns the host's on and the others off. Returns the mods it could not fetch.
+     */
+    static List<Mod> apply(File home, Plan p) throws Exception {
+        List<Mod> left = new ArrayList<Mod>();
+        File dir = new File(home, "horizon-mods");
+        dir.mkdirs();
+        JSONObject root = p.fetch.isEmpty() ? null : new JSONObject(new String(get(REGISTRY), StandardCharsets.UTF_8));
+        for (Mod m : p.fetch) {
+            String url = find(root, m);
+            if (url == null) {
+                left.add(m);
+                continue;
+            }
+            byte[] data = get(url);
+            if (!m.sha.isEmpty() && !m.sha.equals(sha256(data))) {
+                left.add(m);
+                continue;
+            }
+            for (Local l : locals(home)) {
+                if (l.id.equals(m.id)) l.file.renameTo(new File(l.file.getPath() + ".off"));
+            }
+            File part = new File(dir, m.id + ".hmod.part");
+            Files.write(part.toPath(), data);
+            File to = new File(dir, m.id + ".hmod");
+            if (to.exists() && !to.delete()) throw new java.io.IOException("cannot replace " + to.getName());
+            if (!part.renameTo(to)) throw new java.io.IOException("cannot write " + to.getName());
+            setSwitch(home, m.id, true);
+        }
+        for (String id : p.turnOn) setSwitch(home, id, true);
+        for (String id : p.turnOff) setSwitch(home, id, false);
+        return left;
+    }
+
+    /** The registry's file of this mod with this SHA-256 (any version), else, without a hash, its 26.3 version. */
+    private static String find(JSONObject root, Mod m) {
+        JSONArray projects = root == null ? null : root.optJSONArray("projects");
+        for (int i = 0; projects != null && i < projects.length(); i++) {
+            JSONObject pr = projects.optJSONObject(i);
+            if (pr == null || !"mod".equals(pr.optString("kind"))) continue;
+            JSONArray vs = pr.optJSONArray("versions");
+            for (int j = 0; vs != null && j < vs.length(); j++) {
+                JSONObject v = vs.optJSONObject(j);
+                JSONObject f = v == null ? null : v.optJSONObject("file");
+                if (f == null) continue;
+                String sha = f.optString("sha256").toLowerCase(Locale.ROOT);
+                boolean match = m.sha.isEmpty()
+                        ? m.id.equals(pr.optString("id")) && GAME_VERSION.equals(v.optString("game"))
+                        : m.sha.equals(sha);
+                if (match && f.optString("url").startsWith("https://")) return f.optString("url");
+            }
+        }
+        return null;
+    }
+
+    /** horizon-mods.txt: mod.<id>:true|false. */
+    private static Map<String, Boolean> switches(File home) {
+        Map<String, Boolean> on = new LinkedHashMap<String, Boolean>();
+        for (String line : read(new File(home, "horizon-mods.txt")).split("\n")) {
+            String t = line.trim();
+            int colon = t.lastIndexOf(':');
+            if (!t.startsWith("mod.") || colon < 5) continue;
+            on.put(t.substring(4, colon), "true".equals(t.substring(colon + 1).trim()));
+        }
+        return on;
+    }
+
+    private static void setSwitch(File home, String id, boolean on) throws Exception {
+        File list = new File(home, "horizon-mods.txt");
+        StringBuilder text = new StringBuilder("mod." + id + ":" + on + "\n");
+        for (String line : read(list).split("\n")) {
+            String t = line.trim();
+            if (t.isEmpty() || t.startsWith("mod." + id + ":")) continue;
+            text.append(t).append('\n');
+        }
+        File part = new File(home, "horizon-mods.txt.part");
+        Files.write(part.toPath(), text.toString().getBytes(StandardCharsets.UTF_8));
+        if (list.exists() && !list.delete()) throw new java.io.IOException("cannot replace horizon-mods.txt");
+        if (!part.renameTo(list)) throw new java.io.IOException("cannot write horizon-mods.txt");
+    }
+
+    private static final Pattern ID = Pattern.compile("(?m)^\\s*id\\s*=\\s*\"([a-z0-9_]+)\"");
+    private static final Pattern SIDE = Pattern.compile("(?m)^\\s*side\\s*=\\s*\"(\\w+)\"");
+
+    private static List<Local> locals(File home) {
+        List<Local> out = new ArrayList<Local>();
+        File[] files = new File(home, "horizon-mods").listFiles();
+        if (files == null) return out;
+        for (File f : files) {
+            if (!f.isFile() || !f.getName().toLowerCase(Locale.ROOT).endsWith(".hmod")) continue;
+            try (ZipFile z = new ZipFile(f)) {
+                ZipEntry e = z.getEntry("horizon-mod.toml");
+                if (e == null) continue;
+                String toml = new String(readAll(z.getInputStream(e), 1 << 20), StandardCharsets.UTF_8);
+                Matcher id = ID.matcher(toml);
+                if (!id.find()) continue;
+                Matcher side = SIDE.matcher(toml);
+                Local l = new Local();
+                l.file = f;
+                l.id = id.group(1);
+                l.both = side.find() && "both".equals(side.group(1));
+                try (InputStream in = new FileInputStream(f)) {
+                    l.sha = sha256(readAll(in, MAX_BYTES));
+                }
+                out.add(l);
+            } catch (Exception ignored) {
+                // Not a mod the game would load either.
+            }
+        }
+        return out;
+    }
+
+    private static String read(File f) {
+        try {
+            return f.isFile() ? new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8) : "";
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    private static byte[] readAll(InputStream in, long max) throws Exception {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        byte[] buf = new byte[1 << 16];
+        long total = 0;
+        for (int n; (n = in.read(buf)) > 0; ) {
+            total += n;
+            if (total > max) throw new java.io.IOException("too big");
+            out.write(buf, 0, n);
+        }
+        return out.toByteArray();
+    }
+
+    private static String sha256(byte[] data) throws Exception {
+        byte[] d = MessageDigest.getInstance("SHA-256").digest(data);
+        StringBuilder hex = new StringBuilder();
+        for (byte b : d) hex.append(String.format(Locale.ROOT, "%02x", b));
+        return hex.toString();
+    }
+
+    /** An https GET, following up to 5 https redirects by hand. */
+    private static byte[] get(String url) throws Exception {
+        for (int i = 0; i < 5; i++) {
+            if (!url.startsWith("https://")) throw new java.io.IOException("not https: " + url);
+            HttpURLConnection c = (HttpURLConnection) new URL(url).openConnection();
+            c.setInstanceFollowRedirects(false);
+            c.setConnectTimeout(15000);
+            c.setReadTimeout(30000);
+            c.setRequestProperty("User-Agent", "OneShot-Android/1.0");
+            try {
+                int code = c.getResponseCode();
+                if (code / 100 == 3) {
+                    url = new URL(new URL(url), c.getHeaderField("Location")).toString();
+                    continue;
+                }
+                if (code != 200) throw new java.io.IOException("HTTP " + code);
+                try (InputStream in = c.getInputStream()) {
+                    return readAll(in, MAX_BYTES);
+                }
+            } finally {
+                c.disconnect();
+            }
+        }
+        throw new java.io.IOException("too many redirects");
+    }
+}
