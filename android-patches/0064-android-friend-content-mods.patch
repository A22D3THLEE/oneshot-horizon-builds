+/// OneShot for Android: the content mods the server last joined has on, beside the game (its working directory),
+/// one a line: id, version and the SHA-256 of its file in hex (empty for a folder mod), tab-separated. The launcher
+/// reads it after the game, fetches the ones this game lacks from Horizon's registry and turns them on, so a phone
+/// joins a PC host that plays with content mods.
+const SERVER_MODS: &str = "server-mods.txt";
+
+fn remember_server_mods(data: &[u8]) {
+    let Ok(entries) = horizon_protocol::mod_list::decode(data) else {
+        return;
+    };
+    let clean = |s: &str| s.chars().filter(|c| !c.is_control()).collect::<String>();
+    let mut text = String::new();
+    for e in entries {
+        let sha = e
+            .sha256
+            .map(|h| h.iter().map(|b| format!("{b:02x}")).collect::<String>())
+            .unwrap_or_default();
+        text.push_str(&format!("{}\t{}\t{}\n", clean(&e.id), clean(&e.version), sha));
+    }
+    let _ = std::fs::write(SERVER_MODS, text);
+}
