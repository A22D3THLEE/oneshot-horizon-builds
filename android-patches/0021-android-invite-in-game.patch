+/// Send the invite code (`HorizonActivity.shareInvite`): Android's clipboard gets
+/// `friend:CODE` and the share sheet opens with the join link.
+pub(super) fn share_invite(code: &str) {
+    let Some(app) = super::ANDROID_APP.get() else {
+        return;
+    };
+    // SAFETY: as in `show`.
+    let result = (|| -> jni::errors::Result<()> {
+        let vm = unsafe { jni::JavaVM::from_raw(app.vm_as_ptr().cast())? };
+        let mut env = vm.attach_current_thread_permanently()?;
+        let activity = unsafe { jni::objects::JObject::from_raw(app.activity_as_ptr().cast()) };
+        let code = env.new_string(code)?;
+        env.call_method(&activity, "shareInvite", "(Ljava/lang/String;)V", &[jni::objects::JValue::Object(&code)])?;
+        Ok(())
+    })();
+    if let Err(e) = result {
+        log::warn!("Horizon: share the invite: {e}");
+    }
+}
