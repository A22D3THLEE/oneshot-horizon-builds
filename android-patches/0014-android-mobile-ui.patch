+    /**
+     * Keeps a screen's content clear of the display cutout, the system bars and the keyboard
+     * (the window draws edge to edge on Android 15+): the view's own padding plus the insets.
+     */
+    static void fitInsets(final View v) {
+        final int l = v.getPaddingLeft(), t = v.getPaddingTop(), r = v.getPaddingRight(), b = v.getPaddingBottom();
+        v.setOnApplyWindowInsetsListener(new View.OnApplyWindowInsetsListener() {
+            public android.view.WindowInsets onApplyWindowInsets(View view, android.view.WindowInsets in) {
+                int il, it, ir, ib;
+                if (android.os.Build.VERSION.SDK_INT >= 30) {
+                    android.graphics.Insets s = in.getInsets(android.view.WindowInsets.Type.systemBars()
+                            | android.view.WindowInsets.Type.displayCutout() | android.view.WindowInsets.Type.ime());
+                    il = s.left;
+                    it = s.top;
+                    ir = s.right;
+                    ib = s.bottom;
+                } else {
+                    il = in.getSystemWindowInsetLeft();
+                    it = in.getSystemWindowInsetTop();
+                    ir = in.getSystemWindowInsetRight();
+                    ib = in.getSystemWindowInsetBottom();
+                }
+                view.setPadding(l + il, t + it, r + ir, b + ib);
+                return in;
+            }
+        });
+        v.requestApplyInsets();
+    }
