diff --git a/packaging/android/java/dev/horizonlab/horizon/Ui.java b/packaging/android/java/dev/horizonlab/horizon/Ui.java
index 50c3e10b..79185f85 100644
--- a/packaging/android/java/dev/horizonlab/horizon/Ui.java
+++ b/packaging/android/java/dev/horizonlab/horizon/Ui.java
@@ -139,6 +139,37 @@ final class Ui {
         return (int) (m.heightPixels / m.density);
     }
 
+    /**
+     * A phone in landscape (about 360-420 dp high): the screens drop what they can spare
+     * and let headers scroll away instead of keeping them fixed.
+     */
+    static boolean shortScreen(Context c) {
+        return heightDp(c) < 480;
+    }
+
+    /**
+     * A sideways-scrolling row whose ends fade out where more is hidden: on a narrow
+     * screen the last chips are cut off, and without the fade nothing tells that it scrolls.
+     */
+    static android.widget.HorizontalScrollView hscroll(Context c) {
+        android.widget.HorizontalScrollView h = new android.widget.HorizontalScrollView(c);
+        h.setHorizontalScrollBarEnabled(false);
+        h.setHorizontalFadingEdgeEnabled(true);
+        h.setFadingEdgeLength(dp(c, 36));
+        return h;
+    }
+
+    /** The launcher's screens are full-screen like the game: the bars come back on a swipe. */
+    static void hideBars(android.app.Activity a) {
+        if (android.os.Build.VERSION.SDK_INT >= 30) {
+            android.view.WindowInsetsController c = a.getWindow().getInsetsController();
+            if (c != null) {
+                c.hide(android.view.WindowInsets.Type.systemBars());
+                c.setSystemBarsBehavior(android.view.WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE);
+            }
+        }
+    }
+
     /** A full-screen background with a centered card; returns the card to fill. */
     static LinearLayout card(android.app.Activity a) {
         FrameLayout root = new FrameLayout(a);
