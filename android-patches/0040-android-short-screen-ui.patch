+    /** Each tab as tall as `height` allows for all of them: 44 dp at most, 32 dp at least. */
+    private void fitTabs(View scroll, int height) {
+        int gap = Ui.dp(this, 2);
+        int each = (height - gap * (tabs.length - 1)) / tabs.length;
+        final int h = Math.max(Ui.dp(this, 32), Math.min(Ui.dp(this, 44), each));
+        if (tabs[0].getMinHeight() == h) return;
+        // Not inside the layout pass that reported the size.
+        scroll.post(new Runnable() {
+            public void run() {
+                for (TextView t : tabs) t.setMinHeight(h);
             }
-        }
+        });
     }
 
     String readName() {
