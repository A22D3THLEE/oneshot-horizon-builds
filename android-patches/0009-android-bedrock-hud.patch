+
+/// A circle outline `t` thick, out to radius `r` about `c`.
+fn ring(batch: &mut HudBatch, atlas: &HudAtlas, c: [f32; 2], r: f32, t: f32, color: u32) {
+    let k = batch.scale.max(1.0);
+    let n = (r * k).round().max(1.0);
+    let inner = (n - (t * k).round().max(1.0)).max(0.0);
+    let (cx, cy) = ((c[0] * k).round(), (c[1] * k).round());
+    let mut i = -(n as i32);
+    while i < n as i32 {
+        let dy = i as f32 + 0.5;
+        let out = (n * n - dy * dy).max(0.0).sqrt().round();
+        let inn = if dy.abs() < inner { (inner * inner - dy * dy).max(0.0).sqrt().round() } else { 0.0 };
+        let y = (cy + i as f32) / k;
+        if out >= 1.0 {
+            if inn >= 1.0 {
+                batch.fill(atlas, (cx - out) / k, y, (out - inn) / k, 1.0 / k, color);
+                batch.fill(atlas, (cx + inn) / k, y, (out - inn) / k, 1.0 / k, color);
+            } else {
+                batch.fill(atlas, (cx - out) / k, y, out * 2.0 / k, 1.0 / k, color);
+            }
+        }
+        i += 1;
+    }
+}
