+    /**
+     * The team's HD skins. Each entry names a PNG beside the index and its SHA-256, checked when it
+     * is worn. No index yet (404): an empty list, not an error.
+     */
+    private void hdSkins(String q, List<Item> out) throws Exception {
+        String body = getString(HD_BASE + "index.json").trim();
+        if (body.isEmpty()) return;
+        JSONObject root = new JSONObject(body);
+        if (root.optInt("schema") > 1) throw new Exception(Ui.t("Каталог новее лаунчера", "The catalog is newer than this app"));
+        JSONArray arr = root.optJSONArray("skins");
+        for (int i = 0; arr != null && i < arr.length(); i++) {
+            JSONObject s = arr.optJSONObject(i);
+            if (s == null) continue;
+            String file = str(s, "file"), sha = str(s, "sha256").toLowerCase(Locale.ROOT);
+            if (!file.matches("[A-Za-z0-9_-]{1,64}\\.png") || !sha.matches("[0-9a-f]{64}")) continue;
+            Item it = new Item();
+            it.hd = true;
+            it.id = file;
+            it.title = str(s, "name").isEmpty() ? file.substring(0, file.length() - 4) : str(s, "name");
+            String author = str(s, "author");
+            if (!q.isEmpty() && !(it.title + " " + author).toLowerCase(Locale.ROOT).contains(q.toLowerCase(Locale.ROOT))) continue;
+            it.picture = HD_BASE + file;
+            it.hash = sha;
+            it.hashKind = "SHA-256";
+            String model = str(s, "model");
+            if (model.equals("slim") || model.equals("classic")) {
+                it.hasSlim = true;
+                it.slim = model.equals("slim");
+            }
+            out.add(it);
+        }
+    }
+
