+/**
+ * Oneshot: the app's versions, as the PC launcher has them. The builds repository publishes every
+ * signed APK as a release tagged android-<versionCode> (android.yml); this screen lists them and
+ * installs a newer one over this one with the system installer, keeping the worlds and settings.
+ * Android does not install an older versionCode over a newer one, so older builds are listed
+ * but cannot be installed from here.
+ */
+public class UpdateActivity extends Activity {
+    static final String REPO = "A22D3THLEE/oneshot-horizon-builds";
+    private static final String API = "https://api.github.com/repos/" + REPO + "/releases?per_page=100";
+    private static final long CACHE_MS = 10 * 60 * 1000L;
+    private static final Pattern TAG = Pattern.compile("^android-(\\d+)$");
+    private static final String STATUS = "dev.horizonlab.horizon.INSTALL_STATUS";
+
+    static final class Release {
+        long code;
+        String name = "", date = "", apk = "", sha = "", notes = "";
+        long size;
+    }
+
+    private final Handler handler = new Handler();
+    private LinearLayout list;
+    private TextView status;
+    private Ui.Bar bar;
+    private volatile boolean busy;
+
+    @Override
+    protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setBackgroundColor(Ui.BG);
+        int pad = Ui.dp(this, 16);
+        root.setPadding(pad, pad, pad, pad);
+
+        LinearLayout head = new LinearLayout(this);
+        head.setOrientation(LinearLayout.HORIZONTAL);
+        head.setGravity(Gravity.CENTER_VERTICAL);
+        Button back = Ui.button(this, "←", false);
+        back.setOnClickListener(new View.OnClickListener() {
+            public void onClick(View v) {
+                finish();
