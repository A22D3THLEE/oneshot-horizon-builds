+    /**
+     * Oneshot: the screen and memory the game picks its first-start settings
+     * from (device.txt next to options.txt; settings.rs DeviceProfile). Only the
+     * first start of a new player uses it; later the player's own settings stay.
+     */
+    static void writeDevice(android.app.Activity a) {
+        try {
+            StringBuilder b = new StringBuilder();
+            android.view.Display d = a.getWindowManager().getDefaultDisplay();
+            android.util.DisplayMetrics m = new android.util.DisplayMetrics();
+            d.getRealMetrics(m);
+            float hz = d.getRefreshRate();
+            for (android.view.Display.Mode mode : d.getSupportedModes()) {
+                hz = Math.max(hz, mode.getRefreshRate());
+            }
+            b.append("width=").append(m.widthPixels).append('\n');
+            b.append("height=").append(m.heightPixels).append('\n');
+            b.append("dpi=").append(m.densityDpi).append('\n');
+            b.append("refresh=").append(hz).append('\n');
+            android.app.ActivityManager am = (android.app.ActivityManager) a.getSystemService(Context.ACTIVITY_SERVICE);
+            if (am != null) {
+                android.app.ActivityManager.MemoryInfo mi = new android.app.ActivityManager.MemoryInfo();
+                am.getMemoryInfo(mi);
+                b.append("ram_mb=").append(mi.totalMem / (1024 * 1024)).append('\n');
+                b.append("low_ram=").append(am.isLowRamDevice() ? 1 : 0).append('\n');
+            }
+            java.io.File home = new java.io.File(SetupActivity.home(a));
+            java.nio.file.Files.write(new java.io.File(home, "device.txt").toPath(),
+                    b.toString().getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        } catch (Throwable t) {
+            android.util.Log.w("Horizon", "device.txt: " + t);
+        }
+    }
+
     static class Toggle implements Runnable {
         private final HorizonActivity a;
         private final boolean show;
