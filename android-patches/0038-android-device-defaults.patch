+        assert_eq!(s.apply_device(&tablet), DeviceTier::Flagship);
+        assert_eq!((s.render_distance, s.simulation_distance, s.max_fps), (12, 8, 120));
+        assert_eq!(s.horizon.resolution_scale, 80);
+        assert_eq!(s.horizon.workers, 0);
