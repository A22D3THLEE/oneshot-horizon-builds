+        assert_eq!((low.render_distance, low.simulation_distance, low.max_fps), (6, 5, 60));
+        assert_eq!(low.horizon.resolution_scale, 100);
+        assert_eq!(low.horizon.workers, 2);
+        // Round trip: the saved options.txt reads back the same distances and cap.
