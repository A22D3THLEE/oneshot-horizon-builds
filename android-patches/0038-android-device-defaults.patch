+
+/// The mark that the first start's device settings were decided for a player folder.
+pub const DEVICE_MARK: &str = "horizon-device-defaults.txt";
+
+/// A new player: options.txt holds no game options yet (the launcher may have
+/// written only the resource packs there) and no Horizon file was written.
+#[cfg(target_os = "android")]
+fn fresh_player(path: &Path) -> bool {
+    let Some(dir) = path.parent() else {
+        return false;
+    };
+    let options = fs::read_to_string(path).unwrap_or_default();
+    !options.lines().any(|l| l.starts_with("renderDistance:"))
+        && !dir.join("horizon-autojump.txt").exists()
+        && !dir.join(crate::graphics::FILE).exists()
+}
+
+/// The fastest core's top clock in kHz (cpufreq), 0 when it can't be read.
+#[cfg(target_os = "android")]
+fn max_cpu_khz() -> u64 {
+    (0..64)
+        .filter_map(|i| {
+            fs::read_to_string(format!("/sys/devices/system/cpu/cpu{i}/cpufreq/cpuinfo_max_freq")).ok()
+        })
+        .filter_map(|t| t.trim().parse::<u64>().ok())
+        .max()
+        .unwrap_or(0)
+}
+
+/// How much the first start's settings ask of the phone.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DeviceTier {
+    Low,
+    Mid,
+    High,
+    Flagship,
+}
+
+/// What the first start's settings are picked from: the screen and memory the
+/// activity writes to device.txt, and the CPU's top clock. 0 is unknown.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct DeviceProfile {
+    pub width: u32,
+    pub height: u32,
+    pub refresh_hz: u32,
+    pub ram_mb: u64,
+    pub low_ram: bool,
+    pub max_cpu_khz: u64,
+}
+
+impl DeviceProfile {
+    /// `key=value` lines; unknown keys and bad numbers are skipped.
+    pub fn parse(text: &str) -> Self {
+        let mut d = Self::default();
+        for line in text.lines() {
+            let Some((key, value)) = line.split_once('=') else {
+                continue;
+            };
+            let value = value.trim();
+            match key.trim() {
+                "width" => d.width = value.parse().unwrap_or(0),
+                "height" => d.height = value.parse().unwrap_or(0),
+                "refresh" => d.refresh_hz = value.parse::<f32>().map_or(0, |v| v.round() as u32),
+                "ram_mb" => d.ram_mb = value.parse().unwrap_or(0),
+                "low_ram" => d.low_ram = value == "1" || value == "true",
+                _ => {}
+            }
+        }
+        d
+    }
+    /// By memory first (what a phone reports is a little under its label: 12 GB
+    /// is about 11 200 MB), then by the top CPU clock when it is known. Nothing
+    /// known at all is Mid. 2.2 GHz chips (Snapdragon 695 / 6 Gen 1, Helio G99,
+    /// Dimensity 700) are Mid however much memory they have: a Redmi on an SD695
+    /// with 8 GB held about 30 FPS at render distance 12, the Adreno 619 working
+    /// flat out.
+    pub fn tier(&self) -> DeviceTier {
+        let ram = self.ram_mb;
+        let khz = self.max_cpu_khz;
+        let slower = |limit: u64| khz > 0 && khz < limit;
+        if self.low_ram || (ram > 0 && ram < 4_500) {
+            DeviceTier::Low
+        } else if ram == 0 && khz == 0 {
+            DeviceTier::Mid
+        } else if (ram > 0 && ram < 7_000) || slower(2_300_000) {
+            DeviceTier::Mid
+        } else if (ram > 0 && ram < 10_000) || slower(2_900_000) {
+            DeviceTier::High
+        } else {
+            DeviceTier::Flagship
+        }
+    }
+    /// The 3D scene's resolution in percent so it draws about the tier's pixel
+    /// count (the HUD stays sharp), in steps of 5 from 50 to 100. None when the
+    /// screen size is unknown.
+    pub fn resolution_scale(&self, tier: DeviceTier) -> Option<u32> {
+        let pixels = self.width as f64 * self.height as f64;
+        if pixels <= 0.0 {
+            return None;
+        }
+        let target = match tier {
+            DeviceTier::Low => 1.6e6,
+            DeviceTier::Mid => 2.5e6,
+            DeviceTier::High => 3.5e6,
+            DeviceTier::Flagship => 4.5e6,
+        };
+        if pixels <= target {
+            return Some(100);
+        }
+        let percent = 100.0 * (target / pixels).sqrt();
+        Some((((percent / 5.0).round() * 5.0) as u32).clamp(50, 100))
+    }
+    /// The tier's frame cap, never above the screen's top refresh rate.
+    pub fn max_fps(&self, tier: DeviceTier) -> u32 {
+        let want = match tier {
+            DeviceTier::Low | DeviceTier::Mid => 60,
+            DeviceTier::High => 90,
+            DeviceTier::Flagship => 120,
+        };
+        if self.refresh_hz >= 30 { want.min(self.refresh_hz) } else { want }
     }
 }
 
