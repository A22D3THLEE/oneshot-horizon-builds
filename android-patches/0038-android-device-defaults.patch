     use super::*;
     #[test]
+    fn device_tiers_follow_memory_and_cpu() {
+        // The test tablet: Xiaomi, SM8635, 12 GB, 2136x3200, 144 Hz.
+        let tablet = DeviceProfile {
+            max_cpu_khz: 3_014_400,
+            ..DeviceProfile::parse("width=2136\nheight=3200\nrefresh=144.0\nram_mb=11236\nlow_ram=0\n")
+        };
+        assert_eq!(tablet.tier(), DeviceTier::Flagship);
+        assert_eq!(tablet.resolution_scale(DeviceTier::Flagship), Some(80));
+        assert_eq!(tablet.max_fps(DeviceTier::Flagship), 120);
+        // 6 GB, 1080x2400, 60 Hz: Mid, full resolution (2.6 MP is about the target).
+        let mid = DeviceProfile { width: 1080, height: 2400, refresh_hz: 60, ram_mb: 5_600, low_ram: false, max_cpu_khz: 2_400_000 };
+        assert_eq!(mid.tier(), DeviceTier::Mid);
+        assert_eq!(mid.resolution_scale(DeviceTier::Mid), Some(100));
+        assert_eq!(mid.max_fps(DeviceTier::Mid), 60);
+        // 8 GB with a slow CPU is held at Mid; 8 GB with a fast one is High.
+        let slow = DeviceProfile { ram_mb: 7_500, max_cpu_khz: 2_000_000, ..mid };
+        assert_eq!(slow.tier(), DeviceTier::Mid);
+        // The test phone: Redmi, SD695 (2.208 GHz), 8 GB, 1080x2400, 120 Hz.
+        let sd695 = DeviceProfile { ram_mb: 7_456, max_cpu_khz: 2_208_000, refresh_hz: 120, ..mid };
+        assert_eq!(sd695.tier(), DeviceTier::Mid);
+        assert_eq!(sd695.max_fps(DeviceTier::Mid), 60);
+        // Snapdragon 778G / 7 Gen 1 (2.4 GHz) with 8 GB stay High.
+        assert_eq!(DeviceProfile { max_cpu_khz: 2_400_000, ..sd695 }.tier(), DeviceTier::High);
+        let high = DeviceProfile { ram_mb: 7_500, max_cpu_khz: 2_800_000, refresh_hz: 120, ..mid };
+        assert_eq!(high.tier(), DeviceTier::High);
+        assert_eq!(high.max_fps(DeviceTier::High), 90);
+        // Android's low-RAM flag and 4 GB are Low; nothing known is Mid.
+        assert_eq!(DeviceProfile { low_ram: true, ..tablet }.tier(), DeviceTier::Low);
+        assert_eq!(DeviceProfile { ram_mb: 3_700, ..mid }.tier(), DeviceTier::Low);
+        assert_eq!(DeviceProfile::default().tier(), DeviceTier::Mid);
+        assert_eq!(DeviceProfile::default().resolution_scale(DeviceTier::Mid), None);
+        assert_eq!(DeviceProfile::default().max_fps(DeviceTier::Flagship), 120);
+        // A huge screen on a Low phone is not drawn under half resolution.
+        let big = DeviceProfile { width: 3000, height: 3000, ..DeviceProfile::default() };
+        assert_eq!(big.resolution_scale(DeviceTier::Low), Some(50));
+    }
