diff --git a/packaging/android/java/dev/horizonlab/horizon/FriendsBook.java b/packaging/android/java/dev/horizonlab/horizon/FriendsBook.java
new file mode 100644
index 0000000..d0e0507
--- /dev/null
+++ b/packaging/android/java/dev/horizonlab/horizon/FriendsBook.java
@@ -0,0 +1,189 @@
+package dev.horizonlab.horizon;
+
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import java.io.File;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Oneshot: the friends this player shared a world with, as the game keeps them beside the identity
+ * file (horizon-friends book.rs): "nameplate TAB secret TAB last unix seconds TAB stale 0/1 TAB name"
+ * per line, the most recent first. Only the game writes the book; the launcher reads it to join a
+ * friend again. The secret is part of the friend's code: it is never shown, logged or copied.
+ * As the PC launcher's FriendsBook.cs and RecentFriendsView.cs.
+ */
+final class FriendsBook {
+    private static final String ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+    private static final int KEEP = 32;
+
+    static final class Friend {
+        String name;
+        String nameplate;
+        private String secret;
+        /** Unix milliseconds of the last session together, 0 unknown. */
+        long last;
+        /** The friend reissued their code since: a join would only count as a wrong guess on the relay. */
+        boolean stale;
+
+        String code() {
+            return nameplate + secret;
+        }
+    }
+
+    private FriendsBook() {}
+
+    static File file(android.app.Activity a) {
+        return new File(FriendsIdentity.file(a).getParentFile(), "friends-book.txt");
+    }
+
+    private static String part(String s) {
+        if (s == null) return null;
+        s = s.trim().toUpperCase(Locale.ROOT).replace('O', '0').replace('I', '1').replace('L', '1');
+        if (s.length() != 4) return null;
+        for (int i = 0; i < 4; i++) if (ALPHABET.indexOf(s.charAt(i)) < 0) return null;
+        return s;
+    }
+
+    private static String clean(String name) {
+        StringBuilder b = new StringBuilder();
+        for (int i = 0; i < name.length() && b.length() < 24; i++) {
+            char c = name.charAt(i);
+            if (!Character.isISOControl(c)) b.append(c);
+        }
+        return b.toString().trim();
+    }
+
+    static List<Friend> read(android.app.Activity a, int max) {
+        List<Friend> all = new ArrayList<>();
+        String text;
+        try {
+            File f = file(a);
+            if (!f.isFile()) return all;
+            text = new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8);
+        } catch (Exception e) {
+            return all;
+        }
+        for (String line : text.replace("\r", "").split("\n")) {
+            String[] p = line.split("\t", 5);
+            if (p.length < 5) continue;
+            String nameplate = part(p[0]), secret = part(p[1]);
+            if (nameplate == null || secret == null) continue;
+            Friend f = new Friend();
+            f.nameplate = nameplate;
+            f.secret = secret;
+            try {
+                f.last = Long.parseLong(p[2].trim()) * 1000L;
+            } catch (NumberFormatException e) {
+                f.last = 0;
+            }
+            f.stale = p[3].trim().equals("1");
+            String name = clean(p[4]);
+            f.name = name.isEmpty() ? nameplate : name;
+            all.add(f);
+        }
+        Collections.sort(all, new Comparator<Friend>() {
+            public int compare(Friend x, Friend y) {
+                return Long.compare(y.last, x.last);
+            }
+        });
+        // One entry per nameplate, the most recent first, as the game keeps it.
+        Map<String, Friend> one = new LinkedHashMap<>();
+        for (Friend f : all) if (!one.containsKey(f.nameplate)) one.put(f.nameplate, f);
+        List<Friend> out = new ArrayList<>(one.values());
+        return out.size() > max ? new ArrayList<>(out.subList(0, Math.max(0, max))) : out;
+    }
+
+    static int count(android.app.Activity a) {
+        return read(a, KEEP).size();
+    }
+
+    // Soft colors for the badges, picked by the nameplate so a friend keeps theirs.
+    private static final int[] BADGES = {
+        0xFF5E81AC, 0xFFA3719B, 0xFF689778, 0xFFB8865C, 0xFF8174B8, 0xFF5896A0, 0xFFB06868, 0xFF8C9260,
+    };
+
+    private static int badge(String key) {
+        int h = 17;
+        for (int i = 0; i < key.length(); i++) h = h * 31 + key.charAt(i);
+        return BADGES[(h & 0x7fffffff) % BADGES.length];
+    }
+
+    private static String when(long ms) {
+        if (ms <= 0) return "";
+        long min = (System.currentTimeMillis() - ms) / 60000L;
+        if (min < 1) return Ui.t("только что", "just now");
+        if (min < 60) return min + Ui.t(" мин назад", " min ago");
+        if (min < 24 * 60) return (min / 60) + Ui.t(" ч назад", " h ago");
+        return Ui.ago(ms);
+    }
+
+    /** One row per friend: a round badge with the first letter, the name, when, and Join. */
+    static void fill(final ProfileActivity a, LinearLayout into, List<Friend> friends) {
+        for (int i = 0; i < friends.size(); i++) {
+            final Friend f = friends.get(i);
+            LinearLayout r = Ui.row(a);
+            r.setGravity(Gravity.CENTER_VERTICAL);
+
+            TextView letter = new TextView(a);
+            letter.setText(f.name.isEmpty() ? "?" : f.name.substring(0, 1).toUpperCase(Locale.getDefault()));
+            letter.setTextColor(0xFFFFFFFF);
+            letter.setTextSize(17);
+            letter.setTypeface(Typeface.create("sans-serif-medium", Typeface.BOLD));
+            letter.setGravity(Gravity.CENTER);
+            GradientDrawable circle = new GradientDrawable();
+            circle.setShape(GradientDrawable.OVAL);
+            int color = badge(f.nameplate);
+            circle.setColor(f.stale ? (color & 0x00FFFFFF) | 0x66000000 : color);
+            letter.setBackground(circle);
+            int size = Ui.dp(a, 40);
+            r.addView(letter, new LinearLayout.LayoutParams(size, size));
+
+            LinearLayout texts = new LinearLayout(a);
+            texts.setOrientation(LinearLayout.VERTICAL);
+            TextView name = Ui.text(a, f.name, 15, f.stale ? Ui.MUTED : Ui.TEXT, true);
+            name.setSingleLine(true);
+            name.setEllipsize(android.text.TextUtils.TruncateAt.END);
+            name.setPadding(0, 0, 0, 0);
+            texts.addView(name);
+            String sub = f.stale ? Ui.t("сменил код: сыграйте вместе ещё раз", "changed their code: play together once more")
+                    : f.last <= 0 ? "" : Ui.t("играли вместе ", "played together ") + when(f.last);
+            TextView s = Ui.text(a, sub, 12, Ui.MUTED, false);
+            s.setPadding(0, 0, 0, 0);
+            if (!sub.isEmpty()) texts.addView(s);
+            LinearLayout.LayoutParams tl = new LinearLayout.LayoutParams(0, -2, 1);
+            tl.leftMargin = Ui.dp(a, 12);
+            tl.rightMargin = Ui.dp(a, 8);
+            r.addView(texts, tl);
+
+            final Button join = Ui.button(a, Ui.t("Подключиться", "Join"), !f.stale);
+            join.setTextSize(15);
+            join.setMinHeight(Ui.dp(a, 48));
+            join.setPadding(Ui.dp(a, 16), 0, Ui.dp(a, 16), 0);
+            join.setEnabled(!f.stale);
+            if (f.stale) join.setAlpha(0.5f);
+            join.setOnClickListener(new View.OnClickListener() {
+                public void onClick(View v) {
+                    // One press, one start.
+                    join.setEnabled(false);
+                    a.playFriend(f.code());
+                }
+            });
+            r.addView(join, new LinearLayout.LayoutParams(-2, -2));
+
+            into.addView(r, Ui.gap(a, i == 0 ? 4 : 10));
+        }
+    }
+}
