+package dev.horizonlab.horizon;
+
+import android.view.View;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import java.io.File;
+import java.util.Calendar;
+import java.util.List;
+import java.util.Map;
+
+/** Oneshot: the start page, as the PC launcher's Home (HomePage.cs): play time, last worlds, news, a tip. */
+final class HomePage extends Page {
+    private static final String[][] TIPS = {
+        {"Скриншот — кнопка F2 на сенсорной панели. Снимки появятся в «Галерее».",
+            "Screenshot: the F2 button on the touch panel. Shots show up in the Gallery."},
+        {"Чтобы позвать друга: в игре пауза → «Игра с друзьями» → «Открыть для друзей» → «Отправить код».",
+            "To invite a friend: in the game, pause → Play with Friends → Start Sharing → Send Invite."},
+        {"Перед обновлением игры сделайте бэкап миров на странице «Миры».",
+            "Back your worlds up on the Worlds page before updating the game."},
+        {"Миры переносятся между телефоном и ПК обычным zip — экспорт и импорт на странице «Миры».",
+            "Worlds move between the phone and the PC as a plain zip: export and import on the Worlds page."},
+        {"Набор модов и ресурспаков можно передать другу одним файлом .oneshotpack («Друзья»).",
+            "Hand your mods and resource packs to a friend as one .oneshotpack file (Friends)."},
+        {"Игра тормозит на Snapdragon? Попробуйте драйвер Turnip в «Настройках».",
+            "Slow on a Snapdragon? Try the Turnip driver in Settings."},
+        {"Вылет? Лог можно посмотреть и отправить из «Настроек» — так проще найти причину.",
+            "A crash? View and send the log from Settings: it makes the cause easier to find."},
+    };
+
+    private final TextView hello;
+    private final LinearLayout figures;
+    private final Ui.Week week;
+    private final TextView weekTotal;
+    private final LinearLayout recent;
+    private final LinearLayout friends;
+    private final LinearLayout news;
+    private boolean newsLoaded;
+
+    HomePage(ProfileActivity a) {
+        super(a);
+        hello = Ui.text(a, "", 26, Ui.TEXT, true);
+        root.addView(hello);
+        LinearLayout status = Ui.row(a);
+        status.addView(Ui.chip(a, "v" + UpdateActivity.versionName(a), false));
+        TextView relay = a.relayLabel();
+        LinearLayout.LayoutParams rl = new LinearLayout.LayoutParams(-2, -2);
+        rl.leftMargin = dp(8);
+        status.addView(relay, rl);
+        root.addView(status, Ui.gap(a, 4));
+
+        figures = new LinearLayout(a);
+        figures.setOrientation(LinearLayout.VERTICAL);
+        root.addView(figures, Ui.gap(a, 14));
+
+        LinearLayout fr = block(Ui.t("Недавно играли вместе", "Played together lately"));
+        friends = new LinearLayout(a);
+        friends.setOrientation(LinearLayout.VERTICAL);
+        fr.addView(friends);
+
+        LinearLayout wk = block(Ui.t("Последние 7 дней", "Last 7 days"));
+        week = new Ui.Week(a);
+        wk.addView(week, Ui.gap(a, 6));
+        weekTotal = note(wk, "");
+
+        LinearLayout rec = block(Ui.t("Недавние миры", "Recent worlds"));
+        recent = new LinearLayout(a);
+        recent.setOrientation(LinearLayout.VERTICAL);
+        rec.addView(recent);
+
+        LinearLayout nw = block(Ui.t("Новости", "News"));
+        news = new LinearLayout(a);
+        news.setOrientation(LinearLayout.VERTICAL);
+        nw.addView(news);
+
+        LinearLayout tip = block(Ui.t("Совет", "Tip"));
+        String[] t = TIPS[Calendar.getInstance().get(Calendar.DAY_OF_YEAR) % TIPS.length];
+        tip.addView(Ui.text(a, Ui.t(t[0], t[1]), 14, Ui.TEXT, false));
+    }
+
+    @Override
+    void shown() {
+        String name = a.readName();
+        int hour = Calendar.getInstance().get(Calendar.HOUR_OF_DAY);
+        String greet = hour < 5 ? Ui.t("Доброй ночи", "Good night") : hour < 12 ? Ui.t("Доброе утро", "Good morning")
+                : hour < 18 ? Ui.t("Добрый день", "Good afternoon") : Ui.t("Добрый вечер", "Good evening");
+        hello.setText(greet + (name.isEmpty() ? "" : ", " + name));
+
+        Map<String, String> t = PlayStats.totals(a);
+        figures.removeAllViews();
+        View[] tiles = {
+            Ui.tile(a, Ui.duration(PlayStats.num(t, "total")), Ui.t("всего в игре", "played")),
+            Ui.tile(a, "" + PlayStats.num(t, "sessions"), Ui.t("запусков", "sessions")),
+            Ui.tile(a, Ui.duration(PlayStats.num(t, "longest")), Ui.t("самая долгая", "longest")),
+            Ui.tile(a, Ui.duration(PlayStats.num(t, "friends")), Ui.t("с друзьями", "with friends")),
+        };
+        // Four in a row when there is room, else two rows of two.
+        int per = a.pageWidthDp() >= 560 ? 4 : 2;
+        for (int i = 0; i < tiles.length; i += per) {
+            LinearLayout r = Ui.row(a);
+            for (int j = 0; j < per && i + j < tiles.length; j++) r.addView(tiles[i + j], Ui.part(a, j == 0));
+            figures.addView(r, Ui.gap(a, i == 0 ? 0 : 10));
+        }
+        String[] names = new String[7];
+        long[] days = PlayStats.week(t, names);
+        week.set(days, names);
+        long sum = 0;
+        for (long d : days) sum += d;
+        long last = PlayStats.num(t, "last");
+        weekTotal.setText(Ui.t("За неделю: ", "This week: ") + Ui.duration(sum)
+                + Ui.t(" · последняя игра: ", " · last played: ") + Ui.ago(last));
+
+        friends.removeAllViews();
+        List<FriendsBook.Friend> book = FriendsBook.read(a, 32);
+        if (book.isEmpty()) {
+            note(friends, Ui.t("Пока никого. Друзья появятся здесь после первой совместной игры по коду друга.",
+                    "No one yet. Friends show up here after the first game together by a friend's code."));
+        } else {
+            FriendsBook.fill(a, friends, book.subList(0, Math.min(3, book.size())));
+            note(friends, Ui.t("Подключение сработает, если друг сейчас открыл мир для друзей.",
+                    "Joining works when the friend has their world open to friends right now."));
+            if (book.size() > 3) {
+                TextView all = Ui.text(a, Ui.t("Все друзья (", "All friends (") + book.size() + ") →", 13, Ui.GREEN, true);
+                all.setOnClickListener(new View.OnClickListener() {
+                    public void onClick(View v) {
+                        a.show(ProfileActivity.FRIENDS);
+                    }
+                });
+                friends.addView(all, Ui.gap(a, 4));
+            }
+        }
+
+        recent.removeAllViews();
+        List<File> worlds = WorldsPage.worlds(a.dir);
+        if (worlds.isEmpty()) {
+            note(recent, Ui.t("Миров пока нет: создайте первый в игре.", "No worlds yet: create the first one in the game."));
+        }
+        for (int i = 0; i < Math.min(3, worlds.size()); i++) {
+            File w = worlds.get(i);
+            LinearLayout r = Ui.row(a);
+            TextView n = Ui.text(a, w.getName(), 15, Ui.TEXT, true);
+            n.setSingleLine(true);
+            n.setEllipsize(android.text.TextUtils.TruncateAt.END);
+            r.addView(n, new LinearLayout.LayoutParams(0, -2, 1));
+            r.addView(Ui.text(a, Ui.ago(new File(w, "level.dat").lastModified()), 12, Ui.MUTED, false));
+            r.setOnClickListener(new View.OnClickListener() {
+                public void onClick(View v) {
+                    a.show(ProfileActivity.WORLDS);
+                }
+            });
+            recent.addView(r);
+        }
+
+        if (!newsLoaded) loadNews();
+    }
+
+    private void loadNews() {
+        newsLoaded = true;
+        news.removeAllViews();
+        note(news, Ui.t("Загружаем…", "Loading…"));
+        new Thread(new Runnable() {
+            public void run() {
+                List<UpdateActivity.Release> list = null;
+                try {
+                    list = UpdateActivity.releases(a, false);
+                } catch (Exception ignored) {
+                }
+                final List<UpdateActivity.Release> got = list;
+                a.runOnUiThread(new Runnable() {
+                    public void run() {
+                        if (a.isFinishing()) return;
+                        news.removeAllViews();
+                        if (got == null || got.isEmpty()) {
+                            newsLoaded = false;
+                            note(news, Ui.t("Нет связи с GitHub — новости появятся позже.", "No connection to GitHub: news later."));
+                            return;
+                        }
+                        for (int i = 0; i < Math.min(3, got.size()); i++) {
+                            UpdateActivity.Release r = got.get(i);
+                            news.addView(Ui.text(a, r.name + (r.date.isEmpty() ? "" : "  ·  " + r.date), 14, i == 0 ? Ui.GREEN : Ui.TEXT, true),
+                                    Ui.gap(a, i == 0 ? 0 : 8));
+                            String notes = readable(r.notes);
+                            if (notes.length() > 220) notes = notes.substring(0, 220) + "…";
+                            if (!notes.isEmpty()) note(news, notes);
+                        }
+                        TextView more = Ui.text(a, Ui.t("Все версии →", "All versions →"), 13, Ui.GREEN, true);
+                        more.setOnClickListener(new View.OnClickListener() {
+                            public void onClick(View v) {
+                                a.startActivity(new android.content.Intent(a, UpdateActivity.class));
+                            }
+                        });
+                        news.addView(more, Ui.gap(a, 6));
+                    }
+                });
+            }
+        }).start();
+    }
+
+    /**
+     * The release text a player reads: without the service lines CI writes for UpdateActivity
+     * (versionCode, versionName, sha256, port commit, patches) and the heading that repeats the title.
+     */
+    static String readable(String body) {
+        StringBuilder b = new StringBuilder();
+        for (String l : body.replace("\r", "").split("\n")) {
+            String t = l.trim();
+            if (t.isEmpty() || t.startsWith("OneShot for Android") || t.matches("(?i)(Что нового|What's new):?")) continue;
+            if (t.startsWith("- ")) t = "•" + t.substring(1);
+            if (t.matches("(?i)(versionCode|versionName|sha256|port commit|patches)\\s*:.*")) continue;
+            b.append(t).append(' ');
+        }
+        return b.toString().replaceAll("[#*`>]", "").replaceAll("\\s+", " ").trim();
+    }
+}
