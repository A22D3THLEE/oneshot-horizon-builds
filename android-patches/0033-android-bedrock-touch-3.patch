-    /// The name of the entity under the crosshair that a use rides, trades with or
-    /// opens, for the interact button; none while riding, in menus or in the editor.
+    /// The action button's label (Bedrock): what a use does now with the held item
+    /// and the target, as a verb (fish, leash, unleash, shear, ride...); a tap on it
+    /// is a plain use. None in menus or in the editor, or when a use does nothing.
     fn touch_interact_target(&self) -> Option<String> {
         if !self.touch_controls_shown()
             || self.touch.editing
             || self.screen != super::Screen::Playing
             || self.spectator()
-            || self.riding.is_some()
         {
