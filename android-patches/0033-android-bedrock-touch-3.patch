+    /// The menu finger held still on a stack of more than one for a hold: the count
+    /// bar opens, halfway (Bedrock). Not on the creative grid, a result slot or with
+    /// a stack already in hand.
+    fn touch_split_begin(&mut self) {
+        let hold = u128::from(self.touch.layout.hold_ms);
+        if self.touch.menu != MenuTouch::Pending
+            || self.touch.menu_since.elapsed().as_millis() < hold
+            || self.carried.is_some()
+            || !self.touch_slot_screen()
+        {
+            return;
+        }
+        let Some(i) = self.touch.menu_slot else { return };
+        // Only slots that take the extra back: the inventory, the crafting grid and
+        // a container's own slots (not a furnace's output, a crafter's result, a
+        // station or a mod's screen, whose outputs refuse it).
+        let kind = self.container_kind();
+        let output = match kind {
+            Some(super::BlockEntity::Furnace(_)) => i == 302,
+            Some(super::BlockEntity::Crafter(_)) => i == 309,
+            _ => false,
+        };
+        let plain = i < 36 || (100..109).contains(&i) || (300..500).contains(&i) && !output;
+        if !plain || self.native_screen_slots().is_some() || (self.creative_tab_open() && i < 9) {
+            return;
+        }
+        let max = self.slot_view(i).map_or(0, |s| s.count);
+        if max > 1 {
+            self.touch.split_x0 = self.touch.menu_pos[0];
+            self.touch.menu = MenuTouch::Split { n: max.div_ceil(2), max };
+        }
+    }
+
+    /// The count bar over the finger while a split is picked.
+    fn draw_touch_split(&self, batch: &mut HudBatch, scale: f32) {
+        let MenuTouch::Split { n, max } = self.touch.menu else { return };
+        let atlas = &self.gui.atlas;
+        let p = self.touch.menu_pos;
+        let (fx, fy) = ((p[0] / f64::from(scale)) as f32, (p[1] / f64::from(scale)) as f32);
+        let (w, h) = (SPLIT_W, 10.0);
+        let x = (fx - w / 2.0).clamp(2.0, (batch.width - w - 2.0).max(2.0)).round();
+        let y = (fy - 34.0).max(2.0).round();
+        batch.fill(atlas, x - 1.0, y - 1.0, w + 2.0, h + 2.0, rgba(16, 16, 16, 235));
+        batch.fill(atlas, x, y, w, h, rgba(70, 70, 70, 235));
+        let filled = (w * n as f32 / max as f32).round();
+        batch.fill(atlas, x, y, filled, h, rgba(76, 175, 80, 255));
+        batch.fill(atlas, x, y, filled, 1.0, rgba(129, 199, 132, 255));
+        let label = format!("{n}/{max}");
+        let tw = HudBatch::text_width(atlas, &label);
+        batch.text(atlas, &label, (x + (w - tw) / 2.0).round(), y + 1.0, 0xFFFF_FFFF, true);
+    }
+
