+
+    fn touch_action(&self) -> Option<&'static str> {
+        // The raised shield holds the use down: a tap would not use again.
+        if self.touch.shield_up {
+            return None;
+        }
+        let main = self.inventory[self.selected].as_ref();
+        let item = main.map_or("", |s| &*s.item);
+        let rod = |s: Option<&horizon_client::items::ItemStack>| s.is_some_and(|s| &*s.item == "minecraft:fishing_rod");
+        // A use acts on the entity first (`interactOn`), the item only if it did nothing.
+        if let Some(id) = self.pick_entity_hit().flatten() {
+            if let Some(m) = self.mobs.iter().find(|m| m.id as i32 == id && !m.removed) {
+                // "" is a use the entity takes but that does nothing to show.
+                if let Some(k) = self.touch_mob_action(m, item, main) {
+                    return (!k.is_empty()).then_some(k);
+                }
+            } else if let Some(b) = self.boats.iter().find(|b| b.id as i32 == id) {
+                use horizon_client::mobs::leash::Holder;
+                if b.leash == Some(Holder::Player) && b.leash_player.is_none_or(|p| p == self.acting_uuid()) {
+                    return Some("unleash");
+                }
+                if item == "minecraft:shears" && b.leash.is_some() {
+                    return Some("unleash");
+                }
+                if item == "minecraft:lead" && b.leash != Some(Holder::Player) {
+                    return Some("leash");
+                }
+                if self.riding.is_none() {
+                    return Some("ride");
+                }
+            } else if self.riding.is_none()
+                && let Some(t) = self.level_entity(id)
+            {
+                // Not simulated here (a server's entity): by its kind alone, and a
+                // mount only with an empty hand (an item may be fed or put on it).
+                let kind = self.target_type(t);
+                if let Some(path) = kind.strip_prefix("minecraft:")
+                    && let Some(k) = interactive(path)
+                    && (k != "ride" || main.is_none() || path.ends_with("_boat") || path.ends_with("_raft") || path == "minecart")
+                {
+                    return Some(k);
+                }
+            }
+        }
+        // Uses of the item itself, with nothing to act on. A fence ties the lead
+        // first (`LeashFenceKnotEntity`), whatever the hand holds.
+        if self.touch_fence_aimed() && self.touch_has_leashed() {
+            return Some("tie");
+        }
+        if rod(main) || main.is_none() && rod(self.offhand.as_ref()) {
+            return Some(if self.hook.is_some() { "reel" } else { "fish" });
+        }
+        None
+    }
+
+    /// A fence under the crosshair (a lead's knot goes on it).
+    fn touch_fence_aimed(&self) -> bool {
+        self.pick().is_some_and(|hit| {
+            let name = &self.res.facts().get(self.world.block(hit.pos[0], hit.pos[1], hit.pos[2])).name;
+            self.res.items().block_tags.get("minecraft:fences").is_some_and(|s| s.contains(&**name))
+        })
+    }
+
+    /// Anything on the player's lead.
+    fn touch_has_leashed(&self) -> bool {
+        use horizon_client::mobs::leash::Holder;
+        let acting = self.acting_uuid();
+        !self.player_leashed(self.player_center()).is_empty()
+            || self.boats.iter().any(|b| b.leash == Some(Holder::Player) && b.leash_player.is_none_or(|p| p == acting))
+    }
+
+    /// What a use does to a simulated mob with this item in the main hand, in the
+    /// order the mob takes it; `Some("")` when the mob takes the use but shows
+    /// nothing worth a label (the item is then not used either), None when the
+    /// use passes on to the item. Only cases that are sure get a label.
+    fn touch_mob_action(
+        &self,
+        m: &horizon_client::mobs::Mob,
+        item: &str,
+        main: Option<&horizon_client::items::ItemStack>,
+    ) -> Option<&'static str> {
+        use horizon_client::mobs::{Species as S, leash::Holder};
+        if !m.alive() {
+            return None;
+        }
+        let acting = self.acting_uuid();
+        let (sp, baby, x) = (m.species(), m.is_baby(), &m.extra);
+        // Mob.interact: a named name tag, then the lead (on it, or shears through
+        // any lead on or from it), then the mob's own use.
+        if item == "minecraft:name_tag" && main.is_some_and(|s| s.custom_name().is_some()) {
+            return Some("name");
+        }
+        if x.leash == Some(Holder::Player) && x.leash_player.is_none_or(|p| p == acting) {
+            return Some("unleash");
+        }
+        if item == "minecraft:shears"
+            && (x.leash.is_some() || self.mobs.iter().any(|o| !o.removed && o.extra.leash == Some(Holder::Mob(m.id))))
+        {
+            return Some("unleash");
+        }
+        if item == "minecraft:lead" && horizon_client::mobs::leash::can_be_leashed(m) {
+            return Some("leash");
+        }
+        let empty = main.is_none();
+        let food = !empty && m.kind.food.iter().any(|f| f.as_str() == item);
+        let full = m.health >= m.attrs.max_health;
+        let takes = food && horizon_client::mobs::ai::takes_food(m);
+        let mine = x.tame && x.owner == Some(acting);
+        match sp {
