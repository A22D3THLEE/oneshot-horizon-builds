diff --git a/packaging/android/java/dev/horizonlab/horizon/FriendsIdentity.java b/packaging/android/java/dev/horizonlab/horizon/FriendsIdentity.java
new file mode 100644
index 00000000..492b7d17
--- /dev/null
+++ b/packaging/android/java/dev/horizonlab/horizon/FriendsIdentity.java
@@ -0,0 +1,94 @@
+package dev.horizonlab.horizon;
+
+import android.app.Activity;
+
+import java.io.File;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+import java.security.SecureRandom;
+import java.util.Locale;
+
+/**
+ * Oneshot: the lasting short code (friends-identity.txt in the game folder, horizon-friends identity.rs): the
+ * nameplate and secret of the code, the claim that keeps the nameplate this player's on the relay, and the wrong
+ * guesses made on the secret. The launcher shows it and reissues it; the game makes it if it is missing too.
+ */
+final class FriendsIdentity {
+    private static final String ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private FriendsIdentity() {}
+
+    static File file(Activity a) {
+        return new File(SetupActivity.home(a), "friends-identity.txt");
+    }
+
+    /** The code as NAME-SECR, made when the file is missing or broken; null when it can't be written. */
+    static synchronized String code(Activity a) {
+        File f = file(a);
+        String c = read(f);
+        if (c != null) return c;
+        try {
+            return write(f);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /** A new code and claim in place of the old one. */
+    static synchronized String reissue(Activity a) throws Exception {
+        File f = file(a);
+        String old = read(f);
+        String c = write(f);
+        // Another nameplate than the old one, so its friends can't get in.
+        while (old != null && c.substring(0, 4).equals(old.substring(0, 4))) c = write(f);
+        return c;
+    }
+
+    private static String read(File f) {
+        try {
+            if (!f.isFile()) return null;
+            String name = null, secret = null, claim = null;
+            for (String line : new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8).split("\n")) {
+                int eq = line.indexOf('=');
+                if (eq < 0) continue;
+                String k = line.substring(0, eq).trim(), v = line.substring(eq + 1).trim();
+                if (k.equals("nameplate")) name = half(v);
+                else if (k.equals("secret")) secret = half(v);
+                else if (k.equals("claim")) claim = v;
+            }
+            if (name == null || secret == null || claim == null || !claim.matches("[0-9A-Fa-f]{32,128}")) return null;
+            return name + "-" + secret;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /** Four symbols as the game reads them (any case, O for 0, I and L for 1), else null. */
+    private static String half(String v) {
+        String s = v.toUpperCase(Locale.ROOT).replace('O', '0').replace('I', '1').replace('L', '1');
+        return s.matches("[0-9A-HJKMNP-TV-Z]{4}") ? s : null;
+    }
+
+    private static String symbols() {
+        StringBuilder b = new StringBuilder(4);
+        for (int i = 0; i < 4; i++) b.append(ALPHABET.charAt(RANDOM.nextInt(32)));
+        return b.toString();
+    }
+
+    private static String write(File f) throws Exception {
+        String name = symbols(), secret = symbols();
+        byte[] raw = new byte[32];
+        RANDOM.nextBytes(raw);
+        StringBuilder claim = new StringBuilder(64);
+        for (byte x : raw) claim.append(String.format(Locale.ROOT, "%02x", x & 0xff));
+        String text = "nameplate=" + name + "\nsecret=" + secret + "\nclaim=" + claim + "\nwrong=0\n";
+        File dir = f.getParentFile();
+        if (dir != null) dir.mkdirs();
+        File tmp = new File(f.getPath() + ".launcher.tmp");
+        Files.write(tmp.toPath(), text.getBytes(StandardCharsets.UTF_8));
+        Files.move(tmp.toPath(), f.toPath(), StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+        return name + "-" + secret;
+    }
+}
