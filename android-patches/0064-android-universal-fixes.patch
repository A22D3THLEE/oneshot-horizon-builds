diff --git a/packaging/android/java/dev/horizonlab/horizon/Turnip.java b/packaging/android/java/dev/horizonlab/horizon/Turnip.java
index 47d716f..986316d 100644
--- a/packaging/android/java/dev/horizonlab/horizon/Turnip.java
+++ b/packaging/android/java/dev/horizonlab/horizon/Turnip.java
@@ -37,8 +37,20 @@ final class Turnip {
         }
     }
 
+    /**
+     * Whether the GPU is an Adreno (a Qualcomm Snapdragon): Turnip drives only those. Mali, PowerVR
+     * and Xclipse phones (MediaTek, Exynos, Unisoc) keep their system driver and are not offered it.
+     */
+    static boolean supported() {
+        if (new File("/sys/class/kgsl").exists() || new File("/dev/kgsl-3d0").exists()) return true;
+        String soc = android.os.Build.VERSION.SDK_INT >= 31 ? android.os.Build.SOC_MANUFACTURER : "";
+        String hw = (android.os.Build.HARDWARE + " " + android.os.Build.BOARD + " " + soc).toLowerCase(java.util.Locale.ROOT);
+        return hw.contains("qcom") || hw.contains("qti") || hw.contains("qualcomm");
+    }
+
     static String status(Context c) {
         String p = selected(c);
+        if (p.isEmpty() && !supported()) return Ui.t("Сейчас: системный драйвер", "Now: the system driver");
         if (p.isEmpty()) return Ui.t("Сейчас: системный драйвер Qualcomm", "Now: the system Qualcomm driver");
         return Ui.t("Сейчас: ", "Now: ") + new File(p).getName();
     }
