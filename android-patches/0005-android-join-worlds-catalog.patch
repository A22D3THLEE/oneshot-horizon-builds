+
+    @Override
+    protected void onDestroy() {
+        generation++;
+        pool.shutdownNow();
+        super.onDestroy();
+    }
+
+    private void selectTab(int which) {
+        tab = which;
+        for (int i = 0; i < 4; i++) {
+            boolean on = i == which;
+            tabs[i].setBackground(on ? Ui.rounded(this, Ui.GREEN, 0, 10) : Ui.rounded(this, Ui.HIGH, Ui.EDGE, 10));
+            tabs[i].setTextColor(on ? Ui.ON_ACCENT : Ui.TEXT);
+        }
+        query.setText("");
+        query.setHint(which == SKINS ? Ui.t("Название или ник игрока", "Name or a player's name")
+                : which == CAPES ? Ui.t("Название плаща", "Cape name") : Ui.t("Поиск", "Search"));
+        runSearch();
+    }
+
+    private void runSearch() {
+        next = null;
+        load(true);
+    }
+
+    // ------------------------------------------------------------------ loading
+
+    private void load(final boolean fresh) {
+        final int gen = ++generation;
+        final int which = tab;
+        final String q = query.getText().toString().trim();
+        final String after = fresh ? null : next;
+        if (fresh) list.removeAllViews();
+        list.removeView(more);
+        status.setText(Ui.t("Загрузка…", "Loading…"));
+        pool.execute(new Runnable() {
+            public void run() {
+                final List<Item> items = new ArrayList<Item>();
+                String err = null;
+                String token = null;
+                try {
+                    if (which == SKINS) token = skins(q, after, items);
+                    else if (which == CAPES) capes(q, items);
+                    else if (which == PACKS) token = packs(q, after, items);
+                    else mods(q, items);
+                } catch (Exception e) {
+                    err = e.getMessage() == null ? e.toString() : e.getMessage();
+                }
+                final String error = err, nextToken = token;
+                ui.post(new Runnable() {
+                    public void run() {
+                        if (gen != generation) return;
+                        if (error != null) {
+                            status.setText(Ui.t("Не загрузилось: ", "Could not load: ") + error);
+                            return;
+                        }
+                        next = nextToken;
+                        status.setText(items.isEmpty() && list.getChildCount() == 0
+                                ? Ui.t("Ничего не найдено.", "Nothing found.") : "");
+                        for (Item it : items) list.addView(row(it), Ui.gap(CatalogActivity.this, 8));
+                        if (next != null) list.addView(more, Ui.gap(CatalogActivity.this, 10));
+                    }
+                });
+            }
+        });
+    }
+
+    private String skins(String q, String after, List<Item> out) throws Exception {
+        String url = "https://api.mineskin.org/v2/skins?size=" + PAGE
+                + (q.isEmpty() ? "" : "&filter=" + enc(q)) + (after == null ? "" : "&after=" + enc(after));
+        if (after == null && q.matches("[A-Za-z0-9_]{3,16}")) {
+            try {
+                player(q, out);
+            } catch (Exception ignored) {
+            }
+        }
+        JSONObject root = new JSONObject(getString(url));
+        JSONArray arr = root.optJSONArray("skins");
+        for (int i = 0; arr != null && i < arr.length(); i++) {
+            JSONObject s = arr.getJSONObject(i);
+            String tex = s.optString("texture", "");
+            if (!tex.matches("[0-9a-f]{20,80}")) continue;
+            Item it = new Item();
+            it.id = s.optString("uuid", "");
+            it.title = s.optString("name", "").isEmpty() ? Ui.t("Без названия", "Unnamed") : s.optString("name");
+            it.picture = "https://textures.minecraft.net/texture/" + tex;
+            it.signedUrl = "https://api.mineskin.org/v2/skins/" + enc(it.id);
+            out.add(it);
+        }
+        JSONObject nx = root.optJSONObject("pagination");
+        String token = null;
+        if (nx != null && nx.optJSONObject("next") != null) token = nx.getJSONObject("next").optString("after", null);
+        return arr == null || arr.length() == 0 ? null : token;
+    }
+
+    /** A player's skin and cape as Mojang has them. */
+    private void player(String name, List<Item> out) throws Exception {
+        String profile = getString("https://api.mojang.com/users/profiles/minecraft/" + enc(name));
+        if (profile.isEmpty()) return;
+        JSONObject p = new JSONObject(profile);
+        String id = p.optString("id", ""), real = p.optString("name", name);
+        if (id.isEmpty()) return;
+        JSONObject session = new JSONObject(getString("https://sessionserver.mojang.com/session/minecraft/profile/" + id));
+        JSONArray props = session.optJSONArray("properties");
+        for (int i = 0; props != null && i < props.length(); i++) {
+            JSONObject prop = props.getJSONObject(i);
+            if (!"textures".equals(prop.optString("name"))) continue;
+            JSONObject tex = new JSONObject(new String(android.util.Base64.decode(prop.getString("value"),
+                    android.util.Base64.DEFAULT), StandardCharsets.UTF_8)).optJSONObject("textures");
+            if (tex == null) continue;
+            JSONObject skin = tex.optJSONObject("SKIN");
+            if (skin != null) {
+                Item it = new Item();
+                it.id = real;
+                it.title = Ui.t("Скин игрока ", "Skin of ") + real;
+                it.picture = https(skin.optString("url"));
+                JSONObject meta = skin.optJSONObject("metadata");
+                it.hasSlim = true;
+                it.slim = meta != null && "slim".equals(meta.optString("model"));
+                it.signedUrl = "https://sessionserver.mojang.com/session/minecraft/profile/" + id + "?unsigned=false";
+                out.add(it);
+            }
+            JSONObject cape = tex.optJSONObject("CAPE");
+            if (cape != null) {
+                Item it = new Item();
+                it.id = real;
+                it.cape = true;
+                it.title = Ui.t("Плащ игрока ", "Cape of ") + real;
+                it.picture = https(cape.optString("url"));
+                out.add(it);
+            }
+        }
+    }
+
+    private void capes(String q, List<Item> out) throws Exception {
+        JSONObject root = new JSONObject(getString("https://api.mineskin.org/v2/capes"));
+        JSONArray arr = root.optJSONArray("capes");
+        for (int i = 0; arr != null && i < arr.length(); i++) {
+            JSONObject c = arr.getJSONObject(i);
+            String alias = c.optString("alias", ""), url = c.optString("url", "");
+            if (alias.isEmpty() || !url.contains("textures.minecraft.net/texture/")) continue;
+            if (!q.isEmpty() && !alias.toLowerCase(Locale.ROOT).contains(q.toLowerCase(Locale.ROOT))) continue;
+            Item it = new Item();
+            it.id = alias;
+            it.title = alias;
+            it.cape = true;
+            it.picture = https(url);
+            out.add(it);
+        }
+    }
+
+    private String packs(String q, String after, List<Item> out) throws Exception {
+        int offset = 0;
+        try {
+            if (after != null) offset = Integer.parseInt(after);
+        } catch (NumberFormatException ignored) {
+        }
+        String facets = "[[\"project_type:resourcepack\"],[\"versions:" + GAME_VERSION + "\"]]";
+        String url = "https://api.modrinth.com/v2/search?limit=" + PAGE + "&offset=" + offset
+                + "&index=" + (q.isEmpty() ? "downloads" : "relevance") + "&facets=" + enc(facets)
+                + (q.isEmpty() ? "" : "&query=" + enc(q));
+        JSONObject root = new JSONObject(getString(url));
+        JSONArray hits = root.optJSONArray("hits");
+        for (int i = 0; hits != null && i < hits.length(); i++) {
+            JSONObject h = hits.getJSONObject(i);
+            Item it = new Item();
+            it.kind = "pack";
+            it.id = h.optString("project_id");
+            it.title = h.optString("title");
+            it.sub = h.optString("author") + " · " + downloads(h.optLong("downloads")) + "\n" + h.optString("description");
+            it.picture = h.optString("icon_url", "");
+            out.add(it);
+        }
+        int reached = offset + (hits == null ? 0 : hits.length());
+        return hits != null && hits.length() == PAGE && reached < root.optInt("total_hits") ? String.valueOf(reached) : null;
+    }
+
+    private void mods(String q, List<Item> out) throws Exception {
+        JSONObject root = new JSONObject(getString(REGISTRY));
+        if (root.optInt("schema") > 1) throw new Exception(Ui.t("Каталог новее лаунчера", "The catalog is newer than this app"));
+        List<String> revoked = new ArrayList<String>();
+        JSONArray rev = root.optJSONArray("revoked");
+        for (int i = 0; rev != null && i < rev.length(); i++) revoked.add(rev.getJSONObject(i).optString("sha256").toLowerCase(Locale.ROOT));
+        JSONArray projects = root.optJSONArray("projects");
+        for (int i = 0; projects != null && i < projects.length(); i++) {
+            JSONObject pr = projects.getJSONObject(i);
+            String kind = pr.optString("kind");
+            if (!kind.equals("mod") && !kind.equals("resourcepack") && !kind.equals("shader")) continue;
+            JSONArray vs = pr.optJSONArray("versions");
+            JSONObject ver = null;
+            for (int j = 0; vs != null && j < vs.length(); j++) {
+                if (GAME_VERSION.equals(vs.getJSONObject(j).optString("game"))) {
+                    ver = vs.getJSONObject(j);
+                    break;
+                }
+            }
+            if (ver == null || ver.optJSONObject("file") == null) continue;
+            JSONObject f = ver.getJSONObject("file");
+            String sha = f.optString("sha256").toLowerCase(Locale.ROOT);
+            if (sha.length() != 64 || revoked.contains(sha)) continue;
+            Item it = new Item();
+            it.kind = kind;
+            it.id = pr.optString("id");
+            it.title = pr.optString("name") + " " + ver.optString("version");
+            StringBuilder authors = new StringBuilder();
+            JSONArray au = pr.optJSONArray("authors");
+            for (int k = 0; au != null && k < au.length(); k++) authors.append(k > 0 ? ", " : "").append(au.optString(k));
+            it.sub = authors + " · " + downloads(pr.optLong("downloads")) + "\n"
+                    + (kind.equals("mod") ? "" : (kind.equals("shader") ? Ui.t("шейдеры", "shader") : Ui.t("ресурспак", "pack")) + " · ")
+                    + pr.optString("summary");
+            if (!q.isEmpty() && !(it.title + " " + it.sub).toLowerCase(Locale.ROOT).contains(q.toLowerCase(Locale.ROOT))) continue;
+            it.picture = pr.optString("icon", "");
+            it.file = f.optString("url");
+            it.fileName = f.optString("name");
+            it.hash = sha;
+            it.hashKind = "SHA-256";
+            it.downloads = pr.optLong("downloads");
+            out.add(it);
+        }
+        java.util.Collections.sort(out, new java.util.Comparator<Item>() {
+            public int compare(Item a, Item b) {
+                return a.downloads == b.downloads ? 0 : a.downloads < b.downloads ? 1 : -1;
+            }
+        });
+    }
+
+    private static String downloads(long n) {
+        return n >= 1000000 ? String.format(Locale.ROOT, "%.1fM", n / 1e6) : n >= 1000 ? (n / 1000) + "k" : String.valueOf(n);
+    }
+
+    // ------------------------------------------------------------------ rows
+
+    private View row(final Item it) {
+        LinearLayout r = new LinearLayout(this);
+        r.setOrientation(LinearLayout.HORIZONTAL);
+        r.setGravity(Gravity.CENTER_VERTICAL);
+        int p = Ui.dp(this, 10);
+        r.setPadding(p, p, p, p);
+        r.setBackground(Ui.rounded(this, Ui.CARD, Ui.EDGE, 12));
+        final ImageView pic = new ImageView(this);
+        pic.setScaleType(ImageView.ScaleType.FIT_CENTER);
+        pic.setBackground(Ui.rounded(this, Ui.HIGH, 0, 8));
+        int sz = Ui.dp(this, 64);
+        r.addView(pic, new LinearLayout.LayoutParams(sz, sz));
+        LinearLayout text = new LinearLayout(this);
+        text.setOrientation(LinearLayout.VERTICAL);
+        LinearLayout.LayoutParams tl = new LinearLayout.LayoutParams(0, -2, 1);
+        tl.leftMargin = Ui.dp(this, 12);
+        tl.rightMargin = Ui.dp(this, 8);
+        TextView t = Ui.text(this, it.title == null ? "" : it.title, 16, Ui.TEXT, true);
+        t.setMaxLines(2);
+        text.addView(t);
+        if (it.sub != null && !it.sub.isEmpty()) {
+            TextView s = Ui.text(this, it.sub, 12, Ui.MUTED, false);
+            s.setMaxLines(3);
+            s.setEllipsize(android.text.TextUtils.TruncateAt.END);
+            text.addView(s);
+        }
+        r.addView(text, tl);
+        final Button act = Ui.button(this, it.kind != null ? Ui.t("Установить", "Install")
+                : it.cape ? Ui.t("Надеть плащ", "Wear cape") : Ui.t("Надеть", "Wear"), true);
+        act.setMinHeight(Ui.dp(this, 44));
+        act.setTextSize(15);
+        act.setOnClickListener(new View.OnClickListener() {
+            public void onClick(View v) {
+                act(it, act);
+            }
+        });
+        r.addView(act);
+        picture(it, pic);
+        return r;
+    }
+
+    private void picture(final Item it, final ImageView target) {
+        if (it.picture == null || it.picture.isEmpty()) return;
+        Bitmap have = pictures.get(it.picture);
+        if (have != null) {
+            target.setImageBitmap(have);
+            return;
+        }
+        final int gen = generation;
+        pool.execute(new Runnable() {
+            public void run() {
+                try {
+                    byte[] bytes = getBytes(it.picture, 4 << 20);
+                    BitmapFactory.Options o = new BitmapFactory.Options();
+                    o.inScaled = false;
+                    Bitmap b = BitmapFactory.decodeByteArray(bytes, 0, bytes.length, o);
+                    if (b == null) return;
+                    final Bitmap shown = it.kind == null && !it.cape ? face(b) : scaleUp(b);
+                    ui.post(new Runnable() {
+                        public void run() {
+                            pictures.put(it.picture, shown);
+                            target.setImageBitmap(shown);
+                        }
+                    });
+                } catch (Exception ignored) {
+                }
+            }
+        });
+    }
+
+    /** A skin's face with its hat layer, large and sharp. */
+    private static Bitmap face(Bitmap skin) {
+        if (skin.getWidth() < 64 || skin.getHeight() < 32) return scaleUp(skin);
+        Bitmap f = Bitmap.createBitmap(8, 8, Bitmap.Config.ARGB_8888);
+        android.graphics.Canvas c = new android.graphics.Canvas(f);
+        c.drawBitmap(Bitmap.createBitmap(skin, 8, 8, 8, 8), 0, 0, null);
+        c.drawBitmap(Bitmap.createBitmap(skin, 40, 8, 8, 8), 0, 0, null);
+        return Bitmap.createScaledBitmap(f, 128, 128, false);
+    }
+
+    private static Bitmap scaleUp(Bitmap b) {
+        if (b.getWidth() >= 128) return b;
+        int k = Math.max(1, 128 / b.getWidth());
+        return Bitmap.createScaledBitmap(b, b.getWidth() * k, b.getHeight() * k, false);
+    }
+
+    // ------------------------------------------------------------------ actions
+
+    private void act(final Item it, final Button button) {
+        button.setEnabled(false);
+        button.setText("…");
+        status.setText("");
+        pool.execute(new Runnable() {
+            public void run() {
+                String done = null, err = null;
+                try {
+                    if (it.kind != null) done = install(it);
+                    else if (it.cape) done = wearCape(it);
+                    else done = wearSkin(it);
+                } catch (Exception e) {
+                    err = e.getMessage() == null ? e.toString() : e.getMessage();
+                }
+                final String ok = done, bad = err;
+                ui.post(new Runnable() {
+                    public void run() {
+                        button.setEnabled(true);
+                        if (bad != null) {
+                            button.setText(Ui.t("Повторить", "Retry"));
+                            status.setTextColor(Ui.WARN);
+                            status.setText(Ui.t("Не получилось: ", "Failed: ") + bad);
+                        } else {
+                            button.setText(Ui.t("Готово ✓", "Done ✓"));
+                            status.setTextColor(Ui.TEXT);
+                            status.setText(ok);
+                        }
+                    }
+                });
+            }
+        });
+    }
+
+    private String wearSkin(Item it) throws Exception {
+        byte[] png = getBytes(it.picture, 1 << 20);
+        BitmapFactory.Options o = new BitmapFactory.Options();
+        o.inScaled = false;
+        Bitmap b = BitmapFactory.decodeByteArray(png, 0, png.length, o);
+        if (b == null || b.getWidth() != 64 || (b.getHeight() != 64 && b.getHeight() != 32)) {
+            throw new Exception(Ui.t("Нужен скин 64×64 или 64×32.", "A 64×64 or 64×32 skin is needed."));
+        }
+        boolean slim = it.hasSlim ? it.slim : looksSlim(b);
+        // The same files the profile screen writes (horizon-skin.png/.txt), then the share copy.
+        write(new File(dir, "horizon-skin.png"), png);
+        write(new File(dir, "horizon-skin.txt"), ("model:" + (slim ? "slim" : "classic") + "\n").getBytes(StandardCharsets.UTF_8));
+        File sd = new File(dir, "skin");
+        sd.mkdirs();
+        write(new File(sd, "skin.png"), png);
+        write(new File(sd, "model.txt"), (slim ? "slim\n" : "classic\n").getBytes(StandardCharsets.UTF_8));
+        File signed = new File(sd, "textures.signed");
+        signed.delete();
+        try {
+            if (it.signedUrl != null) {
+                JSONObject root = new JSONObject(getString(it.signedUrl));
+                String value = null, signature = null;
+                JSONArray props = root.optJSONArray("properties");
+                for (int i = 0; props != null && i < props.length(); i++) {
+                    JSONObject p = props.getJSONObject(i);
+                    if ("textures".equals(p.optString("name"))) {
+                        value = p.optString("value", null);
+                        signature = p.optString("signature", null);
+                    }
+                }
+                if (value == null) {
+                    JSONObject data = root.getJSONObject("skin").getJSONObject("texture").getJSONObject("data");
+                    value = data.optString("value", null);
+                    signature = data.optString("signature", null);
+                }
+                if (value != null && signature != null && !value.isEmpty() && !signature.isEmpty()) {
+                    write(signed, (value + "\n" + signature + "\n").getBytes(StandardCharsets.UTF_8));
+                }
+            }
+        } catch (Exception ignored) {
+            // worn without the signature: the player sees it, other players may not
+        }
+        return Ui.t("Скин надет: ", "Skin worn: ") + it.title + (signed.isFile() ? "" : Ui.t(" (без подписи Mojang)", " (unsigned)"));
+    }
+
+    private String wearCape(Item it) throws Exception {
+        byte[] png = ProfileActivity.normalizeCape(getBytes(it.picture, 1 << 20));
+        if (png == null) throw new Exception(Ui.t("Это не плащ 64×32.", "That is not a 64×32 cape."));
+        File sd = new File(dir, "skin");
+        sd.mkdirs();
+        write(new File(sd, "cape.png"), png);
+        new File(sd, "textures.signed").delete();
+        return Ui.t("Плащ надет: ", "Cape worn: ") + it.title;
+    }
+
+    private String install(Item it) throws Exception {
+        String url = it.file, name = it.fileName, hash = it.hash, algo = it.hashKind;
+        if ("pack".equals(it.kind)) {
+            JSONArray versions = new JSONArray(getString("https://api.modrinth.com/v2/project/" + enc(it.id)
+                    + "/version?game_versions=" + enc("[\"" + GAME_VERSION + "\"]")));
+            if (versions.length() == 0) throw new Exception(Ui.t("Нет версии для ", "No version for ") + GAME_VERSION);
+            JSONArray files = versions.getJSONObject(0).getJSONArray("files");
+            JSONObject f = files.getJSONObject(0);
+            for (int i = 0; i < files.length(); i++) if (files.getJSONObject(i).optBoolean("primary")) f = files.getJSONObject(i);
+            url = f.getString("url");
+            name = f.getString("filename");
+            hash = f.getJSONObject("hashes").getString("sha1");
+            algo = "SHA-1";
+            if (!url.startsWith("https://cdn.modrinth.com/")) throw new Exception("bad source");
+        }
+        if (url == null || url.isEmpty() || name == null || hash == null) throw new Exception(Ui.t("Нет файла.", "No file."));
+        byte[] data = getBytes(url, 256 << 20);
+        String got = hex(MessageDigest.getInstance(algo).digest(data));
+        if (!got.equalsIgnoreCase(hash)) throw new Exception(Ui.t("Контрольная сумма не совпала.", "Checksum mismatch."));
+        String safe = name.replaceAll("[^A-Za-z0-9._ +()\\[\\]-]", "_");
+        String folder = "shader".equals(it.kind) ? "shaderpacks" : "mod".equals(it.kind) ? "mods" : "resourcepacks";
+        File out = new File(dir, folder);
+        out.mkdirs();
+        write(new File(out, safe), data);
+        return Ui.t("Установлено: ", "Installed: ") + it.title + " → " + folder + "/" + safe;
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    /** Whether a skin's arms are 3 px wide: the right arm's last column is empty. */
+    private static boolean looksSlim(Bitmap b) {
+        if (b.getHeight() < 64) return false;
+        for (int y = 20; y < 32; y++) if (Color.alpha(b.getPixel(55, y)) != 0) return false;
+        return true;
+    }
+
+    private static void write(File f, byte[] data) throws Exception {
+        File tmp = new File(f.getParentFile(), f.getName() + ".tmp");
+        try (FileOutputStream o = new FileOutputStream(tmp)) {
+            o.write(data);
+        }
+        if (f.exists() && !f.delete()) throw new Exception("cannot replace " + f.getName());
+        if (!tmp.renameTo(f)) throw new Exception("cannot write " + f.getName());
+    }
+
+    private static String hex(byte[] b) {
+        StringBuilder s = new StringBuilder();
+        for (byte x : b) s.append(String.format(Locale.ROOT, "%02x", x));
+        return s.toString();
+    }
+
+    private static String enc(String s) throws Exception {
+        return URLEncoder.encode(s, "UTF-8");
+    }
+
+    private static String https(String url) {
+        return url.startsWith("http://textures.minecraft.net/") ? "https://" + url.substring(7) : url;
+    }
+
+    /** The text of an https URL; an empty string for 204/404 (no such player). */
+    private static String getString(String url) throws Exception {
+        return new String(getBytes(url, 8 << 20), StandardCharsets.UTF_8);
+    }
+
+    private static byte[] getBytes(String url, int limit) throws Exception {
+        if (!url.startsWith("https://")) throw new Exception("https only");
+        HttpURLConnection c = (HttpURLConnection) new URL(url).openConnection();
+        c.setConnectTimeout(15000);
+        c.setReadTimeout(30000);
+        c.setRequestProperty("User-Agent", "OneShot-Android/1.0");
+        c.setRequestProperty("Accept", "application/json, image/*, */*");
+        int code = c.getResponseCode();
+        if (code == 204 || code == 404) return new byte[0];
+        if (code / 100 != 2) throw new Exception("HTTP " + code);
+        try (InputStream in = c.getInputStream()) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buf = new byte[16384];
+            int n;
+            while ((n = in.read(buf)) > 0) {
+                out.write(buf, 0, n);
+                if (out.size() > limit) throw new Exception("too big");
+            }
+            return out.toByteArray();
+        } finally {
+            c.disconnect();
+        }
+    }
+}
