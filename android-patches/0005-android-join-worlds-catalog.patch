+        TextView title = Ui.text(this, Ui.t("Каталог", "Catalog"), 22, Ui.TEXT, true);
+        LinearLayout.LayoutParams tl = new LinearLayout.LayoutParams(0, -2, 1);
+        tl.leftMargin = p;
+        head.addView(title, tl);
+        root.addView(head);
+
+        HorizontalScrollView tabScroll = new HorizontalScrollView(this);
+        tabScroll.setHorizontalScrollBarEnabled(false);
+        LinearLayout tabRow = new LinearLayout(this);
+        tabRow.setOrientation(LinearLayout.HORIZONTAL);
+        String[] names = {Ui.t("Скины", "Skins"), Ui.t("Плащи", "Capes"),
+            Ui.t("Ресурспаки", "Resource packs"), Ui.t("Моды Horizon", "Horizon mods")};
+        for (int i = 0; i < 4; i++) {
+            final int which = i;
+            tabs[i] = Ui.button(this, names[i], false);
+            tabs[i].setOnClickListener(new View.OnClickListener() {
+                public void onClick(View v) {
+                    selectTab(which);
