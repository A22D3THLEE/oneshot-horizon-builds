+/**
+ * The OneShot launcher's catalogs on the phone (Catalog.cs): skins and capes from MineSkin and
+ * Mojang, resource packs from Modrinth and Horizon's own registry of mods and packs. A skin or a
+ * cape is worn at once (the same files the profile screen writes); a pack or a mod is downloaded,
+ * its checksum checked, and put in the game folder.
+ */
+public class CatalogActivity extends Activity {
+    private static final String GAME_VERSION = "26.3";
+    private static final String REGISTRY = "https://horizon-rust.github.io/horizon-mods/index.json";
+    private static final int PAGE = 24;
+    private static final int SKINS = 0, CAPES = 1, PACKS = 2, MODS = 3;
+
+    private final ExecutorService pool = Executors.newFixedThreadPool(4);
+    private final Handler ui = new Handler(Looper.getMainLooper());
+    private final Map<String, Bitmap> pictures = new HashMap<String, Bitmap>();
+    private File dir;
+    private int tab = SKINS;
+    private int generation;          // a search started later makes older answers stale
+    private String next;             // paging token of the current list; null at the end
+    private EditText query;
+    private LinearLayout list;
+    private TextView status;
+    private Button[] tabs = new Button[4];
+    private Button more;
+
+    /** One result. */
+    private static final class Item {
+        String id, title, sub, picture, file, fileName, hash, hashKind, signedUrl, kind;
+        boolean cape, slim, hasSlim;
+        long downloads;
+    }
+
