@@ -0,0 +1,57 @@
+//! A player asks for an Android build with native mods: the relay keeps the
+//! set (sorted, each id once) for the builds workflow, and refuses malformed ones.
+use horizon_friends::wire::{self, ErrorCode, FromRelay, ToRelay};
+use horizon_relay::{Config, Relay};
+use std::{
+    io::{Read, Write},
+    net::{SocketAddr, TcpStream},
+    time::Duration,
+};
+
+fn ask(relay: SocketAddr, mods: &[&str]) -> Result<Vec<String>, ErrorCode> {
+    let mut s = TcpStream::connect(relay).unwrap();
+    s.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+    let mods = mods.iter().map(|m| (*m).to_owned()).collect();
+    wire::send(&mut s, &ToRelay::Build { v: wire::VERSION, mods }).unwrap();
+    match wire::recv::<_, FromRelay>(&mut s).unwrap() {
+        FromRelay::Queued { mods } => Ok(mods),
+        FromRelay::Error { code, .. } => Err(code),
+        other => panic!("unexpected answer {other:?}"),
+    }
+}
+
+fn http_builds(relay: SocketAddr) -> String {
+    let mut s = TcpStream::connect(relay).unwrap();
+    s.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+    s.write_all(b"GET /builds HTTP/1.1\r\nHost: relay\r\n\r\n").unwrap();
+    let mut answer = String::new();
+    s.read_to_string(&mut answer).unwrap();
+    answer
+}
+
+#[test]
+fn sets_are_kept_sorted_once_and_malformed_ones_refused() {
+    let (relay, address, _) = Relay::spawn_local(Config::default()).unwrap();
+    assert_eq!(
+        ask(address, &["orbital", "appleskin", "orbital"]).unwrap(),
+        vec!["appleskin".to_owned(), "orbital".to_owned()]
+    );
+    // The same set again is one set, asked for later.
+    ask(address, &["appleskin", "orbital"]).unwrap();
+    ask(address, &["minimap"]).unwrap();
+    assert_eq!(
+        relay.builds(),
+        vec![vec!["minimap".to_owned()], vec!["appleskin".to_owned(), "orbital".to_owned()]]
+    );
+    // Malformed: empty, too many, or an id that isn't one.
+    assert_eq!(ask(address, &[]).err(), Some(ErrorCode::BadRequest));
+    let many: Vec<String> = (0..=wire::MAX_BUILD_MODS).map(|i| format!("m{i}")).collect();
+    let many: Vec<&str> = many.iter().map(String::as_str).collect();
+    assert_eq!(ask(address, &many).err(), Some(ErrorCode::BadRequest));
+    assert_eq!(ask(address, &["Orbital Laser"]).err(), Some(ErrorCode::BadRequest));
+    assert_eq!(relay.builds().len(), 2);
+    // The workflow reads them over HTTP.
+    let answer = http_builds(address);
+    assert!(answer.starts_with("HTTP/1.1 200 OK"), "{answer}");
+    assert!(answer.ends_with(r#"{"builds":[["minimap"],["appleskin","orbital"]]}"#), "{answer}");
+}
