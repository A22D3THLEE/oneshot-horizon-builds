+/// A player asks for a build with these native mods: the set is kept (sorted,
+/// each id once) for the builds workflow, which reads `GET /builds`. It spends
+/// the address's budget for `online` queries, never joins.
+fn build(state: &State, mut stream: TcpStream, peer: SocketAddr, mut mods: Vec<String>) -> io::Result<()> {
+    mods.sort();
+    mods.dedup();
+    if mods.is_empty() || mods.len() > wire::MAX_BUILD_MODS || !mods.iter().all(|m| wire::valid_mod_id(m)) {
+        return refuse(&mut stream, ErrorCode::BadRequest);
+    }
+    let now = Instant::now();
+    if !locked(&state.limiter).allow_online(peer.ip(), now) {
+        state.rate_limited.fetch_add(1, Ordering::Relaxed);
+        return refuse(&mut stream, ErrorCode::RateLimited);
+    }
+    {
+        let mut inner = locked(&state.inner);
+        inner.builds.retain(|_, at| now.duration_since(*at) < BUILD_KEPT);
+        if !inner.builds.contains_key(&mods) && inner.builds.len() >= MAX_BUILDS {
+            if let Some(oldest) = inner.builds.iter().min_by_key(|(_, at)| **at).map(|(k, _)| k.clone()) {
+                inner.builds.remove(&oldest);
+            }
+        }
+        inner.builds.insert(mods.clone(), now);
+    }
+    wire::send(&mut stream, &FromRelay::Queued { mods })
+}
+
+/// The sets of native mods asked for within the last day, the newest first.
+fn builds(state: &State) -> Vec<Vec<String>> {
+    let now = Instant::now();
+    let inner = locked(&state.inner);
+    let mut sets: Vec<(&Vec<String>, &Instant)> = inner
+        .builds
+        .iter()
+        .filter(|(_, at)| now.duration_since(**at) < BUILD_KEPT)
+        .collect();
+    sets.sort_by(|a, b| b.1.cmp(a.1));
+    sets.into_iter().map(|(m, _)| m.clone()).collect()
+}
