+/// A launcher asks which of its friends share right now. A friend who isn't
+/// is the usual answer, not a guess at a code: it counts against the
+/// address's own budget for these queries, never against joins.
+fn online(
+    state: &State,
+    mut stream: TcpStream,
+    peer: SocketAddr,
+    ids: &[String],
+) -> io::Result<()> {
+    if ids.len() > wire::MAX_ONLINE_IDS || !ids.iter().all(|i| wire::valid_presence_id(i)) {
+        return refuse(&mut stream, ErrorCode::BadRequest);
+    }
+    if !locked(&state.limiter).allow_online(peer.ip(), Instant::now()) {
+        state.rate_limited.fetch_add(1, Ordering::Relaxed);
+        return refuse(&mut stream, ErrorCode::RateLimited);
+    }
+    let mut friends: Vec<Presence> = {
+        let inner = locked(&state.inner);
+        inner
+            .hosts
+            .values()
+            .filter_map(|h| h.presence.as_ref())
+            .filter(|p| ids.contains(&p.id))
+            .cloned()
+            .collect()
+    };
+    friends.truncate(wire::MAX_ONLINE_IDS);
+    wire::send(&mut stream, &FromRelay::Online { friends })
+}
