diff --git a/crates/horizon-relay/tests/online.rs b/crates/horizon-relay/tests/online.rs
new file mode 100644
index 0000000..5198ab7
--- /dev/null
+++ b/crates/horizon-relay/tests/online.rs
@@ -0,0 +1,84 @@
+//! A launcher asks which friends share right now: hosts with a kept code
+//! and a presence answer, the others don't, and asking spends no joins.
+use horizon_friends::wire::{self, ErrorCode, FromRelay, Presence, ToRelay};
+use horizon_relay::{Config, Relay};
+use std::{
+    net::{SocketAddr, TcpStream},
+    time::{Duration, Instant},
+};
+
+fn claim(relay: SocketAddr, nameplate: &str, presence: Option<Presence>) -> TcpStream {
+    let mut s = TcpStream::connect(relay).unwrap();
+    s.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+    let hello = ToRelay::Claim {
+        v: wire::VERSION,
+        protocol: 777,
+        game: "26.3".into(),
+        nameplate: nameplate.into(),
+        claim: "ab".repeat(32),
+        presence,
+    };
+    wire::send(&mut s, &hello).unwrap();
+    match wire::recv::<_, FromRelay>(&mut s).unwrap() {
+        FromRelay::Registered { .. } => s,
+        other => panic!("unexpected answer {other:?}"),
+    }
+}
+
+fn ask(relay: SocketAddr, ids: Vec<String>) -> Result<Vec<Presence>, ErrorCode> {
+    let mut s = TcpStream::connect(relay).unwrap();
+    s.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+    wire::send(&mut s, &ToRelay::Online { v: wire::VERSION, ids }).unwrap();
+    match wire::recv::<_, FromRelay>(&mut s).unwrap() {
+        FromRelay::Online { friends } => Ok(friends),
+        FromRelay::Error { code, .. } => Err(code),
+        other => panic!("unexpected answer {other:?}"),
+    }
+}
+
+#[test]
+fn friends_sharing_answer_and_the_rest_dont() {
+    let (relay, address, _) = Relay::spawn_local(Config::default()).unwrap();
+    let mine = Presence {
+        id: "1a".repeat(16),
+        blob: "c0ffee".repeat(8),
+    };
+    let control = claim(address, "K7QM", Some(mine.clone()));
+    // A host without a presence, and one whose presence is malformed.
+    let _plain = claim(address, "M2PX", None);
+    let _bad = claim(
+        address,
+        "Q9TR",
+        Some(Presence {
+            id: "2b".repeat(16),
+            blob: "XYZ".into(),
+        }),
+    );
+    let absent = "3c".repeat(16);
+    let friends = ask(address, vec![mine.id.clone(), absent.clone(), "2b".repeat(16)]).unwrap();
+    assert_eq!(friends, vec![mine.clone()]);
+    // Asking about absent friends many times blocks neither asking nor joins.
+    for _ in 0..8 {
+        assert_eq!(ask(address, vec![absent.clone()]).unwrap(), vec![]);
+    }
+    // Malformed queries.
+    assert_eq!(ask(address, vec!["nope".into()]).err(), Some(ErrorCode::BadRequest));
+    assert_eq!(
+        ask(address, vec![absent.clone(); wire::MAX_ONLINE_IDS + 1]).err(),
+        Some(ErrorCode::BadRequest)
+    );
+    // The host stops sharing: it isn't online any more.
+    drop(control);
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        match ask(address, vec![mine.id.clone()]) {
+            Ok(friends) if friends.is_empty() => break,
+            // Still there, or this test spent its queries for now.
+            Ok(_) | Err(ErrorCode::RateLimited) => {}
+            Err(e) => panic!("refused: {e:?}"),
+        }
+        assert!(Instant::now() < deadline, "the host never went offline");
+        std::thread::sleep(Duration::from_millis(500));
+    }
+    relay.stop();
+}
