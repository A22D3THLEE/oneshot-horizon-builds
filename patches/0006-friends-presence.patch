+        assert!(!Presence { id: "0F".repeat(16), ..p.clone() }.valid());
+        assert!(!Presence { blob: "a".repeat(MAX_PRESENCE_BLOB + 2), ..p.clone() }.valid());
+        assert!(!Presence { blob: "abc".into(), ..p.clone() }.valid());
+        let mut buf = Vec::new();
+        let ask = ToRelay::Online {
+            v: VERSION,
+            ids: vec![p.id.clone(); MAX_ONLINE_IDS],
+        };
+        send(&mut buf, &ask).unwrap();
+        // The fullest answer still fits in a line.
+        let answer = FromRelay::Online {
+            friends: vec![p; MAX_ONLINE_IDS],
+        };
+        send(&mut buf, &answer).unwrap();
+        assert!(buf.len() < 2 * MAX_LINE);
+        let mut r = &buf[..];
+        assert_eq!(recv::<_, ToRelay>(&mut r).unwrap(), ask);
+        assert_eq!(recv::<_, FromRelay>(&mut r).unwrap(), answer);
+    }
