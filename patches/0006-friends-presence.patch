index 00000000..002ffd88
--- /dev/null
+++ b/crates/horizon-friends/src/presence.rs
@@ -0,0 +1,154 @@
+//! Oneshot: what a sharing host tells its friends through the relay's `online`
+//! query, keyed by its lasting code so that only those who know the code can
+//! ask for it or read it (wire::Presence). The relay keeps both strings opaque.
+//!
+//! Only HMAC-SHA256 is used, so the launchers (C#, Java) do the same in a few
+//! lines. With PRF(k, m) = HMAC-SHA256(k, m || 0x01) (HKDF-Expand's first
+//! block):
+//! - code: the nameplate and the secret, 8 characters, uppercase ASCII;
+//! - prk = HMAC-SHA256("oneshot-presence-v1", code) (HKDF-Extract);
+//! - id = hex(PRF(prk, "id")[..16]);
+//! - key = PRF(prk, "seal");
+//! - name: the world's name in UTF-8, at most 32 bytes (cut at a character);
+//! - nonce: 8 random bytes; ct = name XOR PRF(key, "ks" || nonce)[..len];
+//! - tag = PRF(key, "tag" || nonce || ct)[..8];
+//! - blob = hex(nonce || tag || ct).
+//!
+//! The secret has 20 bits, so whoever runs the relay could find a code by
+//! trying them all: the relay is the player's own, and a world's name is all
+//! it would learn.
+use crate::wire::Presence;
+use hkdf::Hkdf;
+use sha2::Sha256;
+
+const SALT: &[u8] = b"oneshot-presence-v1";
+/// The longest world name sent, in bytes.
+pub const MAX_NAME: usize = 32;
+
+fn prf(key: &[u8], message: &[u8]) -> [u8; 32] {
+    let mut out = [0u8; 32];
+    Hkdf::<Sha256>::from_prk(key)
+        .expect("a 32-byte key")
+        .expand(message, &mut out)
+        .expect("one block");
+    out
+}
+
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+fn unhex(text: &str) -> Option<Vec<u8>> {
+    if text.len() % 2 != 0 {
+        return None;
+    }
+    (0..text.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(text.get(i..i + 2)?, 16).ok())
+        .collect()
+}
+
+/// The keys of a code: (id, sealing key).
+fn keys(nameplate: &str, secret: &str) -> (String, [u8; 32]) {
+    let code = format!("{nameplate}{secret}").to_ascii_uppercase();
+    let (prk, _) = Hkdf::<Sha256>::extract(Some(SALT), code.as_bytes());
+    (hex(&prf(&prk, b"id")[..16]), prf(&prk, b"seal"))
+}
+
+/// The world's name cut to [`MAX_NAME`] bytes at a character boundary.
+fn cut(name: &str) -> &str {
+    let mut end = name.len().min(MAX_NAME);
+    while !name.is_char_boundary(end) {
+        end -= 1;
+    }
+    &name[..end]
+}
+
+fn stream(key: &[u8; 32], nonce: &[u8], data: &mut [u8]) {
+    let ks = prf(key, &[b"ks".as_slice(), nonce].concat());
+    for (d, k) in data.iter_mut().zip(ks) {
+        *d ^= k;
+    }
+}
+
+fn tag(key: &[u8; 32], nonce: &[u8], ct: &[u8]) -> [u8; 8] {
+    let t = prf(key, &[b"tag".as_slice(), nonce, ct].concat());
+    t[..8].try_into().unwrap()
+}
+
+/// The id friends ask the relay about.
+pub fn id(nameplate: &str, secret: &str) -> String {
+    keys(nameplate, secret).0
+}
+
+/// The presence of a host sharing `world` under this code, with this nonce.
+pub fn seal_with(nameplate: &str, secret: &str, world: &str, nonce: [u8; 8]) -> Presence {
+    let (id, key) = keys(nameplate, secret);
+    let mut ct = cut(world).as_bytes().to_vec();
+    stream(&key, &nonce, &mut ct);
+    let tag = tag(&key, &nonce, &ct);
+    Presence {
+        id,
+        blob: hex(&[&nonce[..], &tag[..], &ct[..]].concat()),
+    }
+}
+
+/// The same with a fresh nonce; None if the OS has no random numbers.
+pub fn seal(nameplate: &str, secret: &str, world: &str) -> Option<Presence> {
+    let mut nonce = [0u8; 8];
+    getrandom::fill(&mut nonce).ok()?;
+    Some(seal_with(nameplate, secret, world, nonce))
+}
+
+/// The world's name in a friend's presence; None if it isn't theirs or was
+/// altered.
+pub fn open(nameplate: &str, secret: &str, blob: &str) -> Option<String> {
+    let (_, key) = keys(nameplate, secret);
+    let b = unhex(blob)?;
+    if b.len() < 16 || b.len() > 16 + MAX_NAME {
+        return None;
+    }
+    let (nonce, rest) = b.split_at(8);
+    let (t, ct) = rest.split_at(8);
+    if tag(&key, nonce, ct) != *t {
+        return None;
+    }
+    let mut name = ct.to_vec();
+    stream(&key, nonce, &mut name);
+    String::from_utf8(name).ok()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn seals_and_opens() {
+        let p = seal_with("K7QM", "X2PA", "Новый мир", [1, 2, 3, 4, 5, 6, 7, 8]);
+        assert!(p.valid());
+        assert_eq!(p.id, id("k7qm", "x2pa"));
+        assert_eq!(open("K7QM", "X2PA", &p.blob).as_deref(), Some("Новый мир"));
+        // Another code reads nothing; an altered blob neither.
+        assert_eq!(open("K7QM", "X2PB", &p.blob), None);
+        let mut bad = p.blob.clone().into_bytes();
+        let last = bad.len() - 1;
+        bad[last] = if bad[last] == b'0' { b'1' } else { b'0' };
+        assert_eq!(open("K7QM", "X2PA", &String::from_utf8(bad).unwrap()), None);
+        // A long name is cut at a character.
+        let long = "ж".repeat(40);
+        let p = seal("K7QM", "X2PA", &long).unwrap();
+        assert!(p.valid());
+        assert_eq!(open("K7QM", "X2PA", &p.blob).unwrap(), "ж".repeat(16));
+    }
+
+    /// The vector the launchers check themselves against (FriendsPresence).
+    #[test]
+    fn launcher_vector() {
+        let p = seal_with("K7QM", "X2PA", "World", [0, 1, 2, 3, 4, 5, 6, 7]);
+        println!("id {} blob {}", p.id, p.blob);
+        assert_eq!(p.id, VECTOR_ID);
+        assert_eq!(p.blob, VECTOR_BLOB);
+    }
+    const VECTOR_ID: &str = "3f9a99ded828d80b83492609f4d66733";
+    const VECTOR_BLOB: &str = "00010203040506072d40854bcb3c215b22efe8a6dc";
+}
