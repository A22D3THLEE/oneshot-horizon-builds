diff --git a/crates/horizon-friends/src/identity.rs b/crates/horizon-friends/src/identity.rs
new file mode 100644
index 0000000..f33681b
--- /dev/null
+++ b/crates/horizon-friends/src/identity.rs
@@ -0,0 +1,249 @@
+//! A short code that stays the same from one sharing session to the next
+//! (`HORIZON_FRIENDS_IDENTITY`, a file the launcher shows and can reissue).
+//! The file holds the nameplate and secret of the code, the claim that proves
+//! to the relay the nameplate is this player's, and the wrong guesses made on
+//! the secret so far, so the guess limit holds across sessions too:
+//!
+//! ```text
+//! nameplate=K7QM
+//! secret=3XPD
+//! claim=<64 hex digits>
+//! wrong=0
+//! ```
+use crate::code::{self, Code};
+use std::{
+    io,
+    path::{Path, PathBuf},
+};
+
+/// Bytes of the claim (written as hex).
+const CLAIM: usize = 32;
+
+#[derive(Clone, PartialEq, Eq)]
+pub struct Identity {
+    pub code: Code,
+    pub claim: String,
+    /// Wrong secrets tried through the relay since the secret was made.
+    pub wrong: u32,
+}
+impl std::fmt::Debug for Identity {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "Identity({:?}, wrong {})", self.code, self.wrong)
+    }
+}
+
+/// The identity file the launcher set, if any.
+pub fn path() -> Option<PathBuf> {
+    std::env::var_os("HORIZON_FRIENDS_IDENTITY")
+        .filter(|p| !p.is_empty())
+        .map(PathBuf::from)
+}
+
+fn random_bits() -> io::Result<u32> {
+    let mut b = [0u8; 4];
+    crate::fill_random(&mut b)?;
+    Ok(u32::from_le_bytes(b))
+}
+
+/// A claim as the relay accepts it: hex, 32 to 128 digits.
+pub fn valid_claim(claim: &str) -> bool {
+    (32..=128).contains(&claim.len()) && claim.bytes().all(|b| b.is_ascii_hexdigit())
+}
+
+impl Identity {
+    /// A fresh code and claim from the OS random generator.
+    pub fn generate() -> io::Result<Self> {
+        let nameplate = code::nameplate(random_bits()?);
+        Ok(Self {
+            code: Code::new(&nameplate)?,
+            claim: new_claim()?,
+            wrong: 0,
+        })
+    }
+
+    /// The file's identity; None when it is missing or not one.
+    pub fn read(path: &Path) -> Option<Self> {
+        let text = std::fs::read_to_string(path).ok()?;
+        let (mut nameplate, mut secret, mut claim, mut wrong) = (None, None, None, 0);
+        for line in text.lines() {
+            let Some((key, value)) = line.split_once('=') else {
+                continue;
+            };
+            let value = value.trim();
+            match key.trim() {
+                "nameplate" => nameplate = Some(value.to_owned()),
+                "secret" => secret = Some(value.to_owned()),
+                "claim" => claim = Some(value.to_ascii_lowercase()),
+                "wrong" => wrong = value.parse().unwrap_or(0),
+                _ => {}
+            }
+        }
+        // Each half on its own: a broken half must not borrow symbols from the other.
+        let code = Code {
+            nameplate: code::parse_nameplate(&nameplate?)?,
+            secret: code::parse_nameplate(&secret?)?,
+        };
+        let claim = claim.filter(|c| valid_claim(c))?;
+        Some(Self { code, claim, wrong })
+    }
+
+    /// The file's identity, made and saved when it is missing or broken.
+    pub fn load_or_create(path: &Path) -> io::Result<Self> {
+        if let Some(id) = Self::read(path) {
+            return Ok(id);
+        }
+        let id = Self::generate()?;
+        id.save(path)?;
+        Ok(id)
+    }
+
+    /// Write the file whole: a temporary file renamed over it.
+    pub fn save(&self, path: &Path) -> io::Result<()> {
+        let text = format!(
+            "nameplate={}\nsecret={}\nclaim={}\nwrong={}\n",
+            self.code.nameplate, self.code.secret, self.claim, self.wrong
+        );
+        if let Some(dir) = path.parent()
+            && !dir.as_os_str().is_empty()
+        {
+            std::fs::create_dir_all(dir)?;
+        }
+        let mut tmp = path.as_os_str().to_owned();
+        tmp.push(".tmp");
+        let tmp = PathBuf::from(tmp);
+        std::fs::write(&tmp, text)?;
+        std::fs::rename(&tmp, path)
+    }
+
+    /// Another nameplate (and claim) when the relay gave this one to
+    /// someone else; the secret stays.
+    pub fn renamed(&self) -> io::Result<Self> {
+        let mut nameplate = code::nameplate(random_bits()?);
+        while nameplate == self.code.nameplate {
+            nameplate = code::nameplate(random_bits()?);
+        }
+        Ok(Self {
+            code: Code {
+                nameplate,
+                secret: self.code.secret.clone(),
+            },
+            claim: new_claim()?,
+            wrong: self.wrong,
+        })
+    }
+
+    /// A fresh secret on the same nameplate, the count back at zero: too
+    /// many wrong guesses were made on the old one.
+    pub fn resecreted(&self) -> io::Result<Self> {
+        let fresh = Code::new(&self.code.nameplate)?;
+        Ok(Self {
+            code: fresh,
+            claim: self.claim.clone(),
+            wrong: 0,
+        })
+    }
+
+    /// Store `wrong` in the file, unless the launcher reissued the code
+    /// there meanwhile (that one starts with its own count).
+    pub fn store_wrong(&self, path: &Path, wrong: u32) -> io::Result<()> {
+        match Self::read(path) {
+            Some(mut now) if now.code == self.code => {
+                if now.wrong >= wrong {
+                    return Ok(());
+                }
+                now.wrong = wrong;
+                now.save(path)
+            }
+            _ => Ok(()),
+        }
+    }
+
+    /// Save `next` in place of this identity, unless the launcher reissued
+    /// the code meanwhile: then the launcher's stays.
+    pub fn replace(&self, path: &Path, next: &Self) -> io::Result<()> {
+        match Self::read(path) {
+            Some(now) if now.code != self.code => Ok(()),
+            _ => next.save(path),
+        }
+    }
+}
+
+fn new_claim() -> io::Result<String> {
+    let mut b = [0u8; CLAIM];
+    crate::fill_random(&mut b)?;
+    Ok(b.iter().map(|x| format!("{x:02x}")).collect())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn temp(name: &str) -> PathBuf {
+        let dir = std::env::temp_dir().join(format!(
+            "horizon-identity-{}-{name}",
+            std::process::id()
+        ));
+        let _ = std::fs::remove_dir_all(&dir);
+        dir.join("friends-identity.txt")
+    }
+
+    #[test]
+    fn made_once_then_kept() {
+        let path = temp("kept");
+        assert!(Identity::read(&path).is_none());
+        let a = Identity::load_or_create(&path).unwrap();
+        assert!(valid_claim(&a.claim));
+        assert_eq!(a.claim.len(), 2 * CLAIM);
+        let b = Identity::load_or_create(&path).unwrap();
+        assert_eq!(a, b);
+        assert_eq!(Code::parse(&a.code.to_string()).unwrap(), a.code);
+    }
+
+    #[test]
+    fn reads_what_launchers_write() {
+        let path = temp("launcher");
+        std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+        let claim = "AB".repeat(32);
+        std::fs::write(
+            &path,
+            format!("nameplate=k7qm\r\nsecret=3xpd\r\nclaim={claim}\r\nwrong=7\r\n"),
+        )
+        .unwrap();
+        let id = Identity::read(&path).unwrap();
+        assert_eq!(id.code.to_string(), "K7QM-3XPD");
+        assert_eq!(id.claim, claim.to_ascii_lowercase());
+        assert_eq!(id.wrong, 7);
+        std::fs::write(&path, "nameplate=K7QM\nsecret=3XPD\nclaim=zz\n").unwrap();
+        assert!(Identity::read(&path).is_none(), "a claim that isn't hex");
+        std::fs::write(&path, "nameplate=K7Q\nsecret=3XPD\n").unwrap();
+        assert!(Identity::read(&path).is_none());
+    }
+
+    #[test]
+    fn a_reissue_in_the_launcher_wins() {
+        let path = temp("reissue");
+        let old = Identity::load_or_create(&path).unwrap();
+        old.store_wrong(&path, 3).unwrap();
+        assert_eq!(Identity::read(&path).unwrap().wrong, 3);
+        let reissued = Identity::generate().unwrap();
+        reissued.save(&path).unwrap();
+        old.store_wrong(&path, 4).unwrap();
+        old.replace(&path, &old.resecreted().unwrap()).unwrap();
+        assert_eq!(Identity::read(&path).unwrap(), reissued);
+    }
+
+    #[test]
+    fn renamed_and_resecreted() {
+        let id = Identity::generate().unwrap();
+        let r = id.renamed().unwrap();
+        assert_ne!(r.code.nameplate, id.code.nameplate);
+        assert_eq!(r.code.secret, id.code.secret);
+        assert_ne!(r.claim, id.claim);
+        let mut tried = id.clone();
+        tried.wrong = 50;
+        let s = tried.resecreted().unwrap();
+        assert_eq!(s.code.nameplate, id.code.nameplate);
+        assert_eq!(s.claim, id.claim);
+        assert_eq!(s.wrong, 0);
+    }
+}
