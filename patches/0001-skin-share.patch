+//! Skins in offline-mode multiplayer (Oneshot Launcher).
+//!
+//! An online-mode server gets each player's `textures` property, signed by Mojang, from the session service and
+//! sends it to every client, which shows the skin only when the signature checks out (`skins::lookup`). An
+//! offline-mode server (a LAN or friends world opened under an offline name) has no such property, so everyone
+//! sees everyone else with the default skin.
+//!
+//! Here an offline-mode server asks each joining client on the login plugin channel [`CHANNEL`] for a `textures`
+//! property it already has, signed by Mojang: a launcher gets one for a skin from Mojang's session service (a
+//! player's own skin) or from MineSkin, which signs skins through Mojang accounts. The server puts the property
+//! in the player's profile as an online-mode server would, and every client, an unchanged one too, checks
+//! Mojang's signature as usual: an unsigned or forged property shows the default skin, as before.
+//!
+//! A client without this answers the query with no payload (as vanilla answers any unknown channel), and joins
+//! as before. The launcher names the property's file in `HORIZON_SIGNED_TEXTURES`: the value on the first line,
+//! the signature on the second, both base64 as Mojang gives them.
+use horizon_protocol::packets::login;
+
+/// The login plugin channel the server asks on.
+pub const CHANNEL: &str = "oneshot:skin";
+
+/// The longest value and signature taken: Mojang's are about 400 and 684 characters.
+const MAX_VALUE: usize = 8192;
+const MAX_SIGNATURE: usize = 1024;
+
+/// The client's answer: the signed property from the launcher, or `None` when it gave none (or it can't be read).
+pub fn answer() -> Option<Vec<u8>> {
+    let path = std::env::var_os("HORIZON_SIGNED_TEXTURES").filter(|p| !p.is_empty())?;
+    let text = std::fs::read_to_string(&path)
+        .inspect_err(|e| eprintln!("Horizon: no signed skin ({}): {e}", std::path::Path::new(&path).display()))
+        .ok()?;
+    let (value, signature) = split(&text)?;
+    Some(format!("{value}\n{signature}").into_bytes())
+}
+
+/// The server's reading of an answer: the `textures` property, when it is well formed. Whether Mojang signed it
+/// is each client's check, as for any server's property.
+pub fn property(payload: &[u8]) -> Option<login::Property> {
+    let text = std::str::from_utf8(payload).ok()?;
+    let (value, signature) = split(text)?;
+    Some(login::Property {
+        name: "textures".into(),
+        value: value.to_owned(),
+        signature: Some(signature.to_owned()),
+    })
+}
+
+fn split(text: &str) -> Option<(&str, &str)> {
+    let mut lines = text.lines().map(str::trim).filter(|l| !l.is_empty());
+    let (value, signature) = (lines.next()?, lines.next()?);
+    let base64 = |s: &str| s.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'+' || b == b'/' || b == b'=');
+    (value.len() <= MAX_VALUE && signature.len() <= MAX_SIGNATURE && base64(value) && base64(signature))
+        .then_some((value, signature))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn reads_value_and_signature() {
+        let p = property(b"ZXlKMA==\r\nc2ln\n").unwrap();
+        assert_eq!(p.name, "textures");
+        assert_eq!(p.value, "ZXlKMA==");
+        assert_eq!(p.signature.as_deref(), Some("c2ln"));
+    }
+
+    #[test]
+    fn refuses_what_is_not_a_property() {
+        assert!(property(b"only one line").is_none());
+        assert!(property(b"a b\nc").is_none());
+        assert!(property(&[0xff, 0xfe]).is_none());
+        assert!(property(format!("{}\nc2ln", "A".repeat(MAX_VALUE + 1)).as_bytes()).is_none());
+    }
+}
