+/// Asks an offline-mode client for its signed `textures` property (login plugin channel `oneshot:skin`). A client
+/// without one, or one that doesn't know the channel, answers with nothing: the profile then has no properties,
+/// as before.
+fn ask_skin(c: &mut Connection) -> Result<Vec<login::Property>, String> {
+    const TRANSACTION: i32 = 2;
+    let e = |e: horizon_protocol::Error| e.to_string();
+    c.send(
+        &login::Clientbound::CustomQuery(login::CustomQuery {
+            transaction: TRANSACTION,
+            channel: horizon_client::skin_share::CHANNEL.into(),
+            data: Vec::new(),
+        })
+        .encode(),
+    )
+    .map_err(e)?;
+    let (id, payload) = c.recv().map_err(e)?;
+    match login::Serverbound::decode(id, &payload).map_err(e)? {
+        login::Serverbound::CustomQueryAnswer(answer) if answer.transaction == TRANSACTION => Ok(answer
+            .payload
+            .as_deref()
+            .map(horizon_client::skin_share::properties)
+            .unwrap_or_default()),
+        _ => Err("unexpected packet during login".into()),
+    }
+}
