+/// Oneshot Launcher: the invite code, for the launcher to offer as a link, in the file it names in
+/// `HORIZON_ONESHOT_INVITE` (written when a code is ready or changes, removed when sharing ends). Nothing without
+/// the variable.
+fn oneshot_invite(code: Option<&str>) {
+    let Some(path) = std::env::var_os("HORIZON_ONESHOT_INVITE").filter(|p| !p.is_empty()) else {
+        return;
+    };
+    let result = match code {
+        Some(code) => {
+            let temp = std::path::PathBuf::from(&path).with_extension("tmp");
+            std::fs::write(&temp, code).and_then(|()| std::fs::rename(&temp, &path))
+        }
+        None => match std::fs::remove_file(&path) {
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(()),
+            other => other,
+        },
+    };
+    if let Err(e) = result {
+        log::warn!("Horizon: the invite code for the launcher: {e}");
+    }
+}
